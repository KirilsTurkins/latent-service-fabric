{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-service-fabric.dev/schemas/route-snapshot.schema.json",
  "title": "Immutable Local Route Snapshot",
  "description": "A complete tenant-safe standalone routing generation. Readers replace this document as one unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation",
    "generatedAtUnixMillis",
    "snapshotDigest",
    "services",
    "bindings",
    "policyDigests"
  ],
  "properties": {
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "generatedAtUnixMillis": {
      "type": "integer",
      "minimum": 0
    },
    "snapshotDigest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/serviceRoute" }
    },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/bindingRoute" }
    },
    "policyDigests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "serviceRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenant", "service", "route", "revisions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tenant": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 },
        "route": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/revisionRoute" }
        }
      }
    },
    "revisionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "release", "weight", "contracts", "attributes"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "weight": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/routeContract" }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "routeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "functions"],
      "properties": {
        "contract": { "type": "string", "minLength": 1 },
        "functions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bindingRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "consumerTenant",
        "consumerService",
        "importedContract",
        "providerTenant",
        "providerService",
        "providerContract",
        "mode",
        "policyDigest"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "consumerTenant": { "type": "string", "minLength": 1 },
        "consumerService": { "type": "string", "minLength": 1 },
        "importedContract": { "type": "string", "minLength": 1 },
        "providerTenant": { "type": "string", "minLength": 1 },
        "providerService": { "type": "string", "minLength": 1 },
        "providerContract": { "type": "string", "minLength": 1 },
        "mode": {
          "enum": ["host", "inline", "isolated-local", "remote", "auto"]
        },
        "policyDigest": { "type": "string", "minLength": 1 }
      }
    }
  }
}
