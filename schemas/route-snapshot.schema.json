{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1alpha1/route-snapshot.schema.json",
  "title": "LSF Compiled Route Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation",
    "generatedAtUnixMillis",
    "services",
    "bindings",
    "policyDigests",
    "snapshotDigest"
  ],
  "properties": {
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "generatedAtUnixMillis": {
      "type": "integer",
      "minimum": 0
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "routeId",
          "tenant",
          "service",
          "revisions"
        ],
        "properties": {
          "routeId": {
            "type": "string",
            "minLength": 1
          },
          "tenant": {
            "type": "string",
            "minLength": 1
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "revisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "revisionId",
                "releaseDigest",
                "weight",
                "attributes"
              ],
              "properties": {
                "revisionId": {
                  "type": "string",
                  "minLength": 1
                },
                "releaseDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-fA-F0-9]{64}$"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "attributes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bindingId",
          "consumerTenant",
          "consumerService",
          "importedContract",
          "providerTenant",
          "providerService",
          "providerContract",
          "mode",
          "policyDigest"
        ],
        "properties": {
          "bindingId": {
            "type": "string",
            "minLength": 1
          },
          "consumerTenant": {
            "type": "string",
            "minLength": 1
          },
          "consumerService": {
            "type": "string",
            "minLength": 1
          },
          "importedContract": {
            "type": "string",
            "minLength": 1
          },
          "providerTenant": {
            "type": "string",
            "minLength": 1
          },
          "providerService": {
            "type": "string",
            "minLength": 1
          },
          "providerContract": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "policyDigest": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policyDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "snapshotDigest": {
      "type": "string",
      "minLength": 1
    }
  }
}
