{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1alpha1/trigger.schema.json",
  "title": "LSF Trigger",
  "type": "object",
  "maxProperties": 4,
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "$defs": {
    "configurationValue": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/configurationValue"
      },
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/configurationValue"
      }
    },
    "bufferedHttpTrigger": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "required": [
            "tenant"
          ],
          "properties": {
            "name": {
              "maxLength": 128
            },
            "tenant": {
              "maxLength": 128
            },
            "namespace": {
              "maxLength": 128
            },
            "labels": {
              "maxProperties": 16
            },
            "annotations": {
              "maxProperties": 16
            }
          }
        },
        "spec": {
          "type": "object",
          "properties": {
            "target": {
              "type": "object",
              "required": [
                "route",
                "publication",
                "revision",
                "deploymentGeneration"
              ],
              "properties": {
                "service": {
                  "maxLength": 128
                },
                "contract": {
                  "const": "latent:web/application@0.1.0"
                },
                "function": {
                  "const": "handle"
                },
                "route": {
                  "maxLength": 128
                }
              }
            },
            "configuration": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 6,
              "required": [
                "profile",
                "scheme",
                "host",
                "path",
                "pathMatch",
                "method"
              ],
              "properties": {
                "profile": {
                  "const": "buffered-v1"
                },
                "scheme": {
                  "enum": [
                    "http",
                    "https"
                  ]
                },
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "pathMatch": {
                  "enum": [
                    "exact",
                    "prefix"
                  ]
                },
                "method": {
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "OPTIONS"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "apiVersion": {
      "const": "latent.dev/v1alpha1"
    },
    "kind": {
      "enum": [
        "HttpTrigger",
        "EventTrigger",
        "TimerTrigger",
        "QueueTrigger",
        "BlobTrigger",
        "DirectInvocationTrigger"
      ]
    },
    "metadata": {
      "type": "object",
      "maxProperties": 5,
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "maxProperties": 2,
      "additionalProperties": false,
      "required": [
        "target",
        "configuration"
      ],
      "properties": {
        "target": {
          "type": "object",
          "maxProperties": 7,
          "additionalProperties": false,
          "required": [
            "service",
            "contract",
            "function"
          ],
          "properties": {
            "service": {
              "type": "string",
              "minLength": 1
            },
            "contract": {
              "type": "string",
              "minLength": 1
            },
            "function": {
              "type": "string",
              "minLength": 1
            },
            "route": {
              "type": "string",
              "minLength": 1
            },
            "publication": {
              "type": "string",
              "minLength": 83,
              "maxLength": 83,
              "pattern": "^publication:sha256:[a-f0-9]{64}$"
            },
            "revision": {
              "type": "string",
              "minLength": 83,
              "maxLength": 83,
              "pattern": "^revision-v1:sha256:[a-f0-9]{64}$"
            },
            "deploymentGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          }
        },
        "configuration": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "$ref": "#/$defs/configurationValue"
          }
        }
      }
    }
  },
  "if": {
    "required": [
      "kind",
      "spec"
    ],
    "properties": {
      "kind": {
        "const": "HttpTrigger"
      },
      "spec": {
        "required": [
          "configuration"
        ],
        "properties": {
          "configuration": {
            "required": [
              "profile"
            ]
          }
        }
      }
    }
  },
  "then": {
    "$ref": "#/$defs/bufferedHttpTrigger"
  },
  "description": "Generic trigger envelope. HttpTrigger configuration with a profile selects the closed buffered-v1 profile; older profile-less examples are structural declarations and cannot be published as executable HTTP routes."
}
