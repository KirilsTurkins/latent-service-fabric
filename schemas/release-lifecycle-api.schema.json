{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/release-lifecycle-api.schema.json",
  "title": "LSF closed release lifecycle Protobuf JSON projection",
  "$comment": "Named $defs select the exact RPC message. This explicit closed JSON profile uses symbolic enums, decimal-string uint64, and omitted optional fields (no null), matching Protobuf JSON representation; there is no new JSON listener or CLI command. Repeated evidence arrays are explicit. Runtime validates UTF-8/capacity/aggregate limits and exact associations. Native RPC accepts protobuf wire encoding. Output status/receipts never confer authority.",
  "anyOf": [
    {
      "$ref": "#/$defs/ChangeReleaseLifecycleRequest"
    },
    {
      "$ref": "#/$defs/RenewReleaseEvidenceRequest"
    },
    {
      "$ref": "#/$defs/GetReleaseLifecycleRequest"
    },
    {
      "$ref": "#/$defs/GetReleaseOperationRequest"
    },
    {
      "$ref": "#/$defs/GetReleaseLifecycleResponse"
    },
    {
      "$ref": "#/$defs/GetReleaseOperationResponse"
    },
    {
      "$ref": "#/$defs/MutationResponse"
    }
  ],
  "$defs": {
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "kind"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "RELEASE_ACTOR_KIND_USER",
            "RELEASE_ACTOR_KIND_SERVICE",
            "RELEASE_ACTOR_KIND_NODE",
            "RELEASE_ACTOR_KIND_TRIGGER",
            "RELEASE_ACTOR_KIND_ADMINISTRATOR",
            "RELEASE_ACTOR_KIND_ANONYMOUS",
            "RELEASE_ACTOR_KIND_HOST"
          ]
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "generation",
        "digest"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        },
        "generation": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
          "maxLength": 20
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        }
      }
    },
    "Record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "componentDigest",
        "state",
        "generation",
        "actor",
        "reason",
        "operationId"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        },
        "componentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        },
        "state": {
          "enum": [
            "RELEASE_LIFECYCLE_STATE_ADMITTED",
            "RELEASE_LIFECYCLE_STATE_REVOKED",
            "RELEASE_LIFECYCLE_STATE_RETIRED"
          ]
        },
        "generation": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
          "maxLength": 20
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "enum": [
            "RELEASE_LIFECYCLE_REASON_ADMITTED",
            "RELEASE_LIFECYCLE_REASON_EVIDENCE_RENEWED",
            "RELEASE_LIFECYCLE_REASON_OPERATOR_REVOCATION",
            "RELEASE_LIFECYCLE_REASON_SECURITY_INCIDENT",
            "RELEASE_LIFECYCLE_REASON_CORRUPT_CONTENT",
            "RELEASE_LIFECYCLE_REASON_SUPERSEDED",
            "RELEASE_LIFECYCLE_REASON_END_OF_SUPPORT",
            "RELEASE_LIFECYCLE_REASON_OPERATOR_RETIREMENT",
            "RELEASE_LIFECYCLE_REASON_INVALID_PACKAGE",
            "RELEASE_LIFECYCLE_REASON_INTEGRITY_MISMATCH",
            "RELEASE_LIFECYCLE_REASON_INCOMPATIBLE_CONTRACT",
            "RELEASE_LIFECYCLE_REASON_EVIDENCE_REJECTED",
            "RELEASE_LIFECYCLE_REASON_POLICY_DENIED",
            "RELEASE_LIFECYCLE_REASON_RELEASE_REVOKED",
            "RELEASE_LIFECYCLE_REASON_RELEASE_RETIRED",
            "RELEASE_LIFECYCLE_REASON_GENERATION_CONFLICT",
            "RELEASE_LIFECYCLE_REASON_CONTENT_CONFLICT"
          ]
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        },
        "packageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "observedAtUnixMillis": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
          "maxLength": 20
        },
        "evidenceRevisionDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        }
      }
    },
    "OperationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "requestDigest",
        "tenant",
        "actor",
        "action",
        "disposition",
        "reason"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "action": {
          "enum": [
            "RELEASE_LIFECYCLE_ACTION_PUBLISH",
            "RELEASE_LIFECYCLE_ACTION_REVOKE",
            "RELEASE_LIFECYCLE_ACTION_RETIRE",
            "RELEASE_LIFECYCLE_ACTION_RENEW_EVIDENCE"
          ]
        },
        "disposition": {
          "enum": [
            "RELEASE_OPERATION_DISPOSITION_COMMITTED",
            "RELEASE_OPERATION_DISPOSITION_REJECTED"
          ]
        },
        "reason": {
          "enum": [
            "RELEASE_LIFECYCLE_REASON_ADMITTED",
            "RELEASE_LIFECYCLE_REASON_EVIDENCE_RENEWED",
            "RELEASE_LIFECYCLE_REASON_OPERATOR_REVOCATION",
            "RELEASE_LIFECYCLE_REASON_SECURITY_INCIDENT",
            "RELEASE_LIFECYCLE_REASON_CORRUPT_CONTENT",
            "RELEASE_LIFECYCLE_REASON_SUPERSEDED",
            "RELEASE_LIFECYCLE_REASON_END_OF_SUPPORT",
            "RELEASE_LIFECYCLE_REASON_OPERATOR_RETIREMENT",
            "RELEASE_LIFECYCLE_REASON_INVALID_PACKAGE",
            "RELEASE_LIFECYCLE_REASON_INTEGRITY_MISMATCH",
            "RELEASE_LIFECYCLE_REASON_INCOMPATIBLE_CONTRACT",
            "RELEASE_LIFECYCLE_REASON_EVIDENCE_REJECTED",
            "RELEASE_LIFECYCLE_REASON_POLICY_DENIED",
            "RELEASE_LIFECYCLE_REASON_RELEASE_REVOKED",
            "RELEASE_LIFECYCLE_REASON_RELEASE_RETIRED",
            "RELEASE_LIFECYCLE_REASON_GENERATION_CONFLICT",
            "RELEASE_LIFECYCLE_REASON_CONTENT_CONFLICT"
          ]
        },
        "componentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        },
        "packageManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        },
        "expectedGeneration": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
          "maxLength": 20
        },
        "record": {
          "$ref": "#/$defs/Record"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "observedAtUnixMillis": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
          "maxLength": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "RELEASE_OPERATION_DISPOSITION_COMMITTED"
              }
            }
          },
          "then": {
            "required": [
              "record",
              "componentDigest"
            ]
          }
        }
      ]
    },
    "Status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "eligibility",
        "eligibilityReason"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/Record"
        },
        "eligibility": {
          "enum": [
            "RELEASE_LIVE_ELIGIBILITY_ELIGIBLE",
            "RELEASE_LIVE_ELIGIBILITY_DENIED",
            "RELEASE_LIVE_ELIGIBILITY_UNKNOWN"
          ]
        },
        "eligibilityReason": {
          "enum": [
            "RELEASE_ELIGIBILITY_REASON_LOCAL_ELIGIBLE",
            "RELEASE_ELIGIBILITY_REASON_VERIFIED",
            "RELEASE_ELIGIBILITY_REASON_REVOKED",
            "RELEASE_ELIGIBILITY_REASON_RETIRED",
            "RELEASE_ELIGIBILITY_REASON_POLICY_DENIED",
            "RELEASE_ELIGIBILITY_REASON_PROOF_EXPIRED",
            "RELEASE_ELIGIBILITY_REASON_RUNTIME_INCOMPATIBLE",
            "RELEASE_ELIGIBILITY_REASON_CORRUPT_CONTENT",
            "RELEASE_ELIGIBILITY_REASON_AUTHORITY_UNAVAILABLE",
            "RELEASE_ELIGIBILITY_REASON_MUTATION_UNCERTAIN"
          ]
        }
      }
    },
    "MutationPrecondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "expectedGeneration"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        },
        "expectedGeneration": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
          "maxLength": 20
        }
      }
    },
    "ChangeReleaseLifecycleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "action",
        "operation",
        "reason"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        },
        "action": {
          "enum": [
            "RELEASE_LIFECYCLE_ACTION_REVOKE",
            "RELEASE_LIFECYCLE_ACTION_RETIRE"
          ]
        },
        "operation": {
          "$ref": "#/$defs/MutationPrecondition"
        },
        "reason": {
          "enum": [
            "RELEASE_LIFECYCLE_REASON_OPERATOR_REVOCATION",
            "RELEASE_LIFECYCLE_REASON_SECURITY_INCIDENT",
            "RELEASE_LIFECYCLE_REASON_CORRUPT_CONTENT",
            "RELEASE_LIFECYCLE_REASON_SUPERSEDED",
            "RELEASE_LIFECYCLE_REASON_END_OF_SUPPORT",
            "RELEASE_LIFECYCLE_REASON_OPERATOR_RETIREMENT"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "RELEASE_LIFECYCLE_ACTION_REVOKE"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "RELEASE_LIFECYCLE_REASON_OPERATOR_REVOCATION",
                  "RELEASE_LIFECYCLE_REASON_SECURITY_INCIDENT",
                  "RELEASE_LIFECYCLE_REASON_CORRUPT_CONTENT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "RELEASE_LIFECYCLE_ACTION_RETIRE"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "RELEASE_LIFECYCLE_REASON_SUPERSEDED",
                  "RELEASE_LIFECYCLE_REASON_END_OF_SUPPORT",
                  "RELEASE_LIFECYCLE_REASON_OPERATOR_RETIREMENT"
                ]
              }
            }
          }
        }
      ]
    },
    "RenewReleaseEvidenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "packageDigest",
        "operation",
        "evidence"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        },
        "packageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        },
        "operation": {
          "$ref": "#/$defs/MutationPrecondition"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signatures",
            "provenance",
            "sboms"
          ],
          "properties": {
            "signatures": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "manifest",
                  "configuration",
                  "payload"
                ],
                "properties": {
                  "manifest": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 349528,
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
                  },
                  "configuration": {
                    "const": "e30="
                  },
                  "payload": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 5464,
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
                  }
                }
              },
              "minItems": 1
            },
            "provenance": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "manifest",
                  "configuration",
                  "payload"
                ],
                "properties": {
                  "manifest": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 349528,
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
                  },
                  "configuration": {
                    "const": "e30="
                  },
                  "payload": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 65536,
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
                  }
                }
              },
              "minItems": 1
            },
            "sboms": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "manifest",
                  "configuration",
                  "payload"
                ],
                "properties": {
                  "manifest": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 349528,
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
                  },
                  "configuration": {
                    "const": "e30="
                  },
                  "payload": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 1398104,
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
                  }
                }
              }
            }
          }
        }
      }
    },
    "GetReleaseLifecycleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 71,
          "maxLength": 71
        }
      }
    },
    "GetReleaseOperationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        }
      }
    },
    "GetReleaseLifecycleResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "status": {
          "$ref": "#/$defs/Status"
        }
      }
    },
    "GetReleaseOperationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookup"
      ],
      "properties": {
        "lookup": {
          "enum": [
            "RELEASE_OPERATION_LOOKUP_DISPOSITION_FOUND",
            "RELEASE_OPERATION_LOOKUP_DISPOSITION_UNKNOWN",
            "RELEASE_OPERATION_LOOKUP_DISPOSITION_UNCERTAIN"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/OperationReceipt"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lookup": {
                "const": "RELEASE_OPERATION_LOOKUP_DISPOSITION_FOUND"
              }
            }
          },
          "then": {
            "required": [
