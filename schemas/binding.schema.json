{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1alpha1/binding.schema.json",
  "title": "LSF Binding",
  "type": "object",
  "maxProperties": 4,
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "$defs": {
    "endpoint": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": false,
      "required": [
        "service",
        "contract"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "apiVersion": {
      "const": "latent.dev/v1alpha1"
    },
    "kind": {
      "const": "Binding"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 5,
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": false,
      "required": [
        "consumer",
        "provider",
        "mode"
      ],
      "properties": {
        "consumer": {
          "$ref": "#/$defs/endpoint"
        },
        "provider": {
          "$ref": "#/$defs/endpoint"
        },
        "mode": {
          "enum": [
            "host",
            "inline",
            "isolated-local",
            "remote",
            "auto"
          ]
        }
      }
    }
  }
}
