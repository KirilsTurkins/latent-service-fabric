{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/cli-registry-profile.schema.json",
  "title": "LSF explicit CLI registry profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "origin",
    "repository",
    "addresses"
  ],
  "properties": {
    "formatVersion": {
      "enum": [
        1,
        2
      ]
    },
    "origin": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^https?://[^\\s]+(?![\\s\\S])"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "addresses": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 64
      }
    },
    "allowInsecureLoopback": {
      "type": "boolean",
      "default": false
    },
    "credentialFile": {
      "$ref": "#/$defs/path"
    },
    "rootCertificates": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "bearerChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realm",
        "service",
        "identity",
        "actions",
        "addresses"
      ],
      "properties": {
        "realm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^https://[^\\s]+$"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant",
            "principal",
            "credentialEpoch"
          ],
          "properties": {
            "tenant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+(?![\\s\\S])"
            },
            "principal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[!-~]+(?![\\s\\S])"
            },
            "credentialEpoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          }
        },
        "actions": {
          "enum": [
            "pull",
            "pull-push"
          ]
        },
        "addresses": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumRedirects",
        "destinations"
      ],
      "properties": {
        "maximumRedirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "addresses",
              "resolution",
              "contentPrefixes"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^https://[^\\s]+$"
              },
              "addresses": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "networks",
                  "specialAddresses"
                ],
                "properties": {
                  "networks": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 49
                    }
                  },
                  "specialAddresses": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 45
                    }
                  }
                }
              },
              "resolution": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "addresses"
                    ],
                    "properties": {
                      "mode": {
                        "const": "static"
                      },
                      "addresses": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 16,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 45
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "server",
                      "maximumTtlSeconds"
                    ],
                    "properties": {
                      "mode": {
                        "const": "dns"
                      },
                      "server": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "maximumTtlSeconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 300
                      }
                    }
                  }
                ]
              },
              "contentPrefixes": {
                "type": "array",
                "minItems": 0,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9_.-]*\\.(?:/|$))[A-Za-z0-9_.-]{1,64}(?:/(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9_.-]*\\.(?:/|$))[A-Za-z0-9_.-]{1,64})*(?![\\s\\S])"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formatVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "bearerChallenge": false,
          "network": false
        }
      },
      "else": {
        "required": [
          "bearerChallenge",
          "credentialFile"
        ],
        "properties": {
          "allowInsecureLoopback": {
            "const": false
          },
          "origin": {
            "pattern": "^https://"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "network"
        ]
      },
      "then": {
        "properties": {
          "addresses": {
            "maxItems": 0
          },
          "bearerChallenge": {
            "properties": {
              "addresses": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
