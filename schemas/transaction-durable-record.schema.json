{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/transaction-durable-record.schema.json",
  "title": "Independently versioned Phase 4 durable record envelope",
  "type": "object", "additionalProperties": false,
  "required": ["recordFormat", "recordVersion", "recordId", "namespaceIncarnation", "payload", "payloadFormat", "linkedRecords"],
  "properties": {
    "recordFormat": {"enum": ["lsf-command-result-v1", "lsf-effect-intent-v1", "lsf-inbox-record-v1", "lsf-ordering-record-v1", "lsf-checkpoint-record-v1"]},
    "recordVersion": {"const": 1}, "recordId": {"$ref": "#/$defs/identity"}, "namespaceIncarnation": {"$ref": "#/$defs/identity"},
    "payload": {"type": "string", "maxLength": 1398104, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "payloadFormat": {"$ref": "#/$defs/identity"},
    "payloadExpiresAtUnixMillis": {"$ref": "#/$defs/u64"}, "identityExpiresAtUnixMillis": {"$ref": "#/$defs/u64"},
    "remainingRecoveryMillis": {"$ref": "#/$defs/u64"},
    "linkedRecords": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "u64": {"type": "string", "maxLength": 20, "pattern": "^(0|[1-9][0-9]{0,19})$"}
  }
}
