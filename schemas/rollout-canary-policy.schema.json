{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/rollout-canary-policy.schema.json",
  "title": "Explicit rollout canary policy",
  "description": "An immutable operator declaration, not evidence of health or a universal SLO. Candidate minima and complete observation coverage are checked by the runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "observationMillis", "minimumCandidateSamples", "maximumFailureBasisPoints", "latencyThresholdMicros", "maximumSlowBasisPoints"],
  "properties": {
    "formatVersion": {"const": 1},
    "observationMillis": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "minimumCandidateSamples": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "maximumFailureBasisPoints": {"type": "integer", "minimum": 0, "maximum": 9999},
    "latencyThresholdMicros": {"type": "integer", "enum": [100, 1000, 5000, 10000, 50000, 100000, 1000000, 10000000]},
    "maximumSlowBasisPoints": {"type": "integer", "minimum": 0, "maximum": 10000}
  }
}
