{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/package-build-inputs.schema.json",
  "title": "LSF v1 observed package input and output receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "operation",
    "packager",
    "packagerVersion",
    "inputs"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "operation": {
      "const": "package-supplied-artifacts"
    },
    "packager": {
      "const": "latent-packaging"
    },
    "packagerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9.+-]+(?![\\s\\S])"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "$ref": "#/$defs/input"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9_.-]*\\.(?:/|$))[A-Za-z0-9_.-]{1,64}(?:/(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9_.-]*\\.(?:/|$))[A-Za-z0-9_.-]{1,64})*(?![\\s\\S])",
      "not": {
        "const": "package/build-inputs.json"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "inputDigest",
        "inputSize",
        "outputDigest",
        "outputSize"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "role": {
          "enum": [
            "component",
            "capsule-manifest",
            "contracts",
            "wit-lock",
            "renderer",
            "asset"
          ]
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "inputSize": {
          "$ref": "#/$defs/size"
        },
        "outputDigest": {
          "$ref": "#/$defs/digest"
        },
        "outputSize": {
          "$ref": "#/$defs/size"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "component",
                  "capsule-manifest",
                  "contracts",
                  "wit-lock",
                  "renderer"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "inputSize": {
                "minimum": 1
              },
              "outputSize": {
                "minimum": 1
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "Metadata, not verified provenance: inputDigest/inputSize are externally asserted input identities. The Rust validator additionally bounds document/UTF-8/node/lexical integer shape and aggregate bytes, requires strictly sorted unique paths and exact output path/role/digest/size association with the package layers excluding this receipt. Packager strings are not authentication. One of 256 package layers is reserved for this receipt."
}
