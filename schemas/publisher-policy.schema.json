{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/publisher-policy.schema.json",
  "title": "LSF v1 operator-approved package publisher policy",
  "$comment": "Shape validation does not approve this local policy. Rust applies configured lower bounds, 65536-byte limit, strict key validation, duplicate-key/fingerprint rejection, validity ordering and canonical content identity. An empty key set explicitly denies every publisher.",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "scope", "generation", "validFrom", "validUntil", "maxSignatureLifetimeSeconds", "maxProofAgeSeconds", "keys"],
  "properties": {
    "formatVersion": {"const": 1},
    "scope": {"$ref": "#/$defs/identifier"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "validFrom": {"$ref": "#/$defs/time"},
    "validUntil": {"$ref": "#/$defs/time"},
    "maxSignatureLifetimeSeconds": {"type": "integer", "minimum": 1, "maximum": 2678400},
    "maxProofAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "keys": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["publisherId", "publicKey", "validFrom", "validUntil"],
        "properties": {
          "publisherId": {"$ref": "#/$defs/identifier"},
          "publicKey": {"type": "string", "minLength": 44, "maxLength": 44, "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=(?![\\s\\S])"},
          "validFrom": {"$ref": "#/$defs/time"},
          "validUntil": {"$ref": "#/$defs/time"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/@-]+(?![\\s\\S])"},
    "time": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
  }
}
