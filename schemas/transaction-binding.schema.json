{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/transaction-binding.schema.json",
  "title": "Exact declarative transaction compatibility binding",
  "description": "Companion declaration binds existing Capsule/Deployment/Binding identities without silently widening their supported stateless format. Its acceptance is structural; runtime selection requires separately installed Phase 4 support and authenticated management admission.",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "capsule", "deployment", "binding", "profile", "hostAbiDigest", "namespace", "stateSchema", "operations"],
  "properties": {
    "apiVersion": {"const": "latent.dev/v1"}, "kind": {"const": "TransactionBinding"},
    "capsule": {"$ref": "#/$defs/identity"}, "deployment": {"$ref": "#/$defs/identity"}, "binding": {"$ref": "#/$defs/identity"},
    "profile": {"const": "lsf-transaction-v1"}, "hostAbiDigest": {"$ref": "#/$defs/digest"},
    "namespace": {"$ref": "#/$defs/identity"}, "stateSchema": {"$ref": "#/$defs/digest"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false, "required": ["operation", "mode", "inputFormat", "resultFormat"],
        "properties": {"operation": {"$ref": "#/$defs/identity"}, "mode": {"enum": ["strict-command", "fresh-query"]},
          "inputFormat": {"$ref": "#/$defs/identity"}, "resultFormat": {"$ref": "#/$defs/identity"}}}
    }
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71}
  }
}
