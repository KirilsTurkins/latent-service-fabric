{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/package-admission-receipt.schema.json",
  "title": "LSF historical package admission receipt",
  "$comment": "Historical bounded data, never an eligibility grant. Rust requires exact canonical serialization, <=16 KiB, valid interval ordering, exact policy identity and all package/component/evidence associations; recovery re-verifies retained bytes against current approved trust. Nullable SBOM fields are present explicitly. Cryptographic signatures authenticate package/evidence, not arbitrary receipt files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "disposition",
    "tenant",
    "package",
    "release",
    "publisher",
    "publisherKey",
    "signatureManifest",
    "signaturePayload",
    "builder",
    "builderKey",
    "provenanceManifest",
    "provenancePayload",
    "sbomInventory",
    "sbomReferrer",
    "policy",
    "policyDigest",
    "epoch",
    "verifiedAt",
    "validUntil"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "disposition": {
      "const": "admitted"
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/@-]+(?![\\s\\S])"
    },
    "package": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "release": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/@-]+(?![\\s\\S])"
    },
    "publisherKey": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "signatureManifest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "signaturePayload": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "builder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/@-]+(?![\\s\\S])"
    },
    "builderKey": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "provenanceManifest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "provenancePayload": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "sbomInventory": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "sbomReferrer": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "scope",
        "validFrom",
        "validUntil",
        "tenantsDigest",
        "publisher",
        "publisherRevocations",
        "builder",
        "builderRevocations",
        "sbomDigest"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/@-]+(?![\\s\\S])"
        },
        "validFrom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "validUntil": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "tenantsDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "digest"
          ],
          "properties": {
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            }
          }
        },
        "publisherRevocations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "digest"
          ],
          "properties": {
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            }
          }
        },
        "builder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "digest"
          ],
          "properties": {
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            }
          }
        },
        "builderRevocations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "digest"
          ],
          "properties": {
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            }
          }
        },
        "sbomDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "verifiedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "validUntil": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  }
}
