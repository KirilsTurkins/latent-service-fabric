{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/web-build-observation.schema.json",
  "title": "LSF web build observation",
  "$comment": "Unsigned data. Legacy supplied-file assembly and actual Angular compilation require separately approved build types. Exact output descriptors exclude only package/sbom.cdx.json and package/build-inputs.json to avoid digest cycles; the full package authenticates both. Rust additionally checks profile and renderer identities, distinct materials, byte/capacity bounds and ordered timestamps within one hour. Neither profile asserts hermeticity or complete dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "buildType",
    "source",
    "materials",
    "parameters",
    "startedAt",
    "finishedAt",
    "reproducibility",
    "hermetic",
    "dependencyCompleteness",
    "outputsDigest",
    "outputsCount",
    "outputsBytes"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "buildType": {
      "enum": [
        "https://latent.dev/build/web-package-assembly/v1",
        "https://latent.dev/build/angular-component/v1"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "snapshotDigest",
        "repositoryTrust",
        "capture"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "repositoryTrust": {
          "const": "operator-asserted"
        },
        "capture": {
          "const": "explicit-input-files"
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 4,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "source-snapshot"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "build-recipe"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "toolchain-config"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "package-assembler"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "parameters": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assembler",
            "recipeVersion",
            "inputMode"
          ],
          "properties": {
            "assembler": {
              "const": "lsf-web-package-assembly"
            },
            "recipeVersion": {
              "const": 1
            },
            "inputMode": {
              "const": "explicit-supplied-files"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compiler",
            "recipeVersion",
            "rendererProfile",
            "profileDigest",
            "rendererDigest",
            "rendererSize",
            "maxHydrationBytes",
            "lifecycleScripts"
          ],
          "properties": {
            "compiler": {
              "const": "lsf-angular-component"
            },
            "recipeVersion": {
              "const": 1
            },
            "rendererProfile": {
              "const": "angular-ssr-component-v1"
            },
            "profileDigest": {
              "$ref": "#/$defs/digest"
            },
            "rendererDigest": {
              "$ref": "#/$defs/digest"
            },
            "rendererSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            },
            "maxHydrationBytes": {
              "const": 32768
            },
            "lifecycleScripts": {
              "const": false
            }
          }
        }
      ]
    },
    "startedAt": {
      "$ref": "#/$defs/time"
    },
    "finishedAt": {
      "$ref": "#/$defs/time"
    },
    "reproducibility": {
      "enum": [
        "not-checked",
        "two-build-byte-equality"
      ]
    },
    "hermetic": {
      "const": false
    },
    "dependencyCompleteness": {
      "const": "declared-inputs-incomplete"
    },
    "outputsDigest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "outputsCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "outputsBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/@-]+(?![\\s\\S])"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    },
    "repository": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://(?=[^/]{1,253}/)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*/(?!\\.{1,2}(?:/|(?![\\s\\S])))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[A-Za-z0-9._-]+)*(?![\\s\\S])"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "buildType": {
            "const": "https://latent.dev/build/angular-component/v1"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "compiler",
              "recipeVersion",
              "rendererProfile",
              "profileDigest",
              "rendererDigest",
              "rendererSize",
              "maxHydrationBytes",
              "lifecycleScripts"
            ],
            "properties": {
              "compiler": {
                "const": "lsf-angular-component"
              },
              "recipeVersion": {
                "const": 1
              },
              "rendererProfile": {
                "const": "angular-ssr-component-v1"
              },
              "profileDigest": {
                "$ref": "#/$defs/digest"
              },
              "rendererDigest": {
                "$ref": "#/$defs/digest"
              },
              "rendererSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              },
              "maxHydrationBytes": {
                "const": 32768
              },
              "lifecycleScripts": {
                "const": false
              }
            }
          },
          "materials": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "node"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "cargo"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "rustc"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "wasm-tools"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "dependency-lock"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "npm-lock"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "npm-tree"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "javascript-embedding"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "async-adapter"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "adapter-source"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "public-wit"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "private-wit"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "renderer-component"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "angular-server-bundle"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "angular-client-bundle"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assembler",
              "recipeVersion",
              "inputMode"
            ],
            "properties": {
              "assembler": {
                "const": "lsf-web-package-assembly"
              },
              "recipeVersion": {
                "const": 1
              },
              "inputMode": {
                "const": "explicit-supplied-files"
              }
            }
          }
        }
      }
    }
  ]
}
