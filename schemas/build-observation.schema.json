                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "rustc"
                    }
                  },
                  "required": [
                    "name"
                  ]
