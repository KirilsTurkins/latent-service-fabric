{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/build-observation.schema.json",
  "title": "LSF v1 unsigned bounded build observations",
  "$comment": "This shape confers no builder authority. Rust additionally checks raw bytes <=32768, unique material names, snapshot material equality, ordered timestamps within3600seconds, duplicate keys and integer token spelling. Repo is an operator assertion, not authenticated source ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "buildType",
    "source",
    "componentDigest",
    "componentSize",
    "materials",
    "parameters",
    "startedAt",
    "finishedAt",
    "reproducibility",
    "hermetic",
    "dependencyCompleteness"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "buildType": {
      "enum": [
        "https://latent.dev/build/echo-capsule/v1",
        "https://latent.dev/build/rust-guest/v1",
        "https://latent.dev/build/c-guest/v1",
        "https://latent.dev/build/rust-capsule/v1",
        "https://latent.dev/build/typescript-capsule/v1",
        "https://latent.dev/build/go-capsule/v1"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "snapshotDigest",
        "repositoryTrust",
        "capture"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "repositoryTrust": {
          "const": "operator-asserted"
        },
        "capture": {
          "enum": [
            "git-archive-allowlist",
            "explicit-input-files"
          ]
        }
      }
    },
    "componentDigest": {
      "$ref": "#/$defs/digest"
    },
    "componentSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "materials": {
      "type": "array",
      "minItems": 6,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "source-snapshot"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "build-recipe"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "toolchain-config"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "wasm-tools"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "parameters": {
      "type": "object"
    },
    "startedAt": {
      "$ref": "#/$defs/time"
    },
    "finishedAt": {
      "$ref": "#/$defs/time"
    },
    "reproducibility": {
      "enum": [
        "not-checked",
        "two-build-byte-equality"
      ]
    },
    "hermetic": {
      "const": false
    },
    "dependencyCompleteness": {
      "enum": [
        "lockfile-only",
        "declared-inputs-incomplete"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/@-]+(?![\\s\\S])"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    },
    "repository": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://(?=[^/]{1,253}/)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*/(?!\\.{1,2}(?:/|(?![\\s\\S])))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[A-Za-z0-9._-]+)*(?![\\s\\S])"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "buildType": {
            "const": "https://latent.dev/build/echo-capsule/v1"
          }
        },
