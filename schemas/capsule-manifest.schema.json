{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1alpha1/capsule-manifest.schema.json",
  "title": "LSF Capsule",
  "type": "object",
  "maxProperties": 8,
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "component",
    "exports",
    "imports",
    "execution",
    "compatibility"
  ],
  "properties": {
    "apiVersion": {
      "const": "latent.dev/v1alpha1"
    },
    "kind": {
      "const": "Capsule"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 5,
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": false,
      "required": [
        "digest",
        "version",
        "world"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "world": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exports": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "imports": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "maxProperties": 2,
        "additionalProperties": false,
        "required": [
          "contract"
        ],
        "properties": {
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": false,
      "required": [
        "backend",
        "threading",
        "stateModel",
        "limits"
      ],
      "properties": {
        "backend": {
          "enum": [
            "wasm-component",
            "ephemeral-process",
            "container",
            "microvm",
            "remote-provider"
          ]
        },
        "threading": {
          "enum": [
            "single-threaded",
            "reentrant",
            "cooperative"
          ]
        },
        "stateModel": {
          "enum": [
            "stateless",
            "transactional-keyed",
            "entity",
            "durable-workflow"
          ]
        },
        "limits": {
          "type": "object",
          "maxProperties": 11,
          "additionalProperties": false,
          "required": [
            "cpuFuel",
            "memoryBytes",
            "childCalls",
            "outboundRequests",
            "stateReadBytes",
            "stateWriteBytes",
            "blobReadBytes",
            "blobWriteBytes",
            "logBytes",
            "effectCount"
          ],
          "properties": {
            "cpuFuel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "memoryBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "wallTimeLimitMillis": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "childCalls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "outboundRequests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "stateReadBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "stateWriteBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "blobReadBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "blobWriteBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "logBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "effectCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "hostCallDepthMaximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "componentCallDepthMaximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "snapshotEligible": {
          "type": "boolean"
        },
        "fusionEligible": {
          "type": "boolean"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "maxProperties": 1,
      "additionalProperties": false,
      "required": [
        "minimumFabricVersion"
      ],
      "properties": {
        "minimumFabricVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
