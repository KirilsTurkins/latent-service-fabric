{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1alpha1/deployment.schema.json",
  "title": "LSF Deployment",
  "type": "object",
  "maxProperties": 4,
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "latent.dev/v1alpha1"
    },
    "kind": {
      "const": "Deployment"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 5,
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "maxProperties": 7,
      "additionalProperties": false,
      "required": [
        "service",
        "release",
        "route",
        "resources",
        "availability",
        "placement"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "route": {
          "type": "object",
          "maxProperties": 1,
          "additionalProperties": false,
          "required": [
            "weight"
          ],
          "properties": {
            "weight": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "grants": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "maxProperties": 4,
            "additionalProperties": false,
            "required": [
              "capability",
              "policy"
            ],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "policy": {
                "type": "string",
                "minLength": 1
              },
              "operations": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "constraints": {
                "type": "object",
                "maxProperties": 4096,
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "maxProperties": 11,
          "additionalProperties": false,
          "required": [
            "cpuFuel",
            "memoryBytes",
            "childCalls",
            "outboundRequests",
            "stateReadBytes",
            "stateWriteBytes",
            "blobReadBytes",
            "blobWriteBytes",
            "logBytes",
            "effectCount"
          ],
          "properties": {
            "cpuFuel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "memoryBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "wallTimeLimitMillis": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "childCalls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "outboundRequests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "stateReadBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "stateWriteBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "blobReadBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "blobWriteBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "logBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "effectCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "availability": {
          "type": "object",
          "maxProperties": 2,
          "additionalProperties": false,
          "required": [
            "minimumCachedCopies",
            "minimumZones"
          ],
          "properties": {
            "minimumCachedCopies": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "minimumZones": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "placement": {
          "type": "object",
          "maxProperties": 5,
          "additionalProperties": false,
          "required": [
            "trustClass"
          ],
          "properties": {
            "trustClass": {
              "type": "string",
              "minLength": 1
            },
            "architectures": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "regions": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "zones": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "requiredFeatures": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
