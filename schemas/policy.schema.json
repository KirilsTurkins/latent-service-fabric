{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1alpha1/policy.schema.json",
  "title": "LSF Policy",
  "type": "object",
  "maxProperties": 4,
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "latent.dev/v1alpha1"
    },
    "kind": {
      "const": "Policy"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 5,
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "maxProperties": 2,
      "additionalProperties": false,
      "required": [
        "language",
        "document"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
