{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/builder-revocations.schema.json",
  "title": "LSF v1 explicit builder revocation snapshot",
  "$comment": "Explicit empty lists are permitted; unavailable snapshots cannot be invented as empty. Rust checks <=65536bytes, configured lower ceilings, ordered validity, freshness and exact builder policy/scope association.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "scope",
    "policyDigest",
    "generation",
    "validFrom",
    "validUntil",
    "revokedKeys",
    "revokedBuilders"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/identifier"
    },
    "policyDigest": {
      "$ref": "#/$defs/digest"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "validFrom": {
      "$ref": "#/$defs/time"
    },
    "validUntil": {
      "$ref": "#/$defs/time"
    },
    "revokedKeys": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "revokedBuilders": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/@-]+(?![\\s\\S])"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    },
    "repository": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://(?=[^/]{1,253}/)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*/(?!\\.{1,2}(?:/|(?![\\s\\S])))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[A-Za-z0-9._-]+)*(?![\\s\\S])"
    }
  }
}
