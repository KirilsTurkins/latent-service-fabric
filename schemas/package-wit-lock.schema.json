{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/package-wit-lock.schema.json",
  "title": "LSF v1 package WIT source lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "world",
    "contractsDigest",
    "packages"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "world": {
      "$ref": "#/$defs/world"
    },
    "contractsDigest": {
      "$ref": "#/$defs/digest"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9_.-]*\\.(?:/|$))[A-Za-z0-9_.-]{1,64}(?:/(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9_.-]*\\.(?:/|$))[A-Za-z0-9_.-]{1,64})*(?![\\s\\S])"
    },
    "world": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?=[^@]*@.{1,128}(?![\\s\\S]))[a-z](?:[a-z0-9-]{0,126}[a-z0-9])?:[a-z](?:[a-z0-9-]{0,126}[a-z0-9])?/[a-z](?:[a-z0-9-]{0,126}[a-z0-9])?@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?=[^@]*@.{1,128}(?![\\s\\S]))[a-z](?:[a-z0-9-]{0,126}[a-z0-9])?:[a-z](?:[a-z0-9-]{0,126}[a-z0-9])?@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?![\\s\\S])"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourcePath",
        "digest",
        "dependencies"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourcePath": {
          "$ref": "#/$defs/path"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  },
  "$comment": "Codec additionally checks sorted unique IDs/dependencies, graph references/cycles, world membership and exact source/contracts associations."
}
