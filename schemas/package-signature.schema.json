{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/package-signature.schema.json",
  "title": "LSF v1 package signature envelope",
  "$comment": "Closed LSF profile using DSSE PAE, not generic DSSE conformance. Rust additionally bounds raw envelope bytes to 4096, decoded payload to 2048, checks canonical base64/duplicate keys and verifies cryptography and trust.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {"const": "application/vnd.latent.package-signature.v1+json"},
    "payload": {
      "type": "string", "minLength": 4, "maxLength": 2732,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])"
    },
    "signatures": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"},
          "sig": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==(?![\\s\\S])"}
        }
      }
    }
  }
}
