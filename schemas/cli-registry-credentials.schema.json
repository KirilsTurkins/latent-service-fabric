{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/v1/cli-registry-credentials.schema.json",
  "title": "LSF explicit CLI registry credential file",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "username",
        "password"
      ],
      "properties": {
        "mode": {
          "const": "basic"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "password": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "token"
      ],
      "properties": {
        "mode": {
          "const": "bearer"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    }
  ]
}
