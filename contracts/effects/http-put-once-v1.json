    "retainUntilUnixMillis": "min(original-commit-plus-approved-horizon,original-effect-expiry)-canonical-u64-decimal"
  },
  "retention": {
    "minimumHorizonMillis": 1,
    "maximumHorizonMillis": 604800000,
    "minimumRetryDelayMillis": 1,
    "maximumRetryDelayMillis": 60000,
    "refreshOnRetry": false,
    "mutationAfterHorizon": false
  },
  "endpointObligations": [
    "Authenticate-and-check-original-horizon-before-reserving-or-mutating",
    "Atomically-commit-stable-effect-identity-body-hash-incarnation-horizon-mutation-and-receipt",
    "Equal-key-equal-body-within-original-horizon-returns-original-receipt-without-another-mutation",
    "Changed-body-incarnation-or-horizon-for-an-existing-key-is-409-without-mutation",
    "GET-is-read-only-and-binds-the-same-effect-body-hash-incarnation-and-original-horizon",
