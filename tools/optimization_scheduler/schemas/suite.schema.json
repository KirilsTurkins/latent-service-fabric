{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/benchmarks/scheduler-suite.v1.schema.json",
  "title": "Scheduler benchmark suite v1",
  "$comment": "Structural evidence contract only. Semantic replay additionally checks exact populations, source identity, original deadlines, ownership, artifact hashes and allocation coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "plan",
    "builds",
    "runner_source",
    "runner_source_after",
    "status",
    "reason",
    "elapsed_nanos",
    "tools",
    "symbols",
    "runs",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.scheduler-suite.v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "plan": {
      "enum": [
        {
          "schema": "latent.optimization.scheduler-suite-plan.v1",
          "profile": "smoke",
          "children": 14,
          "logical_offers": "1344",
          "load_offers": "936",
          "storm_offers": "272",
          "profile_offers": "136",
          "normal_children": 12,
          "allocation_children": 2,
          "order": "case-order-alternating-first-arm-then-control-candidate-profile",
          "normal_timeout_seconds": 60,
          "allocation_timeout_seconds": 180,
          "profile_report_timeout_seconds": 120,
          "suite_timeout_seconds": 1800,
          "maximum_raw_bytes": "33554432",
          "maximum_aggregate_bytes": "8388608",
          "maximum_total_bytes": "1073741824",
          "maximum_folded_bytes": "67108864",
          "maximum_files": 4096,
          "maximum_profile_records": 4000000,
          "measured_symbol": "latent_scheduler::local::measurement::measured_cancel_and_settle",
          "counter_scope": "normal-storm-32-cancellations-and-original-settlements-only",
          "allocation_boundary": "32-cancel-and-32-original-queued-future-settlements-poll-frame"
        },
        {
          "schema": "latent.optimization.scheduler-suite-plan.v1",
          "profile": "full",
          "children": 14,
          "logical_offers": "9128",
          "load_offers": "8720",
          "storm_offers": "272",
          "profile_offers": "136",
          "normal_children": 12,
          "allocation_children": 2,
          "order": "case-order-alternating-first-arm-then-control-candidate-profile",
          "normal_timeout_seconds": 60,
          "allocation_timeout_seconds": 180,
          "profile_report_timeout_seconds": 120,
          "suite_timeout_seconds": 1800,
          "maximum_raw_bytes": "33554432",
          "maximum_aggregate_bytes": "8388608",
          "maximum_total_bytes": "1073741824",
          "maximum_folded_bytes": "67108864",
          "maximum_files": 4096,
          "maximum_profile_records": 4000000,
          "measured_symbol": "latent_scheduler::local::measurement::measured_cancel_and_settle",
          "counter_scope": "normal-storm-32-cancellations-and-original-settlements-only",
          "allocation_boundary": "32-cancel-and-32-original-queued-future-settlements-poll-frame"
        }
      ]
    },
    "builds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "runner_source": {
      "type": "object",
      "maxProperties": 512,
      "$comment": "Nested source/process/resource proof is checked by semantic replay."
    },
    "runner_source_after": {
      "type": "object",
      "maxProperties": 512,
      "$comment": "Nested source/process/resource proof is checked by semantic replay."
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "tools": {
      "type": "object",
      "maxProperties": 512,
      "$comment": "Nested source/process/resource proof is checked by semantic replay."
    },
    "symbols": {
      "type": "object",
      "maxProperties": 512,
      "$comment": "Nested source/process/resource proof is checked by semantic replay."
    },
    "runs": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "maxProperties": 512,
        "$comment": "Nested source/process/resource proof is checked by semantic replay."
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
