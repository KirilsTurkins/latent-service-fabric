cord \"$second\" ready 1 \"$detail\" || exit 1\n[ \"$elapsed\" -ge \"$started_elapsed\" ]\n)",
                    "wrapper-startup",
                    "/output/events.ndjson"
                  ]
                },
                "initialDelaySeconds": 0,
                "periodSeconds": 1,
                "timeoutSeconds": 1,
                "failureThreshold": 120,
                "successThreshold": 1
