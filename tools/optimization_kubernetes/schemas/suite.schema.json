{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/benchmarks/kubernetes-suite.v1.schema.json",
  "title": "Kubernetes comparison suite v1",
  "$comment": "Completed public benchmark envelope only. Nested shared records and all cross-file, ownership, timing, strict type, hash, cleanup and statistical checks require offline semantic replay. No external references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "run_id",
    "owner",
    "namespace",
    "namespace_uid",
    "plan",
    "source",
    "source_after",
    "build_source",
    "build_receipt",
    "docker_suite",
    "bootstrap",
    "images",
    "seeds",
    "collection_path",
    "build_path",
    "docker_path",
    "bootstrap_path",
    "collector_inputs",
    "build_inputs",
    "started_nanos",
    "finished_nanos",
    "background",
    "namespace_create",
    "namespace_create_call",
    "namespace_absence_call",
    "remote_create_call",
    "groups",
    "clients",
    "preparations",
    "transfers",
    "cleanup",
    "failure"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.kubernetes-suite.v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
    },
    "namespace_uid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "source_after": {
      "$ref": "#/$defs/source"
    },
    "build_source": {
      "$ref": "#/$defs/source"
    },
    "build_receipt": {
      "$ref": "#/$defs/reference"
    },
    "docker_suite": {
      "$ref": "#/$defs/reference"
    },
    "bootstrap": {
      "$ref": "#/$defs/reference"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lsf",
        "native",
        "client"
      ],
      "properties": {
        "lsf": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "native": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "1",
        "8",
        "32"
      ],
      "properties": {
        "1": {
          "type": "object",
          "maxProperties": 4096
        },
        "8": {
          "type": "object",
          "maxProperties": 4096
        },
        "32": {
          "type": "object",
          "maxProperties": 4096
        }
      }
    },
    "collection_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "build_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "docker_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "bootstrap_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "collector_inputs": {
      "type": "object",
      "maxProperties": 3500,
      "additionalProperties": {
        "$ref": "#/$defs/reference"
      }
    },
    "build_inputs": {
      "type": "object",
      "maxProperties": 3500,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bytes",
          "sha256"
        ],
        "properties": {
          "bytes": {
            "$ref": "#/$defs/uint"
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "started_nanos": {
      "$ref": "#/$defs/uint"
    },
    "finished_nanos": {
      "$ref": "#/$defs/uint"
    },
    "background": {
      "type": "array",
      "minItems": 16,
      "maxItems": 88,
      "items": {
        "type": "object",
        "maxProperties": 4096
      }
    },
    "namespace_create": {
      "type": "object",
      "maxProperties": 4096
    },
    "namespace_create_call": {
      "type": "integer",
      "minimum": 0,
      "maximum": 199999
    },
    "namespace_absence_call": {
      "type": "integer",
      "minimum": 0,
      "maximum": 199999
    },
    "remote_create_call": {
      "type": "integer",
      "minimum": 0,
      "maximum": 199999
    },
    "groups": {
      "type": "array",
      "minItems": 6,
      "maxItems": 42,
      "items": {
        "$ref": "#/$defs/groupReference"
      }
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "maxProperties": 4096
      }
    },
    "preparations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 512,
      "items": {
        "type": "object",
        "maxProperties": 4096
      }
    },
    "transfers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "maxProperties": 4096
      }
    },
    "cleanup": {
      "type": "object",
      "maxProperties": 64,
      "required": [
        "schema",
        "errors",
        "namespace_absent",
        "remote_removed",
        "private_tls_removed"
      ],
      "properties": {
        "schema": {
          "const": "latent.optimization.kubernetes-cleanup.v1"
        },
        "errors": {
          "const": []
        },
        "namespace_absent": {
          "const": true
        },
        "remote_removed": {
          "const": true
        },
        "private_tls_removed": {
          "const": true
        }
      }
    },
    "failure": {
      "const": null
    }
  },
  "$defs": {
    "uint": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^lsf-112-[0-9a-f]{12}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "bytes": {
          "$ref": "#/$defs/uint"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "clean",
        "cargo_lock_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "clean": {
          "const": true
        },
        "cargo_lock_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "plan": {
      "type": "object",
      "maxProperties": 64,
      "required": [
        "schema",
        "profile",
        "workload",
        "seed_reuse",
        "measured_services",
        "node_selector"
      ],
      "properties": {
        "schema": {
          "const": "latent.optimization.kubernetes-plan.v1"
        },
        "profile": {
          "enum": [
            "smoke",
            "full"
          ]
        },
        "workload": {
          "type": "object",
          "maxProperties": 64,
          "required": [
            "schema",
            "profile",
            "repetitions",
            "logical_offers",
            "groups"
          ],
          "properties": {
            "schema": {
              "const": "latent.optimization.docker-plan.v1"
            },
            "profile": {
              "enum": [
                "smoke",
                "full"
              ]
            },
            "repetitions": {
              "enum": [
                1,
                7
              ]
            },
            "logical_offers": {
              "enum": [
                "300",
                "9926"
              ]
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "items": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "maxProperties": 4096
                }
              }
            }
          }
        },
        "seed_reuse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "densities",
            "new_lsf_starts",
            "new_management_rpcs",
            "new_guest_invokes"
          ],
          "properties": {
            "source": {
              "const": "docker-stopped-pristine-catalogs"
            },
            "densities": {
              "const": [
                1,
                8,
                32
              ]
            },
            "new_lsf_starts": {
              "const": 0
            },
            "new_management_rpcs": {
              "const": 0
            },
            "new_guest_invokes": {
              "const": 0
            }
          }
        },
        "measured_services": {
          "enum": [
            82,
            574
          ]
        },
        "node_selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latent.benchmark.worker"
          ],
          "properties": {
            "latent.benchmark.worker": {
              "$ref": "#/$defs/owner"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "const": "smoke"
              }
            },
            "required": [
              "profile"
            ]
          },
          "then": {
            "properties": {
              "measured_services": {
                "const": 82
              },
              "workload": {
                "properties": {
                  "profile": {
                    "const": "smoke"
                  },
                  "repetitions": {
                    "const": 1
                  },
                  "logical_offers": {
                    "const": "300"
                  },
                  "groups": {
                    "minItems": 1,
                    "maxItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile": {
                "const": "full"
              }
            },
            "required": [
              "profile"
            ]
          },
          "then": {
            "properties": {
              "measured_services": {
                "const": 574
              },
              "workload": {
                "properties": {
                  "profile": {
                    "const": "full"
                  },
                  "repetitions": {
                    "const": 7
                  },
                  "logical_offers": {
                    "const": "9926"
                  },
                  "groups": {
                    "minItems": 7,
                    "maxItems": 7
                  }
                }
              }
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair",
        "group",
        "arm",
        "density",
        "started_nanos",
        "pod_create_started_nanos",
        "graph_ready_nanos",
        "proxy_ready_nanos",
        "finished_nanos",
        "graph_attempts",
        "proxy_attempts",
        "services",
        "graph",
        "targets",
        "owners",
        "windows",
        "cluster_before",
        "cluster_after",
        "service_deletes"
      ],
      "properties": {
        "pair": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "group": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "arm": {
          "enum": [
            "lsf",
            "native"
          ]
        },
        "density": {
          "enum": [
            1,
            8,
            32
          ]
        },
        "started_nanos": {
          "$ref": "#/$defs/uint"
        },
        "pod_create_started_nanos": {
          "$ref": "#/$defs/uint"
        },
        "graph_ready_nanos": {
          "$ref": "#/$defs/uint"
        },
        "proxy_ready_nanos": {
          "$ref": "#/$defs/uint"
        },
        "finished_nanos": {
          "$ref": "#/$defs/uint"
        },
        "graph_attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pods_call",
              "services_call",
              "slices_call",
              "observed_nanos"
            ],
            "properties": {
              "pods_call": {
                "type": "integer",
                "minimum": 0,
                "maximum": 199999
              },
              "services_call": {
                "type": "integer",
                "minimum": 0,
                "maximum": 199999
              },
              "slices_call": {
                "type": "integer",
                "minimum": 0,
                "maximum": 199999
              },
              "observed_nanos": {
                "$ref": "#/$defs/uint"
              }
            }
          }
        },
        "proxy_attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nat_call",
              "filter_call",
              "observed_nanos",
              "result"
            ],
            "properties": {
              "nat_call": {
                "type": "integer",
                "minimum": 0,
                "maximum": 199999
              },
              "filter_call": {
                "type": "integer",
                "minimum": 0,
                "maximum": 199999
              },
              "observed_nanos": {
                "$ref": "#/$defs/uint"
              },
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ready",
                  "routes"
                ],
                "properties": {
                  "ready": {
                    "type": "boolean"
                  },
                  "routes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "service_name",
                        "service_uid",
                        "cluster_ip",
                        "pod_uid",
                        "pod_ip",
                        "service_chain",
                        "endpoint_chain",
                        "ready",
                        "reason"
                      ],
                      "properties": {
                        "service_name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 63
                        },
                        "service_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "cluster_ip": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 15
                        },
                        "pod_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "pod_ip": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 15
                        },
                        "service_chain": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^KUBE-SVC-[A-Z0-9]{16}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "endpoint_chain": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^KUBE-SEP-[A-Z0-9]{16}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "ready": {
                          "type": "boolean"
                        },
                        "reason": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "maxProperties": 4096
          }
        },
        "graph": {
          "type": "object",
          "maxProperties": 4096
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "maxProperties": 4096
          }
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "maxProperties": 4096
          }
        },
        "windows": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "maxProperties": 4096
          }
        },
        "cluster_before": {
          "type": "object",
          "maxProperties": 4096
        },
        "cluster_after": {
          "type": "object",
          "maxProperties": 4096
        },
        "service_deletes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uid",
              "call",
              "absence_call"
            ],
            "properties": {
              "uid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "call": {
                "type": "integer",
                "minimum": 0,
                "maximum": 199999
              },
              "absence_call": {
                "type": "integer",
                "minimum": 0,
                "maximum": 199999
              }
            }
          }
        }
      }
    },
    "groupReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair",
        "group",
        "arm",
        "density",
        "artifact"
      ],
      "properties": {
        "pair": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "group": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "arm": {
          "enum": [
            "lsf",
            "native"
          ]
        },
        "density": {
          "enum": [
            1,
            8,
            32
          ]
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^group-[0-6]-[0-5]\\.json$"
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "smoke"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "profile": {
                "const": "smoke"
              }
            }
          },
          "groups": {
            "minItems": 6,
            "maxItems": 6
          },
          "clients": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "full"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "profile": {
                "const": "full"
              }
            }
          },
          "groups": {
            "minItems": 42,
            "maxItems": 42
          },
          "clients": {
            "minItems": 7,
            "maxItems": 7
          }
        }
      }
    }
  ]
}
