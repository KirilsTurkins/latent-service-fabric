{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/benchmarks/docker-plan.v1.schema.json",
  "title": "Docker comparison plan v1",
  "$comment": "Closed structural plan and exact profile totals; semantic replay enforces the complete derived group order and every phase value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seed_templates",
    "seed_lsf_starts",
    "seed_management_rpcs",
    "seed_guest_invokes",
    "idle_window_millis",
    "snapshots_per_application",
    "ready_timeout_seconds",
    "group_timeout_seconds",
    "collection_timeout_seconds",
    "maximum_artifact_bytes",
    "maximum_files",
    "maximum_file_bytes",
    "maximum_client_bytes",
    "tenant",
    "contract",
    "node_id",
    "request_budget_millis",
    "cpu_fuel",
    "memory_bytes",
    "log_bytes",
    "connect_timeout_millis",
    "response_timeout_millis",
    "client_workers",
    "wrapper_workers",
    "wrapper_live_connections",
    "wrapper_direction_buffer_bytes",
    "order",
    "profile",
    "repetitions",
    "logical_offers",
    "client_owners",
    "measured_lsf_starts",
    "measured_native_starts",
    "measured_lsf_inventory_rpcs",
    "client_commands",
    "groups"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.docker-plan.v1"
    },
    "seed_templates": {
      "const": 3
    },
    "seed_lsf_starts": {
      "const": 3
    },
    "seed_management_rpcs": {
      "const": 88
    },
    "seed_guest_invokes": {
      "const": 0
    },
    "idle_window_millis": {
      "const": 250
    },
    "snapshots_per_application": {
      "const": 6
    },
    "ready_timeout_seconds": {
      "const": 120
    },
    "group_timeout_seconds": {
      "const": 600
    },
    "collection_timeout_seconds": {
      "const": 7200
    },
    "maximum_artifact_bytes": {
      "const": "1073741824"
    },
    "maximum_files": {
      "const": 4096
    },
    "maximum_file_bytes": {
      "const": "268435456"
    },
    "maximum_client_bytes": {
      "const": "33554432"
    },
    "tenant": {
      "const": "optimization"
    },
    "contract": {
      "const": "optimization:benchmark/workloads@0.1.0"
    },
    "node_id": {
      "const": "optimization-node"
    },
    "request_budget_millis": {
      "const": 1000
    },
    "cpu_fuel": {
      "const": 10000000000
    },
    "memory_bytes": {
      "const": 67108864
    },
    "log_bytes": {
      "const": 16384
    },
    "connect_timeout_millis": {
      "const": 5000
    },
    "response_timeout_millis": {
      "const": 5000
    },
    "client_workers": {
      "const": 2
    },
    "wrapper_workers": {
      "const": 2
    },
    "wrapper_live_connections": {
      "const": 32
    },
    "wrapper_direction_buffer_bytes": {
      "const": 16384
    },
    "order": {
      "const": "rotate-density-by-pair-lsf-first-when-pair-plus-rotated-position-is-even"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "repetitions": {
      "enum": [
        1,
        7
      ]
    },
    "logical_offers": {
      "enum": [
        "300",
        "9926"
      ]
    },
    "client_owners": {
      "enum": [
        1,
        7
      ]
    },
    "measured_lsf_starts": {
      "enum": [
        3,
        21
      ]
    },
    "measured_native_starts": {
      "enum": [
        41,
        287
      ]
    },
    "measured_lsf_inventory_rpcs": {
      "enum": [
        9,
        63
      ]
    },
    "client_commands": {
      "enum": [
        61,
        427
      ]
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ordinal",
            "arm",
            "density",
            "phases"
          ],
          "properties": {
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "arm": {
              "enum": [
                "lsf",
                "native"
              ]
            },
            "density": {
              "enum": [
                1,
                8,
                32
              ]
            },
            "phases": {
              "type": "array",
              "minItems": 3,
              "maxItems": 9,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ordinal",
                  "name",
                  "kind",
                  "offers",
                  "concurrency",
                  "function",
                  "payload"
                ],
                "properties": {
                  "ordinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "name": {
                    "enum": [
                      "first",
                      "density-warmup",
                      "density-measured",
                      "echo-c1-warmup",
                      "echo-c1-measured",
                      "compute-c1-warmup",
                      "compute-c1-measured",
                      "echo-c4-warmup",
                      "echo-c4-measured"
                    ]
                  },
                  "kind": {
                    "enum": [
                      "first",
                      "warmup",
                      "measured"
                    ]
                  },
                  "offers": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 128
                  },
                  "concurrency": {
                    "enum": [
                      1,
                      4
                    ]
                  },
                  "function": {
                    "enum": [
                      "echo",
                      "compute"
                    ]
                  },
                  "payload": {
                    "enum": [
                      [
                        "optimization-reference-v1"
                      ],
                      [
                        17,
                        10000
                      ]
                    ]
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "density": {
                    "const": 1
                  }
                }
              },
              "then": {
                "properties": {
                  "phases": {
                    "minItems": 9,
                    "maxItems": 9
                  }
                }
              },
              "else": {
                "properties": {
                  "phases": {
                    "minItems": 3,
                    "maxItems": 3
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "smoke"
          }
        }
      },
      "then": {
        "properties": {
          "profile": {
            "const": "smoke"
          },
          "repetitions": {
            "const": 1
          },
          "logical_offers": {
            "const": "300"
          },
          "client_owners": {
            "const": 1
          },
          "measured_lsf_starts": {
            "const": 3
          },
          "measured_native_starts": {
            "const": 41
          },
          "measured_lsf_inventory_rpcs": {
            "const": 9
          },
          "client_commands": {
            "const": 61
          },
          "groups": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "full"
          }
        }
      },
      "then": {
        "properties": {
          "profile": {
            "const": "full"
          },
          "repetitions": {
            "const": 7
          },
          "logical_offers": {
            "const": "9926"
          },
          "client_owners": {
            "const": 7
          },
          "measured_lsf_starts": {
            "const": 21
          },
          "measured_native_starts": {
            "const": 287
          },
          "measured_lsf_inventory_rpcs": {
            "const": 63
          },
          "client_commands": {
            "const": 427
          },
          "groups": {
            "minItems": 7,
            "maxItems": 7
          }
        }
      }
    }
  ]
}
