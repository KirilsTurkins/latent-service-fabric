{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/benchmarks/docker-builds.v1.schema.json",
  "title": "Docker comparison builds v1",
  "$comment": "Private completed-evidence shape. Exact bytes, strict numeric types, ownership, control order, semantic responses, clocks, source bindings and aggregate equality require offline replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "source_after",
    "source_path",
    "target_path",
    "build",
    "inputs",
    "executables",
    "component",
    "fixtures",
    "command",
    "process",
    "log"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.docker-builds.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "clean",
        "cargo_lock_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "clean": {
          "const": true
        },
        "cargo_lock_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "source_after": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "clean",
        "cargo_lock_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "clean": {
          "const": true
        },
        "cargo_lock_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "target_path": {
      "const": "/workspace/project/target"
    },
    "build": {
      "type": "object",
      "maxProperties": 512,
      "$comment": "The existing semantic replay validates this nested receipt and its referenced bytes."
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3500,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "executables": {
      "type": "object",
