            "bytes": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "fixtures": {
      "type": "object",
      "maxProperties": 512,
      "$comment": "The existing semantic replay validates this nested receipt and its referenced bytes."
    },
    "command": {
      "const": [
        "/bin/bash",
        "tools/build_optimization_bench.sh",
        "full"
      ]
    },
    "process": {
      "type": "object",
      "maxProperties": 512,
      "required": [
