              "minLength": 1,
              "maxLength": 4096
            },
            "bytes": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
