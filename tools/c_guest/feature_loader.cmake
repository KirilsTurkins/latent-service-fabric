# Verify the captured SDK kit, then append only its verified probe object.
foreach(_lsf_required LSF_C_FEATURE_PROJECT LSF_C_FEATURE_KIT LSF_C_FEATURE_EXPECT LSF_C_FEATURE_PYTHON CMAKE_C_COMPILER)
  if(NOT DEFINED ${_lsf_required} OR "${${_lsf_required}}" STREQUAL "")
    message(FATAL_ERROR "Missing LSF C feature verification input: ${_lsf_required}")
  endif()
endforeach()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "WASI" OR NOT CMAKE_C_COMPILER_ARG1 STREQUAL "cc" OR
   NOT CMAKE_C_COMPILER_TARGET STREQUAL "wasm32-wasi")
  message(FATAL_ERROR "LSF C feature probes require the captured Zig wasm32-wasi compiler")
endif()
get_filename_component(_lsf_tools "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
execute_process(
  COMMAND "${LSF_C_FEATURE_PYTHON}" -I -B "${_lsf_tools}/c_capsule.py" feature-probes-verify
          "${LSF_C_FEATURE_PROJECT}" --kit "${LSF_C_FEATURE_KIT}"
          --expect "${LSF_C_FEATURE_EXPECT}" --zig "${CMAKE_C_COMPILER}"
  RESULT_VARIABLE _lsf_status OUTPUT_VARIABLE _lsf_output ERROR_VARIABLE _lsf_error
  OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 120)
if(NOT _lsf_status STREQUAL "0")
  message(FATAL_ERROR "LSF C feature verification failed (${_lsf_status}): ${_lsf_error}")
endif()
if(NOT _lsf_output STREQUAL "not-selected")
  string(LENGTH "${_lsf_output}" _lsf_length)
  if(NOT _lsf_length EQUAL 71 OR NOT _lsf_output MATCHES "^sha256:[0-9a-f]+$")
    message(FATAL_ERROR "LSF C feature verifier returned an invalid result")
  endif()
  set(_lsf_object "${LSF_C_FEATURE_KIT}/numeric-resolver.o")
  file(SHA256 "${_lsf_object}" _lsf_object_digest)
  if(NOT "sha256:${_lsf_object_digest}" STREQUAL "${_lsf_output}")
    message(FATAL_ERROR "LSF C feature probe object changed")
  endif()
  list(APPEND CMAKE_REQUIRED_LIBRARIES "${_lsf_object}")
  unset(_lsf_object)
  unset(_lsf_object_digest)
  unset(_lsf_length)
endif()
# The socket check must link the real captured SDK source.  The declaration
# maps the ordinary C spelling to its actual SDK symbol without a macro, so
# check_symbol_exists cannot succeed by taking its preprocessor-only branch.
file(SHA256 "${LSF_C_FEATURE_KIT}/feature-probes.json" _lsf_receipt_digest)
if(NOT "sha256:${_lsf_receipt_digest}" STREQUAL "${LSF_C_FEATURE_EXPECT}")
  message(FATAL_ERROR "LSF C feature receipt changed")
endif()
file(READ "${LSF_C_FEATURE_KIT}/feature-probes.json" _lsf_receipt LIMIT 65536)
string(JSON _lsf_socket_type TYPE "${_lsf_receipt}" socketProbe)
if(_lsf_socket_type STREQUAL "OBJECT")
  string(JSON _lsf_profile GET "${_lsf_receipt}" profile)
  string(JSON _lsf_binding_digest GET "${_lsf_receipt}" socketProbe binding digest)
  string(JSON _lsf_declaration_digest GET "${_lsf_receipt}" socketProbe declaration digest)
  set(_lsf_binding_dir "${LSF_C_FEATURE_KIT}/socket-bindings")
  set(_lsf_declaration "${LSF_C_FEATURE_KIT}/socket-probe.h")
  set(_lsf_sdk "${LSF_C_FEATURE_PROJECT}/vendor/lsf/sdk/c-guest")
  file(SHA256 "${_lsf_binding_dir}/probe.h" _lsf_binding_actual)
  file(SHA256 "${_lsf_declaration}" _lsf_declaration_actual)
  if(NOT "sha256:${_lsf_binding_actual}" STREQUAL "${_lsf_binding_digest}" OR
     NOT "sha256:${_lsf_declaration_actual}" STREQUAL "${_lsf_declaration_digest}")
    message(FATAL_ERROR "LSF C socket feature inputs changed")
  endif()
  string(APPEND CMAKE_REQUIRED_FLAGS
    " -I\"${_lsf_binding_dir}\" -I\"${_lsf_sdk}/include\" -include \"${_lsf_declaration}\""
    " -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -DLSF_C_STREAM_NETWORK=1"
    " -matomics -mbulk-memory -pthread -fno-lto")
  if(_lsf_profile STREQUAL "c-stream-clock-entropy-stdio-v1")
    string(APPEND CMAKE_REQUIRED_FLAGS " -DLSF_C_STREAM_STDIO=1")
  endif()
  list(APPEND CMAKE_REQUIRED_LIBRARIES "${_lsf_sdk}/src/standard-streams.c")
elseif(NOT _lsf_socket_type STREQUAL "NULL")
  message(FATAL_ERROR "LSF C socket feature receipt is invalid")
endif()
unset(_lsf_receipt_digest)
unset(_lsf_receipt)
unset(_lsf_socket_type)
unset(_lsf_profile)
unset(_lsf_binding_digest)
unset(_lsf_declaration_digest)
unset(_lsf_binding_dir)
unset(_lsf_declaration)
unset(_lsf_sdk)
unset(_lsf_binding_actual)
unset(_lsf_declaration_actual)
unset(_lsf_tools)
unset(_lsf_status)
unset(_lsf_output)
unset(_lsf_error)
unset(_lsf_required)
