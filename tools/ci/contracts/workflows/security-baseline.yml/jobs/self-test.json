{"definition":{"if":"needs.scope.outputs.selftest == 'true'","name":"Security fail-closed canaries","needs":"scope","runs-on":"ubuntu-24.04","steps":[{"uses":"KirilsTurkins/lsf-checkout","with":{"persist-credentials":false}},{"uses":"KirilsTurkins/lsf-setup-python","with":{"python-version":"3.13.5"}},{"name":"Install only the reviewed parser wheel","run":"python3 -m pip install --only-binary=:all: --no-deps --require-hashes --requirement .github/security/requirements.txt\n"},{"name":"Test expiry, unknown data, fork permissions, docs profiles and the aggregate","run":"python3 -m unittest discover -s tools/tests -p 'test_security*.py'"},{"env":{"GH_TOKEN":"${{ github.event_name == 'push' && github.ref == 'refs/heads/development' && github.token || '' }}"},"name":"Install reviewed cargo-audit canary scanner","run":"python3 tools/security_install.py --tool cargo-audit --destination \"$RUNNER_TEMP/security-tools\""},{"name":"Install reviewed gitleaks canary scanner","run":"python3 tools/security_install.py --tool gitleaks --destination \"$RUNNER_TEMP/security-tools\""},{"env":{"GH_TOKEN":"${{ github.event_name == 'push' && github.ref == 'refs/heads/development' && github.token || '' }}"},"name":"Install reviewed zizmor canary scanner","run":"python3 tools/security_install.py --tool zizmor --destination \"$RUNNER_TEMP/security-tools\""},{"name":"Prove harmless real-scanner pass and fail behavior","run":"python3 tools/security_selftest.py --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-canaries\""}],"timeout-minutes":8},"jobId":"self-test","kind":"job","reviewReason":"Use the existing development-push-only credential boundary for the exact pinned cargo-audit fallback; preserve all canary scanners.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/security-baseline.yml"}
