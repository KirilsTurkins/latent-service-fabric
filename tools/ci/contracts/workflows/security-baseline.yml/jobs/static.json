  "definition": {
    "name": "Source and workflow rules ${{ matrix.ref }}",
    "needs": "scope",
    "if": "needs.scope.outputs.static == 'true'",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 6,
    "strategy": {
      "fail-fast": false,
      "matrix": "${{ fromJSON(needs.scope.outputs.matrix) }}"
    },
    "steps": [
      {
        "name": "Check out scanner controls",
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "path": "controls",
          "persist-credentials": false
        }
      },
      {
        "name": "Check out scan input",
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "ref": "${{ matrix.ref }}",
          "path": "source",
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install only the reviewed parser wheel",
        "run": "python3 -m pip install --only-binary=:all: --no-deps --require-hashes --requirement controls/.github/security/requirements.txt\n"
      },
      {
        "name": "Install digest-pinned offline workflow scanner",
        "run": "python3 controls/tools/security_install.py --tool zizmor --destination \"$RUNNER_TEMP/security-tools\""
      },
      {
        "name": "Apply reviewed source, workflow and action-pin rules",
        "run": "python3 controls/tools/security_scan.py static --repo source --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-scan\""
      }
    ]
  },
  "jobId": "static",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/security-baseline.yml"
}
