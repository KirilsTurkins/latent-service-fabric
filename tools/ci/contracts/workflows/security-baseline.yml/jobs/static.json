{"definition":{"if":"needs.scope.outputs.static == 'true'","name":"Source and workflow rules ${{ matrix.ref }}","needs":"scope","runs-on":"ubuntu-24.04","steps":[{"name":"Check out scanner controls","uses":"KirilsTurkins/lsf-checkout","with":{"path":"controls","persist-credentials":false}},{"name":"Check out scan input","uses":"KirilsTurkins/lsf-checkout","with":{"path":"source","persist-credentials":false,"ref":"${{ matrix.ref }}"}},{"uses":"KirilsTurkins/lsf-setup-python","with":{"python-version":"3.13.5"}},{"name":"Install only the reviewed parser wheel","run":"python3 -m pip install --only-binary=:all: --no-deps --require-hashes --requirement controls/.github/security/requirements.txt\n"},{"env":{"GH_TOKEN":"${{ github.event_name == 'push' && github.ref == 'refs/heads/development' && github.token || '' }}"},"name":"Install digest-pinned offline workflow scanner","run":"python3 controls/tools/security_install.py --tool zizmor --destination \"$RUNNER_TEMP/security-tools\""},{"name":"Apply reviewed source, workflow and action-pin rules","run":"python3 controls/tools/security_scan.py static --repo source --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-scan\""}],"strategy":{"fail-fast":false,"matrix":"${{ fromJSON(needs.scope.outputs.matrix) }}"},"timeout-minutes":6},"jobId":"static","kind":"job","reviewReason":"Scope the pinned scanner API credential to development push installation only.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/security-baseline.yml"}
