      "disposition": "unchanged",
      "reason": "The exact command and its triggering conditions are retained."
    }
  },
  "definition": {
    "name": "Redacted secrets ${{ matrix.ref }}",
    "needs": "scope",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 6,
    "strategy": {
      "fail-fast": false,
      "matrix": "${{ fromJSON(needs.scope.outputs.matrix) }}"
    },
    "steps": [
      {
        "name": "Check out scanner controls",
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "path": "controls",
          "persist-credentials": false
        }
      },
      {
        "name": "Check out scan input including documentation and SVGs",
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "ref": "${{ matrix.ref }}",
          "path": "source",
          "fetch-depth": 2,
          "persist-credentials": false
        }
      },
      {
        "name": "Install digest-pinned Gitleaks without shared caches",
        "run": "python3 controls/tools/security_install.py --tool gitleaks --destination \"$RUNNER_TEMP/security-tools\""
      },
      {
        "name": "Scan tracked text with no source findings in logs or artifacts",
        "env": {
          "SECURITY_BASE": "${{ github.event.pull_request.base.sha || github.event.before || '' }}"
        },
        "run": "python3 controls/tools/security_scan.py secrets --repo source --base \"$SECURITY_BASE\" --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-scan\""
      }
    ]
  },
  "jobId": "secrets",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/security-baseline.yml"
}
