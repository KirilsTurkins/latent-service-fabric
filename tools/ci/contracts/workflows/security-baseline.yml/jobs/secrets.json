      "name": "Scan tracked text with no source findings in logs or artifacts",
      "run": "python3 controls/tools/security_scan.py secrets --repo source --base \"$SECURITY_BASE\" --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-scan\"",
