{"definition":{"name":"Redacted secrets ${{ matrix.ref }}","needs":"scope","runs-on":"ubuntu-24.04","steps":[{"name":"Check out scanner controls","uses":"KirilsTurkins/lsf-checkout","with":{"path":"controls","persist-credentials":false}},{"name":"Check out scan input including documentation and SVGs","uses":"KirilsTurkins/lsf-checkout","with":{"fetch-depth":2,"path":"source","persist-credentials":false,"ref":"${{ matrix.ref }}"}},{"name":"Install digest-pinned Gitleaks without shared caches","run":"python3 controls/tools/security_install.py --tool gitleaks --destination \"$RUNNER_TEMP/security-tools\""},{"env":{"SECURITY_BASE":"${{ github.event.pull_request.base.sha || github.event.before || '' }}"},"name":"Scan tracked text with no source findings in logs or artifacts","run":"python3 controls/tools/security_scan.py secrets --repo source --base \"$SECURITY_BASE\" --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-scan\""}],"strategy":{"fail-fast":false,"matrix":"${{ fromJSON(needs.scope.outputs.matrix) }}"},"timeout-minutes":6},"jobId":"secrets","kind":"job","reviewReason":"Lossless sharding of the reviewed v1 inventory; owner fingerprints remain enforced.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/security-baseline.yml"}
