{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {
    ".github/workflows/security-baseline.yml:dependencies:Inventory all manifests and query current OSV data without builds or installs": {
      "job": "dependencies",
      "jobIf": "needs.scope.outputs.dependencies == 'true'",
      "name": "Inventory all manifests and query current OSV data without builds or installs",
      "run": "python3 controls/tools/security_scan.py dependencies --repo source --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-scan\"",
      "shell": "default",
      "stepIf": "success()",
      "workflow": ".github/workflows/security-baseline.yml",
      "workingDirectory": "."
    }
  },
  "coverage": {
    ".github/workflows/security-baseline.yml:dependencies:Inventory all manifests and query current OSV data without builds or installs": {
      "after": ".github/workflows/security-baseline.yml:dependencies:Inventory all manifests and query current OSV data without builds or installs",
      "disposition": "unchanged",
      "reason": "The exact command and its triggering conditions are retained."
    }
  },
  "definition": {
    "name": "SDK advisories ${{ matrix.ref }}",
    "needs": "scope",
    "if": "needs.scope.outputs.dependencies == 'true'",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 7,
    "strategy": {
      "fail-fast": false,
      "matrix": "${{ fromJSON(needs.scope.outputs.matrix) }}"
    },
    "steps": [
      {
        "name": "Check out scanner controls",
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "path": "controls",
          "persist-credentials": false
        }
      },
      {
        "name": "Check out scan input",
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "ref": "${{ matrix.ref }}",
          "path": "source",
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-node",
        "with": {
          "node-version": "24.19.0",
          "package-manager-cache": false
        }
      },
      {
        "name": "Inventory all manifests and query current OSV data without builds or installs",
        "run": "python3 controls/tools/security_scan.py dependencies --repo source --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-scan\""
      }
    ]
  },
  "jobId": "dependencies",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/security-baseline.yml"
}
