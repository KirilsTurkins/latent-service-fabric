{"definition":{"if":"needs.scope.outputs.dependencies == 'true'","name":"SDK advisories ${{ matrix.ref }}","needs":"scope","runs-on":"ubuntu-24.04","steps":[{"name":"Check out scanner controls","uses":"KirilsTurkins/lsf-checkout","with":{"path":"controls","persist-credentials":false}},{"name":"Check out scan input","uses":"KirilsTurkins/lsf-checkout","with":{"path":"source","persist-credentials":false,"ref":"${{ matrix.ref }}"}},{"uses":"KirilsTurkins/lsf-setup-node","with":{"node-version":"24.19.0","package-manager-cache":false}},{"name":"Inventory all manifests and query current OSV data without builds or installs","run":"python3 controls/tools/security_scan.py dependencies --repo source --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-scan\""}],"strategy":{"fail-fast":false,"matrix":"${{ fromJSON(needs.scope.outputs.matrix) }}"},"timeout-minutes":7},"jobId":"dependencies","kind":"job","reviewReason":"Query dependency advisories without an automatic package-manager cache; retain every scan and manifest check.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/security-baseline.yml"}
