{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Cache sample (${{ inputs.kind }} / ${{ inputs.state }})",
    "if": "github.event_name == 'push' && github.ref == 'refs/heads/development'",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 120,
    "env": {
      "RUSTUP_TOOLCHAIN": "1.97.1",
      "LSF_REQUIRE_NATIVE_PROCESS_TESTS": "1",
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "${{ inputs.kind == 'recipe' && '1' || '0' }}",
      "CARGO_PROFILE_TEST_DEBUG": "${{ inputs.kind == 'recipe' && '1' || '0' }}",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install pinned prerequisites",
        "run": "python3 -m pip install --requirement tools/requirements.lock\nsudo apt-get update\nsudo apt-get install --no-install-recommends --yes fish\n"
      },
      {
        "uses": "dtolnay/rust-toolchain",
        "with": {
          "components": "rustfmt, clippy",
          "targets": "wasm32-wasip2,wasm32-unknown-unknown"
        }
      },
      {
        "name": "Identify isolated experimental namespace",
        "id": "identity",
        "env": {
          "KIND": "${{ inputs.kind }}",
          "EXPERIMENT": "${{ inputs.experiment }}"
        },
        "run": "python3 tools/ci_cargo_service.py identity --kind \"$KIND\" --experiment \"$EXPERIMENT\" --output \"$RUNNER_TEMP/cargo-service/identity.json\" --github-output \"$GITHUB_OUTPUT\""
      },
      {
        "name": "Restore dependency cache",
        "id": "dependencies",
        "uses": "KirilsTurkins/lsf-rust-cache",
        "with": {
          "prefix-key": "${{ steps.identity.outputs.prefix }}",
          "shared-key": "host-correctness",
          "key": "ubuntu-24.04",
          "cache-provider": "github",
          "cache-targets": true,
          "cache-bin": false,
          "cache-workspace-crates": false,
          "cache-all-crates": false,
          "cache-on-failure": false,
          "save-if": "${{ github.event_name == 'push' && github.ref == 'refs/heads/development' && inputs.state == 'cold' }}"
        }
      },
      {
        "name": "Execute every reviewed Cargo invocation",
        "env": {
          "CONFIGURATION": "${{ steps.identity.outputs.configuration }}",
          "SAMPLE_STATE": "${{ inputs.state }}",
          "CACHE_HIT": "${{ steps.dependencies.outputs.cache-hit || 'false' }}"
        },
        "run": "python3 tools/ci_cargo_evaluate.py --disposable-checkout --configuration \"$CONFIGURATION\" --service-state \"$SAMPLE_STATE\" --service-hit \"$CACHE_HIT\" --output \"$RUNNER_TEMP/cargo-service/recipes\""
      },
      {
        "name": "Seal completed single sample",
        "run": "python3 tools/ci_cargo_service.py sample-report --identity \"$RUNNER_TEMP/cargo-service/identity.json\" --evaluation \"$RUNNER_TEMP/cargo-service/recipes/evaluation.json\" --output \"$RUNNER_TEMP/cargo-service/service-sample.json\""
      },
      {
        "name": "Retain original recipe observations including failed attempts",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "cargo-service-${{ inputs.kind }}-${{ inputs.state }}-recipes-${{ github.sha }}-${{ github.run_attempt }}",
          "path": "${{ runner.temp }}/cargo-service/",
          "if-no-files-found": "error",
          "retention-days": 7
        }
      },
      {
        "name": "Retain completed sample for read-only comparison",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "cargo-service-${{ inputs.kind }}-${{ inputs.state }}-sample-${{ github.sha }}-${{ github.run_attempt }}",
          "path": "${{ runner.temp }}/cargo-service/service-sample.json",
          "if-no-files-found": "error",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "sample",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/cargo-cache-service-sample.yml"
}
