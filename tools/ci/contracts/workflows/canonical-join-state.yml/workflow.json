{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "canonical-call-future-${{ github.ref }}"
    },
    "name": "Focused canonical async call-future accounting",
    "on": {
      "push": {
        "branches": [
          "feat/sdk-736-shared-owners-20261025"
        ],
        "paths": [
          ".github/workflows/canonical-join-state.yml",
          "crates/vendor/wasmtime/**",
          "crates/latent-wasmtime/src/host.rs",
          "crates/latent-wasmtime/src/host/join_state_tests.rs",
          "tools/qualify_canonical_join_state.py",
          "tools/host_codec_wasmtime.py"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "join-state"
  ],
  "reviewReason": "Reviewed concrete abortable async-import future Box preadmission and physical-drop ownership. Existing focused owner runs only four new private cases and one new actual canonical third-admission/fresh-Store case under unchanged two-build/45m/2400s/900s/60s/two-job bounds. No old case, skip or authority is removed.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/canonical-join-state.yml"
}
