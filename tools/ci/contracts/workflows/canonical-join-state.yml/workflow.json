{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "canonical-join-state-${{ github.ref }}"
    },
    "name": "Focused canonical async JoinState accounting",
    "on": {
      "push": {
        "branches": [
          "feat/canonical-join-state-accounting-20261025"
        ],
        "paths": [
          ".github/workflows/canonical-join-state.yml",
          "crates/vendor/wasmtime/**",
          "crates/latent-wasmtime/src/host.rs",
          "crates/latent-wasmtime/src/host/join_state_tests.rs",
          "tools/qualify_canonical_join_state.py",
          "tools/host_codec_wasmtime.py"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "join-state"
  ],
  "reviewReason": "Closed branch-only canonical JoinState accounting owner; two locked host targets and exactly five private plus one actual canonical control, with unchanged limits and no generic suite.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/canonical-join-state.yml"
}
