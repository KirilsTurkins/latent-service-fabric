{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "rust-wac-threading-${{ github.ref }}"
    },
    "name": "Retained Rust ThreadPool WAC parser comparison",
    "on": {
      "push": {
        "branches": [
          "diag/rust-wac-threading-20261104",
          "diag/rust-wac-threading-fix-20261104"
        ],
        "paths": [
          ".github/workflows/rust-wac-threading-probe.yml",
          "tools/diagnose_rust_wac_threading.py",
          "tools/tests/test_rust_wac_threading_probe.py"
        ]
      }
    },
    "permissions": {
      "actions": "read",
      "contents": "read"
    }
  },
  "requiredJobs": [
    "compare"
  ],
  "reviewReason": "Run a bounded comparison of the retained original preview on the exact old and diagnostic parser.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-wac-threading-probe.yml"
}
