{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Rust recipes (${{ matrix.configuration }})",
    "if": "inputs.run_full_recipes",
    "strategy": {
      "fail-fast": false,
      "max-parallel": 2,
      "matrix": {
        "configuration": [
          "current",
          "ci-correctness"
        ]
      }
    },
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 120,
    "env": {
      "RUSTUP_TOOLCHAIN": "1.97.1",
      "LSF_REQUIRE_NATIVE_PROCESS_TESTS": "1"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "name": "Initialize recipe attempt diagnostics",
        "run": "mkdir -p \"$RUNNER_TEMP/cargo-full-evaluation\"\ngit rev-parse HEAD > \"$RUNNER_TEMP/cargo-full-evaluation/revision.txt\"\n"
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install pinned recipe prerequisites",
        "run": "python3 -m pip install --requirement tools/requirements.lock\nsudo apt-get update\nsudo apt-get install --no-install-recommends --yes fish\n"
      },
      {
        "uses": "dtolnay/rust-toolchain",
        "with": {
          "components": "rustfmt, clippy",
          "targets": "wasm32-wasip2,wasm32-unknown-unknown"
        }
      },
      {
        "name": "Replay the exact reviewed Rust recipes and revalidate every handoff",
        "env": {
          "CONFIGURATION": "${{ matrix.configuration }}"
        },
        "run": "python3 tools/ci_cargo_evaluate.py --disposable-checkout --configuration \"$CONFIGURATION\" --output \"$RUNNER_TEMP/cargo-full-evaluation/recipes\""
      },
      {
        "name": "Retain full recipe observations including failed attempts",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "cargo-full-evaluation-${{ matrix.configuration }}-${{ github.sha }}-${{ github.run_attempt }}",
          "path": "${{ runner.temp }}/cargo-full-evaluation/",
          "if-no-files-found": "error",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "recipes",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/cargo-recipe-evaluation.yml"
}
