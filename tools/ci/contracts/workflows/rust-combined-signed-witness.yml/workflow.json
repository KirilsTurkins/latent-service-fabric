{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "rust-combined-signed-witness-${{ github.ref }}"
    },
    "name": "Rust combined HTTP signed sibling diagnostic",
    "on": {
      "push": {
        "branches": [
          "diag/rust-http-combined-signed-20261105"
        ],
        "paths": [
          ".github/workflows/rust-combined-signed-witness.yml",
          ".cargo/**",
          "Cargo.toml",
          "Cargo.lock",
          "rust-toolchain.toml",
          "crates/**",
          "apps/**",
          "sdk/rust/**",
          "tools/**",
          "wit/**",
          "schemas/**",
          "api/proto/**",
          "examples/echo-contract/**"
        ]
      }
    },
    "permissions": {
      "actions": "read",
      "contents": "read"
    }
  },
  "requiredJobs": [
    "signed-witness"
  ],
  "reviewReason": "Include the native source and retained-witness controller inputs in the branch-only owner trigger.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-combined-signed-witness.yml"
}
