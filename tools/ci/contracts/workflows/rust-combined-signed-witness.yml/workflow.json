      "group": "rust-combined-signed-witness-${{ github.ref }}"
    },
    "name": "Rust combined HTTP signed sibling diagnostic",
    "on": {
      "push": {
        "branches": [
          "diag/rust-http-combined-signed-20261105"
        ],
        "paths": [
          ".github/workflows/rust-combined-signed-witness.yml",
          "tools/rust_thread_http_combined_*.py",
          "tools/rust_combined_http_materials.py",
          "tools/qualify_rust_thread_http_combined.py",
