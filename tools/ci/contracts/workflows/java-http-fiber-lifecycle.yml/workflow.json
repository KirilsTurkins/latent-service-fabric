{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "java-http-fiber-lifecycle-${{ github.ref }}"
    },
    "name": "Focused Java HTTP fiber lifecycle",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/java-guest/**",
          "examples/java-http-fiber-lifecycle/**",
          "tools/java_http_fiber_node.py",
          "tools/qualify_java_http_fibers.py",
          "tools/java_replay_materials.py",
          "tools/java_fiber_native_products.py",
          "tools/java_http_refusal_diagnostic.py",
          "tools/phase2_operator_scenario.py",
          "tools/java_standard_http*.py",
          "tools/java_capsule*.py",
          "tools/java_guest/**",
          "tools/standard_http/**",
          "tools/tests/test_java_http_fibers.py",
          "tools/java_http_phase_fixture.py",
          "tools/java_http_phase_node.py",
          "tools/java_phase_native_products.py",
          "tools/http_phase_native_products.py",
          "tools/http_tenant_native_products.py",
          "tools/java_http_tenant_node.py",
          "tools/tests/test_http_tenant_native_products.py",
          "tools/tests/test_java_http_tenants.py",
          "tools/qualify_java_http_phases.py",
          "tools/fixtures/java-http-phases/**",
          "tools/tests/test_java_http_phase_campaign.py",
          "tools/tests/test_java_phase_native_products.py",
          "tools/tests/test_http_phase_native_products.py",
          "tools/tests/test_java_http_phases.py",
          "tools/tests/test_java_timeout_exception.py",
          ".github/workflows/java-http-fiber-lifecycle.yml"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "java_http_fibers": {
            "default": false,
            "description": "Fresh ordinary Java HTTP/fiber component with authenticated native products",
            "type": "boolean"
          },
          "java_http_phases": {
            "default": false,
            "description": "Fresh ordinary default clients and explicit V7 phase deadlines",
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "http-fiber-lifecycle",
    "http-phase-clients"
  ],
  "reviewReason": "Retain every original Java fibre/default/tenant command, guard and deadline; add exact successful8f source fetch before helper controls and three standard SocketTimeoutException identity/source controls. Version only authenticated tuple/mandatory stages; no legacy grant.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/java-http-fiber-lifecycle.yml"
}
