{"definition":{"if":"${{ needs.tooling-selection.outputs.reason != 'isolated-tooling:documentation-validator-tests' && (github.event_name != 'workflow_dispatch' || !inputs.replay-scratch-refusals) }}","name":"Native Cargo Git capture and offline metadata","needs":"tooling-selection","runs-on":"ubuntu-24.04","steps":[{"uses":"KirilsTurkins/lsf-checkout","with":{"persist-credentials":false}},{"uses":"KirilsTurkins/lsf-setup-python","with":{"python-version":"3.13.5"}},{"uses":"dtolnay/rust-toolchain"},{"name":"Install pinned validation dependencies","run":"python3 -m pip install --requirement tools/requirements.lock"},{"name":"Test Git offline command and closure refusal controls","run":"python3 -m unittest tools.tests.test_rust_git_conformance"},{"name":"Capture two exact Git revisions and verify fresh-home offline metadata","run":"python3 tools/qualify_rust_git_dependencies.py --cargo \"$(rustup which --toolchain 1.97.1 cargo)\" --output \"$RUNNER_TEMP/rust-git-closure\"\n"},{"if":"always()","name":"Retain source and offline Git observations including failures","uses":"KirilsTurkins/lsf-upload-artifact","with":{"if-no-files-found":"warn","name":"rust-git-closure-${{ github.sha }}","path":"${{ runner.temp }}/rust-git-closure/qualification.json\n${{ runner.temp }}/rust-git-closure/FAILED.json\n${{ runner.temp }}/rust-git-closure/phase-*.json\n","retention-days":3}}],"timeout-minutes":20},"jobId":"git-closure","kind":"job","reviewReason":"Select affected tooling while preserving existing native qualification commands","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/rust-capsule-authoring.yml"}
