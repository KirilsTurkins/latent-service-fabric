{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "rust-capsule-authoring-${{ github.ref }}"
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "Rust capsule authoring",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/rust-capsule-authoring.yml",
          "sdk/rust-guest/**",
          "sdk/rust-standard-runtime/**",
          "sdk/transaction-contract/**",
          "crates/**",
          "apps/**",
          "examples/**",
          "schemas/**",
          "tools/**",
          "wit/**",
          "Cargo.*",
          "docs/component-development/rust-authoring.md"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/rust-capsule-authoring.yml",
          "sdk/rust-guest/**",
          "sdk/rust-standard-runtime/**",
          "sdk/transaction-contract/**",
          "crates/**",
          "apps/**",
          "examples/**",
          "schemas/**",
          "tools/**",
          "wit/**",
          "Cargo.*",
          "docs/component-development/rust-authoring.md"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "authoring",
    "standard-clocks"
  ],
  "reviewReason": "Add authenticated rebuilt ordinary SystemTime/Instant signed grant, two fresh Store, revocation and owner-retirement gate; preserve existing authoring commands, source controls, jobs, limits, cache policy and historical CI obligations.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-capsule-authoring.yml"
}
