{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "rust-capsule-authoring-${{ github.ref }}"
    },
    "name": "Rust capsule authoring",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/rust-capsule-authoring.yml",
          "sdk/rust-guest/**",
          "sdk/transaction-contract/**",
          "crates/**",
          "apps/**",
          "examples/**",
          "schemas/**",
          "tools/**",
          "wit/**",
          "Cargo.*",
          "docs/component-development/rust-authoring.md"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/rust-capsule-authoring.yml",
          "sdk/rust-guest/**",
          "sdk/transaction-contract/**",
          "crates/**",
          "apps/**",
          "examples/**",
          "schemas/**",
          "tools/**",
          "wit/**",
          "Cargo.*",
          "docs/component-development/rust-authoring.md"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "authoring"
  ],
  "reviewReason": "Build both real authored transaction variants with existing exact compiler pins and retain bounded source, recipe, binding and failure artifacts without claiming node execution",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-capsule-authoring.yml"
}
