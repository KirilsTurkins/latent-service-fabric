{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "rust-capsule-authoring-${{ github.ref }}"
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "Rust capsule authoring",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/rust-capsule-authoring.yml",
          "sdk/rust-guest/**",
          "sdk/rust-standard-runtime/**",
          "sdk/rust-standard-stdio/**",
          "sdk/transaction-contract/**",
          "crates/**",
          "apps/**",
          "examples/**",
          "schemas/**",
          "tools/**",
          "wit/**",
          "Cargo.*",
          "docs/component-development/rust-authoring.md",
          "docs/component-development/rust-dependencies.md"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/rust-capsule-authoring.yml",
          "sdk/rust-guest/**",
          "sdk/rust-standard-runtime/**",
          "sdk/rust-standard-stdio/**",
          "sdk/transaction-contract/**",
          "crates/**",
          "apps/**",
          "examples/**",
          "schemas/**",
          "tools/**",
          "wit/**",
          "Cargo.*",
          "docs/component-development/rust-authoring.md",
          "docs/component-development/rust-dependencies.md"
        ]
      },
      "workflow_dispatch": {}
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "authoring",
    "compatibility",
    "dependency-matrix",
    "git-closure",
    "git-components",
    "scratch-refusals",
    "standard-clocks",
    "standard-entropy",
    "standard-stdio"
  ],
  "reviewReason": "Add a separately bounded20-minute signed Rust scratch-refusal child using exact normal public products; preserve all original authoring commands/jobs/35-minute limit and source-only other-language scope.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-capsule-authoring.yml"
}
