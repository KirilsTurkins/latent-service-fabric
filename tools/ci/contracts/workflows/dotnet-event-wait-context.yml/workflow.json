{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "dotnet-event-wait-host-${{ github.ref }}"
    },
    "name": ".NET event wait host context",
    "on": {
      "pull_request": {
        "paths": [
          "sdk/dotnet-guest/tools/http-errors/**",
          "sdk/dotnet-guest/tests/fixtures/task-wait-finite-il-control/**",
          "sdk/dotnet-guest/probes/smoke/**",
          "sdk/dotnet-guest/global.json",
          "sdk/dotnet-guest/nuget.config",
          "tools/dotnet_guest/**",
          "tools/probe_dotnet_event_wait_context.py",
          ".github/workflows/dotnet-event-wait-context.yml"
        ]
      },
      "push": {
        "branches": [
          "feat/sdk-dotnet-manual-reset-wait-20261118"
        ],
        "paths": [
          ".github/workflows/dotnet-event-wait-context.yml"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "emitted-context"
  ],
  "reviewReason": "Add a bounded host-only pinned emitted-helper regression independent of the NativeAOT build. Preserve all signed qualification jobs; CLR success never qualifies a guest or grants authority.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/dotnet-event-wait-context.yml"
}
