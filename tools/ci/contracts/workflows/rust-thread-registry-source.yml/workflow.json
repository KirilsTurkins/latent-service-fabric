{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "rust-thread-registry-source-${{ github.ref }}"
    },
    "name": "Rust logical thread registry source controls",
    "on": {
      "push": {
        "branches": [
          "fix/rust-thread-reuse-20261109",
          "fix/rust-pool-worker-reuse-20261109",
          "fix/rust-mutex-reused-index-20261109"
        ],
        "paths": [
          ".github/workflows/rust-thread-registry-source.yml",
          "sdk/rust-standard-runtime/thread_registry.rs",
          "sdk/rust-standard-runtime/thread_runtime.rs",
          "sdk/rust-standard-runtime/tests/thread_registry_native.rs",
          "sdk/rust-standard-runtime/executor_*.rs",
          "sdk/rust-standard-runtime/tests/executor_*_native.rs",
          "sdk/rust-standard-runtime/mutex.rs",
          "sdk/rust-standard-runtime/rwlock.rs",
          "sdk/rust-standard-runtime/condvar.rs",
          "sdk/rust-standard-runtime/parker.rs",
          "sdk/rust-standard-runtime/once.rs",
          "sdk/rust-standard-runtime/thread_wait.rs",
          "sdk/rust-standard-runtime/tests/thread_sync_native.rs",
          "sdk/rust-standard-runtime/tests/mutex_reuse_cases.rs.inc"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "registry-source"
  ],
  "reviewReason": "Keep existing registry and executor source controls; select bounded mutex index-reuse controls without changing runtime or CI limits.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-thread-registry-source.yml"
}
