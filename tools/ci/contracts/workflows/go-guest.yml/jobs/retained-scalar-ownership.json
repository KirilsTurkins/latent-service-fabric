{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "if": "${{ github.event_name == 'workflow_dispatch' && inputs.qualify-entropy-retained && !inputs.replay-entropy-authority }}",
    "name": "All15 actual random provider ownership and canonical-lowering controls",
    "permissions": {
      "actions": "read",
      "contents": "read"
    },
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "actions/setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "name": "Restore only locked dependency compilation cache",
        "uses": "Swatinem/rust-cache",
        "with": {
          "cache-all-crates": false,
          "cache-bin": false,
          "cache-on-failure": false,
          "cache-targets": true,
          "cache-workspace-crates": false,
          "key": "ubuntu-24.04",
          "prefix-key": "lsf-ci-dependencies-v2",
          "save-if": false,
          "shared-key": "host-correctness"
        }
      },
      {
        "name": "Execute all original random controls plus scalar lowering and error retirement",
        "run": "cargo --config .cargo/managed-guest.toml test --locked -p latent-wasmtime --test random"
      }
    ],
    "timeout-minutes": 20
  },
  "jobId": "retained-scalar-ownership",
  "kind": "job",
  "reviewReason": "Review bounded independent CPU/native scalar/fresh entropy qualification; original commands and limits preserved; historical source distinguished from current host.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/go-guest.yml"
}
