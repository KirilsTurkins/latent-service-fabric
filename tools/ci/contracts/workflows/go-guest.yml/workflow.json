{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "go-guest-${{ github.ref }}"
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "Go guest qualification",
    "on": {
      "pull_request": {
        "paths": [
          "sdk/go-guest/**",
          "sdk/transaction-contract/**",
          "tools/qualify_transaction_contracts.py",
          "tools/go_guest/**",
          "tools/go_capsule*.py",
          "tools/go_application_dependencies.py",
          "tools/go_dependency_authoring.py",
          "tools/tests/test_go_dependency_authoring.py",
          "tools/guest_authoring_frontend.py",
          "tools/go_dependency_fixture.py",
          "tools/application_dependenc*.py",
          "tools/captured_compiler_isolation.py",
          "tools/probe_go_authoring.py",
          "tools/qualify_go_capsules.py",
          "tools/qualify_rust_capsules.py",
          "tools/*rust_capsule*.py",
          "tools/guest_runtime_grants.py",
          "tools/tests/test_go_capsule_authoring.py",
          "tools/tests/test_go_application_dependencies.py",
          "tools/tests/test_build_provenance_schemas.py",
          "schemas/**",
          "docs/component-development/go-authoring.md",
          "docs/development/go-capsule-qualification.md",
          "crates/latent-wasmtime/**",
          "crates/latent-control-store/**",
          "crates/latent-artifacts/**",
          "crates/latent-policy/**",
          "crates/latent-packaging/**",
          ".cargo/managed-guest.toml",
          "tools/build_go_guest_capsules.py",
          "apps/latentd/**",
          "crates/latent-signing/**",
          "crates/latent-wasmtime/examples/go_runtime_probe.rs",
          "wit/**",
          "tools/toolchain.toml",
          ".github/workflows/go-guest.yml"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/go-guest/**",
          "sdk/transaction-contract/**",
          "tools/qualify_transaction_contracts.py",
          "tools/go_guest/**",
          "tools/go_capsule*.py",
          "tools/go_application_dependencies.py",
          "tools/go_dependency_authoring.py",
          "tools/tests/test_go_dependency_authoring.py",
          "tools/guest_authoring_frontend.py",
          "tools/go_dependency_fixture.py",
          "tools/application_dependenc*.py",
          "tools/captured_compiler_isolation.py",
          "tools/probe_go_authoring.py",
          "tools/qualify_go_capsules.py",
          "tools/qualify_rust_capsules.py",
          "tools/*rust_capsule*.py",
          "tools/guest_runtime_grants.py",
          "tools/tests/test_go_capsule_authoring.py",
          "tools/tests/test_go_application_dependencies.py",
          "tools/tests/test_build_provenance_schemas.py",
          "schemas/**",
          "docs/component-development/go-authoring.md",
          "docs/development/go-capsule-qualification.md",
          "crates/latent-wasmtime/**",
          "crates/latent-control-store/**",
          "crates/latent-artifacts/**",
          "crates/latent-policy/**",
          "crates/latent-packaging/**",
          ".cargo/managed-guest.toml",
          "tools/build_go_guest_capsules.py",
          "apps/latentd/**",
          "crates/latent-signing/**",
          "crates/latent-wasmtime/examples/go_runtime_probe.rs",
          "wit/**",
          "tools/toolchain.toml",
          ".github/workflows/go-guest.yml"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "upstream-probe"
  ],
  "reviewReason": "Reconcile current native namespace management prerequisites with original affine state, real currentness clock and capability-session source; preserve all commands, cases, skip/decorator guards, historical mappings, matrices and deadlines. Reconcile development72dabc captured native SDK dependency/isolation prerequisites with all original Phase4 definition/authoring commands, historical mappings, guarded case declarations, matrices and deadlines retained.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/go-guest.yml"
}
