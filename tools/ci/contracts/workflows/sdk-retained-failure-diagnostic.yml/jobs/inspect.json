{
  "schemaVersion": "latent.ci.contracts.v1",
  "kind": "job",
  "reviewReason": "Authenticate exact retained failed owners and emit bounded source-bound diagnostic codes; no qualification claim.",
  "workflow": ".github/workflows/sdk-retained-failure-diagnostic.yml",
  "jobId": "inspect",
  "definition": {
    "name": "Authenticate retained Java guard failure",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 12,
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Capture and classify the exact retained failures",
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "run": "python3 -B tools/sdk_retained_failure_diagnostic.py --output \"$RUNNER_TEMP/sdk-retained-failures\""
      },
      {
        "name": "Retain bounded public summary",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "sdk-retained-failures-${{ github.sha }}",
          "retention-days": 7,
          "if-no-files-found": "warn",
          "path": "${{ runner.temp }}/sdk-retained-failures/summary.json"
        }
      }
    ]
  }
}
