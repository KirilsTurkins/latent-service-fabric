{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Real Harbor CLI authentication and package evidence",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 30,
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_PROFILE_DEV_DEBUG": "0"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-node",
        "with": {
          "node-version": "24.19.0"
        }
      },
      {
        "name": "Build the exact CLI and check owned registry guards",
        "run": "python3 -m pip install --requirement tools/requirements.lock\npython3 -m unittest tools.tests.test_harbor_registry_runner\ncargo build --locked --package latent --bin latent\n"
      },
      {
        "name": "Qualify the CLI against real Harbor",
        "run": "umask 077\npython3 tools/run_harbor_registry_tests.py --network --cli target/debug/latent --output \"$RUNNER_TEMP/harbor-cli.json\"\n"
      },
      {
        "name": "Retain sanitized registry qualification",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "harbor-cli-qualification",
          "path": "${{ runner.temp }}/harbor-cli.json",
          "if-no-files-found": "warn",
          "retention-days": 14
        }
      }
    ]
  },
  "jobId": "harbor",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/registry-cli.yml"
}
