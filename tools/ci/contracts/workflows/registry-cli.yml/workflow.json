{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "registry-cli-${{ github.event.pull_request.number || github.ref }}"
    },
    "name": "CLI registry qualification",
    "on": {
      "pull_request": {
        "paths": [
          ".github/workflows/registry-cli.yml",
          "apps/latent/src/package/**",
          "crates/latent-oci/**",
          "tools/harbor_registry/**",
          "tools/run_harbor_registry_tests.py",
          "tools/static-release/**",
          "schemas/cli-registry-profile.schema.json"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/registry-cli.yml",
          "apps/latent/src/package/**",
          "crates/latent-oci/**",
          "tools/harbor_registry/**",
          "tools/run_harbor_registry_tests.py",
          "tools/static-release/**"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "harbor"
  ],
  "reviewReason": "Lossless sharding of the reviewed v1 inventory; owner fingerprints remain enforced.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/registry-cli.yml"
}
