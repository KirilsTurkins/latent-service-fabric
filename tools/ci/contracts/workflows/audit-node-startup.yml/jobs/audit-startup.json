{"baselineRevision":"50f003dd006e0786494936c49e55dc683cf26fd6","before":{},"coverage":{},"definition":{"env":{"CARGO_BUILD_JOBS":"2","CARGO_INCREMENTAL":"0","PYTHONDONTWRITEBYTECODE":"1"},"name":"Original node startup and five finite audit boundaries","runs-on":"ubuntu-24.04","steps":[{"uses":"KirilsTurkins/lsf-checkout","with":{"persist-credentials":false}},{"uses":"KirilsTurkins/lsf-setup-python","with":{"python-version":"3.13.5"}},{"uses":"dtolnay/rust-toolchain"},{"uses":"KirilsTurkins/lsf-rust-cache","with":{"cache-all-crates":false,"cache-bin":false,"cache-on-failure":false,"cache-targets":true,"cache-workspace-crates":false,"key":"ubuntu-24.04","prefix-key":"lsf-ci-dependencies-v2","save-if":false,"shared-key":"host-correctness"}},{"name":"Install locked Python dependencies","run":"python3 -m pip install -r tools/requirements.lock"},{"name":"Refuse altered controls or discarded prebuild failures","run":"python3 -B -m unittest tools.tests.test_audit_node_startup -v"},{"name":"Build only current CLI and node and observe finite startup boundaries","run":"python3 -B tools/qualify_audit_node_startup.py --source-commit \"${{ github.sha }}\" --output \"$RUNNER_TEMP/audit-node-startup\""},{"if":"always()","name":"Retain exact source inputs and bounded actual compiler/control failures","uses":"KirilsTurkins/lsf-upload-artifact","with":{"if-no-files-found":"error","name":"audit-node-startup-${{ github.sha }}","path":"${{ runner.temp }}/audit-node-startup/","retention-days":7}}],"timeout-minutes":25},"jobId":"audit-startup","kind":"job","reviewReason":"One exact original-bank libcontrol list/run plus one currentCLI/node build and five actual startup boundaries; retain bounded startup stderr without guest/std/193 rebuild.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/audit-node-startup.yml"}
