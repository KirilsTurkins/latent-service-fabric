{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "audit-node-startup-${{ github.ref }}"
    },
    "name": "Connected Audit original node startup",
    "on": {
      "push": {
        "branches": [
          "feat/audit-owner-memory-20261023"
        ],
        "paths": [
          ".github/workflows/audit-node-startup.yml"
        ]
      },
      "workflow_dispatch": {}
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "audit-startup"
  ],
  "reviewReason": "Observe original shared8MiB node-bank startup at reduced and default journal policies and exact oversized prebirth refusal; build only current CLI/node once for retained reuse.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/audit-node-startup.yml"
}
