{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Reconcile completed cache service observations",
    "if": "always()",
    "needs": [
      "cold",
      "warm-1",
      "warm-2"
    ],
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 10,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-download-artifact",
        "with": {
          "pattern": "cargo-service-*-sample-${{ github.sha }}-${{ github.run_attempt }}",
          "path": "${{ runner.temp }}/cargo-service-samples/"
        }
      },
      {
        "name": "Require complete jobs, actual cache bytes and equivalent suites",
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "run": "python3 tools/ci_cargo_service.py collect --reports \"$RUNNER_TEMP/cargo-service-samples\" --output \"$RUNNER_TEMP/cargo-service-comparison/comparison.json\""
      },
      {
        "name": "Retain measured comparison and failed reconciliation inputs",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "cargo-service-comparison-${{ github.sha }}-${{ github.run_attempt }}",
          "path": "${{ runner.temp }}/cargo-service-comparison/\n${{ runner.temp }}/cargo-service-samples/\n",
          "if-no-files-found": "error",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "report",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/cargo-cache-service-evaluation.yml"
}
