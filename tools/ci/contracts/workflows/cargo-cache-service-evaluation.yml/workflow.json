{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "cargo-cache-service-${{ github.sha }}-${{ github.run_attempt }}"
    },
    "name": "Cargo cache service evaluation",
    "on": {
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/cargo-cache-service-evaluation.yml",
          ".github/workflows/cargo-cache-service-sample.yml"
        ]
      }
    },
    "permissions": {
      "actions": "read",
      "contents": "read"
    }
  },
  "requiredJobs": [
    "cold",
    "report",
    "warm-1",
    "warm-2"
  ],
  "reviewReason": "PR729: add isolated development-push cache-service cold and repeated-warm observations; retain every existing recipe, workflow obligation, case and guard; close exporter files before atomic replacement on Windows.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/cargo-cache-service-evaluation.yml"
}
