{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "name": "Original and corrected pinned JVM compiler control",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-java",
        "with": {
          "distribution": "temurin",
          "java-version": "25.0.4+101.0.LTS"
        }
      },
      {
        "name": "One JVM-only compiler probe without guest or native compilation",
        "run": "python3 -m pip install --requirement tools/requirements.lock\npython3 -B tools/qualify_java_checkpoint_context.py --output \"$RUNNER_TEMP/checkpoint-context\"\n"
      },
      {
        "if": "always()",
        "name": "Retain bounded original and corrected compiler observations",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "if-no-files-found": "warn",
          "name": "java-checkpoint-context-${{ github.sha }}",
          "path": "${{ runner.temp }}/checkpoint-context/result.json\n${{ runner.temp }}/checkpoint-context/commands.json\n${{ runner.temp }}/checkpoint-context/commands/logs/**\n",
          "retention-days": 3
        }
      }
    ],
    "timeout-minutes": 10
  },
  "jobId": "compiler-context",
  "kind": "job",
  "reviewReason": "Run only bounded original/corrected JVM compiler controls with immutable actions, pinned JDK and locked model artifacts.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/java-checkpoint-context.yml"
}
