{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "typescript-fetch-late-${{ github.ref }}"
    },
    "name": "TypeScript late provider completion",
    "on": {
      "push": {
        "branches": [
          "feat/typescript-late-completion-20261020"
        ],
        "paths": [
          ".github/workflows/typescript-fetch-late.yml",
          "sdk/typescript-guest/probes/fetch-late-completion/**",
          "tools/typescript_fetch_late.py",
          "tools/qualify_typescript_fetch_late.py",
          "tools/tests/test_typescript_fetch_late.py"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "fetch-conformance"
  ],
  "reviewReason": "Correct owning push selector to the actual published PR branch. Preserve exact job, commands, source controls, budgets, permissions, timeout and artifact retention. No guest/compiler/native changes.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/typescript-fetch-late.yml"
}
