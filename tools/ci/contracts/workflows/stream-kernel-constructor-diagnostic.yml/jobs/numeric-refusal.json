{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Same linked image with one bounded numeric PID1 probe",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 10,
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install existing locked recipe dependencies",
        "run": "python3 -m pip install -r tools/requirements.lock"
      },
      {
        "name": "Refuse changed failure origins or unrelated initramfs bytes",
        "run": "python3 -B -m unittest tools.tests.test_kernel_vm_numeric -v"
      },
      {
        "name": "Install only static probe compiler and isolated emulator",
        "run": "sudo apt-get update\nsudo apt-get install --yes gcc qemu-system-x86\n"
      },
      {
        "name": "Observe numeric BEGIN refusal on the unchanged linked kernel",
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "run": "python3 -B tools/diagnose_host_stream_kernel_vm.py --output \"$RUNNER_TEMP/stream-kernel-numeric\""
      },
      {
        "name": "Retain bounded numeric observations and original failure identity",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "stream-kernel-numeric-${{ github.sha }}",
          "path": "${{ runner.temp }}/stream-kernel-numeric/numeric-diagnostic.json\n${{ runner.temp }}/stream-kernel-numeric/retained-image-origin.json\n${{ runner.temp }}/stream-kernel-numeric/constructor-init.c\n${{ runner.temp }}/stream-kernel-numeric/logs/*.txt\n",
          "if-no-files-found": "error",
          "retention-days": 3
        }
      }
    ]
  },
  "jobId": "numeric-refusal",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/stream-kernel-constructor-diagnostic.yml"
}
