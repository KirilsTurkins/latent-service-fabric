{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Exact original broker I/O owners and selected stream source",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 20,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "name": "Restore compiled Rust dependencies",
        "uses": "KirilsTurkins/lsf-rust-cache",
        "with": {
          "prefix-key": "lsf-ci-dependencies-v2",
          "shared-key": "host-correctness",
          "key": "ubuntu-24.04",
          "cache-targets": true,
          "cache-bin": false,
          "cache-workspace-crates": false,
          "cache-all-crates": false,
          "cache-on-failure": false,
          "save-if": false
        }
      },
      {
        "name": "Execute exact broker owners and compile stream integration",
        "run": "python3 tools/qualify_stream_kernel_owners.py --output \"$RUNNER_TEMP/stream-kernel-owners\""
      },
      {
        "name": "Retain bounded owner execution and compile failures",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "stream-kernel-owners-${{ github.sha }}",
          "path": "${{ runner.temp }}/stream-kernel-owners/",
          "if-no-files-found": "warn",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "owners",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/stream-kernel-owners.yml"
}
