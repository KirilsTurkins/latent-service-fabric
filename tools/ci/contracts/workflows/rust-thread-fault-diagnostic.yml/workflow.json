{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "rust-thread-fault-${{ github.ref }}"
    },
    "name": "Numeric original Rust ThreadPool fault diagnostic",
    "on": {
      "push": {
        "branches": [
          "diag/rust-thread-frames-20261023"
        ],
        "paths": [
          ".github/workflows/rust-thread-fault-diagnostic.yml",
          "crates/latent-wasmtime/src/config/engine.rs",
          "crates/latent-wasmtime/src/rust_thread_fault.rs",
          "tools/diagnose_rust_thread_fault.py",
          "tools/rust_thread_fault_frames.py",
          "tools/rust_thread_native_products.py",
          "tools/rust_thread_compiler_materials.py",
          "tools/rust_thread_runtime_package.py",
          "tools/rust_thread_runtime_node.py"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "actions": "read",
      "contents": "read"
    }
  },
  "requiredJobs": [
    "diagnostic"
  ],
  "reviewReason": "Retrigger the bounded Rust diagnostic when its shared immutable product readers or signed consumer change.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-thread-fault-diagnostic.yml"
}
