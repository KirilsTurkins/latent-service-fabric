{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "node-worker-stacks-${{ github.ref }}"
    },
    "name": "Node worker stack reference",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/node-worker-stacks.yml",
          "apps/latentd/src/worker_stacks*",
          "apps/latentd/src/worker_stacks/**",
          "apps/latentd/src/command/serve.rs",
          "apps/latentd/src/command/inspection.rs",
          "apps/latentd/src/config.rs",
          "apps/latentd/src/config/derive.rs",
          "apps/latentd/src/config/topology.rs",
          "apps/latentd/src/config/tests.rs",
          "apps/latentd/src/lib_root.rs",
          "apps/latentd/src/config/tests/providers.rs",
          "apps/latentd/Cargo.toml",
          "crates/latent-wasmtime/src/config.rs",
          "crates/latent-wasmtime/src/config/engine.rs",
          "crates/latent-wasmtime/src/config/renderer.rs",
          "Cargo.toml",
          "apps/latentd/src/standalone/observations/topology*",
          "apps/latentd/src/standalone/observations/topology/**",
          "sdk/node-worker-stacks/**",
          "tools/qualify_node_worker_stacks.py",
          "tools/tests/test_node_worker_stacks.py",
          "Cargo.lock",
          "rust-toolchain.toml"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/node-worker-stacks.yml",
          "apps/latentd/src/worker_stacks*",
          "apps/latentd/src/worker_stacks/**",
          "apps/latentd/src/command/serve.rs",
          "apps/latentd/src/command/inspection.rs",
          "apps/latentd/src/config.rs",
          "apps/latentd/src/config/derive.rs",
          "apps/latentd/src/config/topology.rs",
          "apps/latentd/src/config/tests.rs",
          "apps/latentd/src/lib_root.rs",
          "apps/latentd/src/config/tests/providers.rs",
          "apps/latentd/Cargo.toml",
          "crates/latent-wasmtime/src/config.rs",
          "crates/latent-wasmtime/src/config/engine.rs",
          "crates/latent-wasmtime/src/config/renderer.rs",
          "Cargo.toml",
          "apps/latentd/src/standalone/observations/topology*",
          "apps/latentd/src/standalone/observations/topology/**",
          "sdk/node-worker-stacks/**",
          "tools/qualify_node_worker_stacks.py",
          "tools/tests/test_node_worker_stacks.py",
          "Cargo.lock",
          "rust-toolchain.toml"
        ]
      },
      "workflow_dispatch": {}
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "reference",
    "topology"
  ],
  "reviewReason": "Precharge the standalone fixed 38-row composition; preserve original worker-stack job and add only exact reporter/config regressions under unchanged snapshot and provider limits.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/node-worker-stacks.yml"
}
