{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "rust-http-thread-composition-diagnostic-${{ github.ref }}"
    },
    "name": "Rust combined HTTP and ThreadPool source diagnostic",
    "on": {
      "push": {
        "branches": [
          "feat/rust-http-thread-20261104",
          "fix/rust-http-bindgen-20261104",
          "fix/rust-http-wac11-20261104",
          "fix/rust-http-thread-validation-20261104"
        ],
        "paths": [
          ".github/workflows/rust-http-thread-composition-diagnostic.yml",
          "tools/compile_rust_thread_http_sibling.py",
          "tools/rust_thread_http_sibling_*.py",
          "tools/tests/test_rust_thread_http_sibling*.py",
          "tools/rust_wasi_http_compose.py",
          "tools/rust_wasi_http_root.py",
          "tools/tests/test_rust_wasi_http_bindgen.py",
          "tools/rust_wasi_http_inputs.py",
          "tools/rust_owned_thread_component.py",
          "tools/toolchain.toml",
          "sdk/rust-standard-runtime/**"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "diagnostic"
  ],
  "reviewReason": "Preserve the existing compiler diagnostic and add its threading-aware validation repair branch.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-http-thread-composition-diagnostic.yml"
}
