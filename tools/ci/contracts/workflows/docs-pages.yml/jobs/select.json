{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "if": "github.repository == 'KirilsTurkins/latent-service-fabric' && github.ref == 'refs/heads/release'",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 10,
    "permissions": {
      "contents": "read",
      "actions": "read"
    },
    "outputs": {
      "artifact_id": "${{ steps.staged.outputs.artifact-id }}"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "ref": "${{ github.sha }}",
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Verify successful push origin, exact attempt, immutable artifact and fresh source",
        "env": {
          "GH_TOKEN": "${{ github.token }}",
          "SOURCE_SHA": "${{ inputs.source_sha }}",
          "CI_RUN": "${{ inputs.ci_run }}",
          "CI_ATTEMPT": "${{ inputs.ci_attempt }}",
          "PUBLICATION_MODE": "${{ inputs.mode }}",
          "PREVIOUS_PUBLICATION_RUN": "${{ inputs.previous_publication_run }}",
          "EXPECTED_LIVE_SOURCE": "${{ inputs.expected_live_source }}"
        },
        "run": "python3 tools/docs_pages.py select --source \"$SOURCE_SHA\" --run \"$CI_RUN\" \\\n  --attempt \"$CI_ATTEMPT\" --mode \"$PUBLICATION_MODE\" \\\n  --previous-publication-run \"$PREVIOUS_PUBLICATION_RUN\" \\\n  --expected-live-source \"$EXPECTED_LIVE_SOURCE\" --output target/docs-pages-staged\n"
      },
      {
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "id": "staged",
        "with": {
          "name": "docs-pages-staged-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "target/docs-pages-staged/",
          "include-hidden-files": true,
          "if-no-files-found": "error",
          "retention-days": 14
        }
      }
    ]
  },
  "jobId": "select",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/docs-pages.yml"
}
