{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "needs": "select",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 10,
    "environment": {
      "name": "github-pages",
      "url": "${{ steps.deployment.outputs.page_url }}"
    },
    "permissions": {
      "contents": "read",
      "actions": "read",
      "pages": "write",
      "id-token": "write"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "ref": "${{ github.sha }}",
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-download-artifact",
        "with": {
          "artifact-ids": "${{ needs.select.outputs.artifact_id }}",
          "path": "candidate",
          "merge-multiple": true
        }
      },
      {
        "name": "Recheck exact site bytes and source after protected environment approval",
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "run": "python3 tools/docs_pages.py guard --receipt candidate/publication.json"
      },
      {
        "uses": "KirilsTurkins/lsf-upload-pages-artifact",
        "with": {
          "name": "github-pages-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "candidate/site",
          "retention-days": 14
        }
      },
      {
        "uses": "KirilsTurkins/lsf-deploy-pages",
        "id": "deployment",
        "with": {
          "artifact_name": "github-pages-${{ github.run_id }}-${{ github.run_attempt }}",
          "timeout": 300000
        }
      },
      {
        "name": "Verify live publication identity and direct static routes",
        "run": "python3 tools/docs_pages.py verify --receipt candidate/publication.json"
      },
      {
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "docs-pages-receipt-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "candidate/publication.json",
          "if-no-files-found": "error",
          "retention-days": 14
        }
      }
    ]
  },
  "jobId": "deploy",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/docs-pages.yml"
}
