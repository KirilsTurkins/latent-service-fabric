  "definition": {
    "name": "Durable catalog acceptance",
    "needs": "profile",
    "if": "needs.profile.outputs.profile == 'full'",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 120,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "name": "Restore compiled Rust dependencies",
        "uses": "KirilsTurkins/lsf-rust-cache",
        "with": {
          "prefix-key": "lsf-ci-dependencies-v2",
          "shared-key": "host-correctness",
          "key": "ubuntu-24.04",
          "cache-targets": true,
          "cache-bin": false,
          "cache-workspace-crates": false,
          "cache-all-crates": false,
          "cache-on-failure": false,
          "save-if": false
        }
      },
      {
        "name": "Run catalog recovery, routing, and dormancy regressions",
        "run": "cargo test -p latent-artifacts -p latent-control-store --lib --locked -- --nocapture"
      },
      {
        "name": "Check catalog probe supervision",
        "run": "cargo test -p latentd --test catalog_scale --locked"
      },
      {
        "name": "Publish and reopen 100,000 dormant releases in isolated processes",
        "if": "github.event_name == 'workflow_dispatch' && inputs.run_catalog_scale",
        "shell": "bash",
        "env": {
          "TMPDIR": "${{ runner.temp }}",
          "LSF_CATALOG_SCALE_LOG_DIR": "${{ github.workspace }}/catalog-scale-logs"
        },
        "run": "set -o pipefail\ncargo test -p latentd --test catalog_scale --locked production_catalog_100k -- --exact --ignored --nocapture --test-threads=1 2>&1 | tee catalog-scale.log\n"
      },
      {
        "name": "Retain catalog acceptance evidence",
        "if": "always() && github.event_name == 'workflow_dispatch' && inputs.run_catalog_scale",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "catalog-scale-${{ github.sha }}",
          "path": "catalog-scale.log\ncatalog-scale-logs/*.log\n",
          "if-no-files-found": "warn",
          "retention-days": 14
        }
      }
    ]
  },
  "jobId": "catalog",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/ci.yml"
}
