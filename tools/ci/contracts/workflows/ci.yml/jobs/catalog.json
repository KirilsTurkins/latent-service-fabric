{"definition":{"if":"needs.profile.outputs.profile == 'full'","name":"Durable catalog acceptance","needs":"profile","runs-on":"ubuntu-24.04","steps":[{"uses":"KirilsTurkins/lsf-checkout","with":{"persist-credentials":false}},{"uses":"dtolnay/rust-toolchain"},{"name":"Restore compiled Rust dependencies","uses":"KirilsTurkins/lsf-rust-cache","with":{"cache-all-crates":false,"cache-bin":false,"cache-on-failure":false,"cache-targets":true,"cache-workspace-crates":false,"key":"ubuntu-24.04","prefix-key":"lsf-ci-dependencies-v2","save-if":false,"shared-key":"host-correctness"}},{"name":"Run catalog recovery, routing, and dormancy regressions","run":"cargo test -p latent-artifacts -p latent-control-store --lib --locked -- --nocapture"},{"name":"Check catalog probe supervision","run":"cargo test -p latentd --test catalog_scale --locked"},{"env":{"LSF_CATALOG_SCALE_LOG_DIR":"${{ github.workspace }}/catalog-scale-logs","TMPDIR":"${{ runner.temp }}"},"if":"github.event_name == 'workflow_dispatch' && inputs.run_catalog_scale","name":"Publish and reopen 100,000 dormant releases in isolated processes","run":"set -o pipefail\ncargo test -p latentd --test catalog_scale --locked production_catalog_100k -- --exact --ignored --nocapture --test-threads=1 2>&1 | tee catalog-scale.log\n","shell":"bash"},{"if":"always() && github.event_name == 'workflow_dispatch' && inputs.run_catalog_scale","name":"Retain catalog acceptance evidence","uses":"KirilsTurkins/lsf-upload-artifact","with":{"if-no-files-found":"warn","name":"catalog-scale-${{ github.sha }}","path":"catalog-scale.log\ncatalog-scale-logs/*.log\n","retention-days":14}}],"timeout-minutes":120},"jobId":"catalog","kind":"job","reviewReason":"CI performance: preserve every execution obligation; share pruned dependencies, retain correctness guards and overlap independent checks.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/ci.yml"}
