  "definition": {
    "name": "Repository contracts (${{ matrix.lane }})",
    "needs": "profile",
    "if": "needs.profile.outputs.profile == 'full'",
    "runs-on": "ubuntu-24.04",
    "strategy": {
      "fail-fast": false,
      "matrix": {
        "lane": [
          "python",
          "bindings",
          "runtime",
          "standalone",
          "sdk-provider",
          "measurements",
          "optimization"
        ]
      }
    },
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "actions/setup-python",
        "with": {
          "python-version": "3.13.5",
          "cache": "pip",
          "cache-dependency-path": "tools/requirements.lock"
        }
      },
      {
        "name": "Install Python validator dependencies",
        "run": "python -m pip install --requirement tools/requirements.lock"
      },
      {
        "uses": "dtolnay/rust-toolchain",
        "with": {
          "targets": "wasm32-wasip2,wasm32-unknown-unknown"
        }
      },
      {
        "name": "Restore compiled Rust dependencies",
        "uses": "Swatinem/rust-cache",
        "with": {
          "prefix-key": "lsf-ci-dependencies-v3-contract-profiles",
          "shared-key": "${{ matrix.lane == 'measurements' && 'frozen-collector' || matrix.lane == 'optimization' && 'optimization-smoke' || matrix.lane == 'bindings' && 'host-correctness' || 'host-contracts' }}",
          "key": "ubuntu-24.04",
          "cache-targets": false,
          "cache-directories": "target/debug\ntarget/release\ntarget/wasm32-unknown-unknown\ntarget/wasm32-wasip2\n",
          "cache-bin": false,
          "cache-workspace-crates": false,
          "cache-all-crates": false,
          "cache-on-failure": false,
          "save-if": "${{ github.event_name == 'push' && github.ref == 'refs/heads/development' && (matrix.lane == 'standalone' || matrix.lane == 'measurements' || matrix.lane == 'optimization') }}"
        }
      },
      {
        "uses": "bytecodealliance/actions/wasm-tools/setup",
        "with": {
          "version": "1.254.0"
        }
      },
      {
        "uses": "bufbuild/buf-setup-action",
        "with": {
          "version": "1.72.0",
          "github_token": "${{ github.token }}"
        }
      },
      {
        "uses": "mlugg/setup-zig",
        "with": {
          "version": "0.16.0"
        }
      },
      {
        "name": "Install verified guest binding generator",
        "run": "python3 tools/install_guest_bindgen.py \"${RUNNER_TEMP}/lsf-guest-tools\" >> \"${GITHUB_PATH}\""
      },
      {
        "name": "Set up the Node SDK provider participant",
        "uses": "actions/setup-node",
        "with": {
          "node-version": "24.19.0",
          "cache": "npm",
          "cache-dependency-path": "sdk/typescript-client/package-lock.json"
        }
      },
      {
        "name": "Set up the Go SDK provider participant",
        "uses": "actions/setup-go",
        "with": {
          "go-version": "1.27.1",
          "cache-dependency-path": "sdk/go/go.sum"
        }
      },
      {
        "name": "Set up the Java SDK provider participant",
        "uses": "actions/setup-java",
        "with": {
          "distribution": "temurin",
          "java-version": "25.0.4+101.0.LTS"
        }
      },
      {
        "name": "Set up the .NET SDK provider participant",
        "uses": "actions/setup-dotnet",
        "with": {
          "dotnet-version": "8.0.425"
        }
      },
      {
        "name": "Validate contracts, echo component, and generated bindings",
        "if": "matrix.lane != 'optimization'",
        "env": {
          "CI_CONTRACT_LANE": "${{ matrix.lane }}"
        },
        "run": "tools/validate_contracts.sh \"$CI_CONTRACT_LANE\""
      },
      {
        "name": "Pass bounded observed build inputs to registry verification",
        "if": "matrix.lane == 'runtime'",
        "uses": "actions/upload-artifact",
        "with": {
          "name": "phase-2-observed-echo-${{ github.sha }}",
          "path": "target/capsules/echo-provenance/",
          "if-no-files-found": "error",
          "retention-days": 1
        }
      },
      {
        "name": "Pass the bounded public web component to registry verification",
        "if": "matrix.lane == 'runtime'",
        "uses": "actions/upload-artifact",
        "with": {
          "name": "phase-3-web-contract-${{ github.sha }}",
          "path": "target/capsules/web-contract/component.wasm",
          "if-no-files-found": "error",
          "retention-days": 1
        }
      },
      {
        "name": "Retain bounded conformance and provider diagnostics",
        "if": "always() && (matrix.lane == 'standalone' || matrix.lane == 'sdk-provider')",
        "uses": "actions/upload-artifact",
        "with": {
          "name": "phase-1-bounded-conformance-${{ github.sha }}-${{ matrix.lane }}",
          "path": "target/phase1-conformance/\ntarget/phase3-management/provider-receipt.json\ntarget/phase3-sdk/\n",
          "if-no-files-found": "warn",
          "retention-days": 14
        }
      },
      {
        "name": "Retain Phase 1 measurement collector smoke diagnostics",
        "if": "always() && matrix.lane == 'measurements'",
        "uses": "actions/upload-artifact",
        "with": {
          "name": "phase-1-measurement-smoke-${{ github.sha }}",
          "path": "target/phase1-measurements/",
          "if-no-files-found": "warn",
          "retention-days": 14
        }
      },
      {
        "name": "Validate standalone optimization benchmark smoke",
        "if": "matrix.lane == 'optimization'",
        "run": "unset CARGO_INCREMENTAL CARGO_BUILD_JOBS CARGO_PROFILE_DEV_DEBUG CARGO_PROFILE_TEST_DEBUG\nunset CARGO_PROFILE_DEV_DEBUG_ASSERTIONS CARGO_PROFILE_TEST_DEBUG_ASSERTIONS\nunset CARGO_PROFILE_DEV_OVERFLOW_CHECKS CARGO_PROFILE_TEST_OVERFLOW_CHECKS\npython3 tools/run_optimization_benchmarks.py --profile smoke\n"
      },
      {
        "name": "Retain optimization benchmark smoke evidence",
        "if": "always() && matrix.lane == 'optimization'",
        "uses": "actions/upload-artifact",
        "with": {
          "name": "phase-1-optimization-smoke-${{ github.sha }}",
          "path": "target/optimization-benchmarks/",
          "if-no-files-found": "warn",
          "retention-days": 14
        }
      },
      {
        "name": "Record echo capsule build evidence",
        "if": "matrix.lane == 'runtime'",
        "run": "cat target/capsules/echo/build.json\ncat target/capsules/echo/sha256.txt\n"
      },
      {
        "name": "Upload echo capsule build evidence",
        "if": "matrix.lane == 'runtime'",
        "uses": "actions/upload-artifact",
        "with": {
          "name": "phase-0-echo-capsule-${{ github.sha }}",
          "path": "target/capsules/echo/echo-capsule.wasm\ntarget/capsules/echo/capsule.json\ntarget/capsules/echo/build.json\ntarget/capsules/echo/interface.json\ntarget/capsules/echo/interface/\ntarget/capsules/echo/sha256.txt\n",
          "if-no-files-found": "error",
          "retention-days": 14
        }
      },
      {
        "name": "Seed the minimal runtime dependency graph in the complete native cache writer",
        "if": "github.event_name == 'push' && github.ref == 'refs/heads/development' && matrix.lane == 'standalone'",
        "run": "python3 tools/test.py prepare --suite selection.echo-runtime --inventory \"$RUNNER_TEMP/lsf-cache-echo-runtime.jsonl\" --context ci"
      },
      {
        "name": "Remove validated echo fixtures before dependency cache pruning",
        "if": "github.event_name == 'push' && github.ref == 'refs/heads/development' && (matrix.lane == 'standalone' || matrix.lane == 'measurements')",
        "run": "python3 tools/reset_validation_echo.py --target-root target"
      }
    ]
  },
  "jobId": "contracts",
  "kind": "job",
  "reviewReason": "Preserve every optimizer lane, command, artifact and historical obligation. Exclude generated fixture owners from dependency caches with a new namespace and four actual Cargo profiles; retain the current complete writer preparation and strict fixture cleanup after evidence.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/ci.yml"
}
