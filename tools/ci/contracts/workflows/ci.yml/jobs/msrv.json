{"definition":{"if":"needs.profile.outputs.profile == 'full' || needs.profile.outputs.profile == 'fast'","name":"Rust MSRV 1.95.0","needs":"profile","runs-on":"ubuntu-24.04","steps":[{"uses":"KirilsTurkins/lsf-checkout","with":{"persist-credentials":false}},{"uses":"dtolnay/rust-toolchain"},{"name":"Install the declared minimum supported Rust toolchain","run":"rustup toolchain install 1.95.0 --profile minimal --no-self-update"},{"name":"Restore compiled Rust dependencies","uses":"KirilsTurkins/lsf-rust-cache","with":{"cache-all-crates":false,"cache-bin":false,"cache-on-failure":false,"cache-targets":true,"cache-workspace-crates":false,"key":"ubuntu-24.04","prefix-key":"lsf-ci-dependencies-v2","save-if":"${{ github.event_name == 'push' && github.ref == 'refs/heads/development' }}","shared-key":"msrv-correctness"}},{"if":"needs.profile.outputs.profile == 'full'","name":"Check workspace at MSRV","run":"python3 tools/ci_cargo.py run msrv"},{"env":{"CI_FAST_PACKAGES":"${{ needs.profile.outputs.fast_packages }}"},"if":"needs.profile.outputs.profile == 'fast'","name":"Check all selected reverse dependents at MSRV","run":"python3 tools/ci_fast.py --msrv --packages-json \"$CI_FAST_PACKAGES\" --output \"$RUNNER_TEMP/ci-fast-msrv\""},{"if":"always() && needs.profile.outputs.profile == 'fast'","name":"Retain narrow MSRV timing evidence","uses":"KirilsTurkins/lsf-upload-artifact","with":{"if-no-files-found":"error","name":"ci-host-msrv-${{ github.sha }}","path":"${{ runner.temp }}/ci-fast-msrv/","retention-days":7}}]},"jobId":"msrv","kind":"job","reviewReason":"CI performance: preserve every execution obligation; share pruned dependencies, retain correctness guards and overlap independent checks.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/ci.yml"}
