{"definition":{"if":"needs.profile.outputs.profile == 'full'","name":"OCI registry TLS integration","needs":["profile","contracts"],"runs-on":"ubuntu-24.04","steps":[{"uses":"KirilsTurkins/lsf-checkout","with":{"persist-credentials":false}},{"uses":"dtolnay/rust-toolchain"},{"name":"Restore compiled Rust dependencies","uses":"KirilsTurkins/lsf-rust-cache","with":{"cache-all-crates":false,"cache-bin":false,"cache-on-failure":false,"cache-targets":true,"cache-workspace-crates":false,"key":"ubuntu-24.04","prefix-key":"lsf-ci-dependencies-v2","save-if":false,"shared-key":"host-correctness"}},{"name":"Receive bounded observed echo inputs","uses":"KirilsTurkins/lsf-download-artifact","with":{"name":"phase-2-observed-echo-${{ github.sha }}","path":"target/capsules/echo-provenance"}},{"name":"Fetch pinned disposable registry","run":"docker pull ghcr.io/project-zot/zot-minimal-linux-amd64@sha256:f1ffb7a5bbddc0feea83646e29c587ecf39b3193733b447749d4c9ead111a395"},{"uses":"KirilsTurkins/lsf-setup-python","with":{"python-version":"3.13.5"}},{"id":"oci_preflight","name":"Check owned registry prerequisites before building","run":"python3 tools/run_oci_registry_tests.py --preflight --diagnostic-root \"$RUNNER_TEMP/owned-oci\""},{"env":{"LSF_LIVE_OCI_DEMO":"1","LSF_OWNED_DEMO_DIAGNOSTICS":"${{ runner.temp }}/owned-oci-demo","LSF_REQUIRE_NATIVE_PROCESS_TESTS":"1"},"name":"Demonstrate live provider startup and injected failure cleanup","run":"python3 -m unittest tools.tests.test_owned_runners.NativeRunnerDemonstrations.test_live_provider_normal_and_injected_failure_leave_no_owned_container"},{"name":"Prepare exact OCI and web admission harnesses","run":"cargo test -p latent-oci --test registry --locked --no-run --message-format=json,json-render-diagnostics > \"$RUNNER_TEMP/lsf-oci-tests.jsonl\"\ncargo test -p latent-policy --lib --locked --no-run --message-format=json,json-render-diagnostics > \"$RUNNER_TEMP/lsf-web-registry-tests.jsonl\"\n"},{"name":"Check runner ownership and cleanup guards","run":"python3 -m unittest discover -s tools/tests -p test_oci_registry_runner.py"},{"name":"Validate bounded authenticated OCI distribution","run":"python3 tools/run_oci_registry_tests.py --test-manifest \"$RUNNER_TEMP/lsf-oci-tests.jsonl\" --state-file \"$RUNNER_TEMP/lsf-oci-registry.json\" --provenance-input target/capsules/echo-provenance --diagnostic-root \"$RUNNER_TEMP/owned-oci\""},{"name":"Receive bounded public web component","uses":"KirilsTurkins/lsf-download-artifact","with":{"name":"phase-3-web-contract-${{ github.sha }}","path":"target/capsules/web-contract"}},{"name":"Validate signed web package registry and catalog round trips","run":"python3 tools/run_oci_registry_tests.py --test-manifest \"$RUNNER_TEMP/lsf-web-registry-tests.jsonl\" --state-file \"$RUNNER_TEMP/lsf-oci-registry.json\" --web-admission-component target/capsules/web-contract/component.wasm --diagnostic-root \"$RUNNER_TEMP/owned-oci\""},{"if":"always()","name":"Recover only this job's disposable registry","run":"python3 tools/run_oci_registry_tests.py --cleanup-state \"$RUNNER_TEMP/lsf-oci-registry.json\" --diagnostic-root \"$RUNNER_TEMP/owned-oci\""},{"if":"always() && steps.oci_preflight.outcome != '' && steps.oci_preflight.outcome != 'skipped'","name":"Retain attempted registry ownership diagnostics","uses":"KirilsTurkins/lsf-upload-artifact","with":{"if-no-files-found":"warn","name":"owned-oci-${{ github.sha }}","path":"${{ runner.temp }}/owned-oci/*.json\n${{ runner.temp }}/owned-oci-demo/*.json\n","retention-days":7}}],"timeout-minutes":25},"jobId":"oci-registry","kind":"job","reviewReason":"CI performance: preserve every execution obligation; share pruned dependencies, retain correctness guards and overlap independent checks.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/ci.yml"}
