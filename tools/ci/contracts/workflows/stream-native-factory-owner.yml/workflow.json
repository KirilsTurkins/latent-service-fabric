{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "stream-native-factory-owner-${{ github.ref }}"
    },
    "name": "Stream native factory descriptor ownership",
    "on": {
      "push": {
        "branches": [
          "feat/stream-kernel-native-factory-owner-20261023",
          "feat/kernel-native-constructor-vm-20261024",
          "feat/kernel-native-close-20261024",
          "feat/sdk-738-q35-node-boot-20261029",
          "feat/sdk-738-q35-pci-identity-20261104",
          "feat/sdk-738-q35-node-pci-prefix-20261104"
        ],
        "paths": [
          ".github/workflows/stream-native-factory-owner.yml",
          "crates/latent-streams/**",
          "examples/renderer-profile/package.json",
          "examples/renderer-profile/package-lock.json",
          "crates/latent-capabilities/src/broker/pools/control.rs",
          "crates/latent-capabilities/src/broker/pools.rs",
          "crates/latent-capabilities/src/broker/pools/tests.rs",
          "crates/latent-capabilities/src/broker/pools/tests/close_observation.rs",
          "tools/qualify_host_stream_native.py",
          "tools/qualify_host_stream_kernel_native_vm.py",
          "tools/host_stream_kernel_native_vm.py",
          "tools/host_stream_kernel_native_vm_inputs.py",
          "tools/tests/test_kernel_native_constructor_vm.py",
          "tools/ci/suites.json",
          "tools/ci/suites.d/outbound-streams.json",
          "research/standard-outbound/linux-6.12-lineage/native-constructor-vm-init.c",
          "research/standard-outbound/linux-6.12-lineage/node-boot/**",
          "research/standard-outbound/linux-6.12-lineage/node-constructor-bridge/**",
          "research/standard-outbound/linux-6.12-lineage/node-pci-prefix/**"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "native-kernel-vm",
    "native-owner"
  ],
  "reviewReason": "One closed q35/KVM original-Node PCI birth/return qualification; original preimages, source bounds, ownership, IRQ/TCP and historical routes remain enforced.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/stream-native-factory-owner.yml"
}
