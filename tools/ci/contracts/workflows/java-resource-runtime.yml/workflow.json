{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "java-resource-runtime-${{ github.ref }}"
    },
    "name": "Java joined resources and standard facilities",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          "examples/java-resource-runtime/**",
          "tools/java_resource_runtime_*.py",
          "tools/java_resource_timer_observer.py",
          "tools/qualify_java_resource_runtime.py",
          "tools/tests/test_java_joined*.py",
          ".github/workflows/java-resource-runtime.yml"
        ]
      },
      "push": {
        "branches": [
          "feat/java-resource-runtime-20261020"
        ],
        "paths": [
          ".github/workflows/java-resource-runtime.yml"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "diagnose_retained_component": {
            "default": false,
            "description": "Observe only retained fresh, clear and parallel paths; never qualify original13",
            "type": "boolean"
          },
          "observe_retained_failure": {
            "default": false,
            "description": "Private closed trap enum and numeric frames; never qualify original13",
            "type": "boolean"
          },
          "replay_retained_component": {
            "default": false,
            "description": "Re-sign the exact retained Java component and run all original13 cases",
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "actions": "read",
      "contents": "read"
    }
  },
  "requiredJobs": [
    "joined-facilities",
    "private-observer",
    "retained-component"
  ],
  "reviewReason": "Add only an explicit default-false private enum/numeric-frame observation lane around the immutable063be guest; preserve both old jobs, all commands, limits and historical obligations.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/java-resource-runtime.yml"
}
