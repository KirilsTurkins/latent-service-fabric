{
  "kind": "workflow",
  "policy": {
    "name": "Java guest authoring",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/java-guest/**",
          "sdk/transaction-contract/**",
          "tools/**",
          "apps/**",
          "crates/**",
          "schemas/**",
          "Cargo.*",
          "docs/component-development/java-authoring.md",
          ".github/workflows/java-guest-feasibility.yml",
          "wit/platform/**"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    },
    "concurrency": {
      "group": "java-guest-feasibility-${{ github.ref }}",
      "cancel-in-progress": true
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    }
  },
  "requiredJobs": [
    "compiler-component"
  ],
  "reviewReason": "Preserve all original linked result/payload retention and reserved recovery cases, every authored transaction and captured dependency compiler obligation, actual SDK source recipes, exact guards and both evidence paths while reconciling current development and the reviewed complete sixteen-method client contract.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/java-guest-feasibility.yml"
}
