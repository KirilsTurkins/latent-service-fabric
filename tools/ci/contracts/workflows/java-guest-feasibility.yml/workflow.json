{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "java-guest-feasibility-${{ github.ref }}"
    },
    "name": "Java guest authoring",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/java-guest/**",
          "examples/java-http-composition/**",
          "tools/**",
          "apps/**",
          "crates/**",
          "schemas/**",
          "Cargo.*",
          "docs/component-development/java-authoring.md",
          ".github/workflows/java-guest-feasibility.yml",
          "wit/platform/**"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "compiler-component"
  ],
  "reviewReason": "Add exact Java HTTP fixture selection while retaining all existing authoring obligations",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/java-guest-feasibility.yml"
}
