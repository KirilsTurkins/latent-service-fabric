{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "java-guest-feasibility-${{ github.ref }}"
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "Java guest authoring",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/java-guest/**",
          "examples/java-http-request/**",
          "examples/java-david-webb/**",
          "examples/java-http-composition/**",
          "examples/java-transaction-schema/**",
          "contracts/state/application-aggregate-*.schema.json",
          "sdk/transaction-contract/**",
          "tools/**",
          "apps/**",
          "crates/**",
          "schemas/**",
          "Cargo.*",
          "docs/component-development/java-authoring.md",
          "docs/component-development/java-httpserver.md",
          ".github/workflows/java-guest-feasibility.yml",
          "wit/platform/**"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "java_http_spi": {
            "default": false,
            "description": "Separate optional Java public ConnectionFactory programme",
            "type": "boolean"
          },
          "public_fiber_assembly": {
            "default": false,
            "description": "Build only the fixed public fiber assembly inputs without component execution",
            "type": "boolean"
          },
          "public_fiber_derived_llvm": {
            "default": false,
            "description": "Compiler-only public fixture using one qualified source-bound LLVM candidate",
            "type": "boolean"
          },
          "qualify-scratch-refusals": {
            "default": false,
            "description": "Run the unchanged normal Java prerequisite and separate filesystem refusal packet",
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "compiler-component",
    "dependency-ingestion",
    "http-public-spi",
    "public-fiber-assembly",
    "resource-conformance",
    "scratch-refusals"
  ],
  "reviewReason": "Reviewed compiler-only exact R7 carrier selector; preserve normal SDK29 defaults, all original commands/caps, historical workflow inverses and closed public-only source admission.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/java-guest-feasibility.yml"
}
