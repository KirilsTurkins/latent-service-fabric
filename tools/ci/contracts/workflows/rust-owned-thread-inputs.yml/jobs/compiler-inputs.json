{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Compile exact Rust context utility and owned thread sysroot",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "actions/setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain",
        "with": {
          "targets": "wasm32-unknown-unknown"
        }
      },
      {
        "uses": "Swatinem/rust-cache",
        "with": {
          "cache-all-crates": false,
          "cache-bin": false,
          "cache-on-failure": false,
          "cache-targets": true,
          "cache-workspace-crates": false,
          "key": "ubuntu-24.04",
          "prefix-key": "lsf-ci-dependencies-v2",
          "save-if": false,
          "shared-key": "host-correctness"
        }
      },
      {
        "name": "Install existing pinned Python compiler recipe dependencies",
        "run": "python3 -m pip install -r tools/requirements.lock"
      },
      {
        "env": {
          "EXPECTED_HEAD": "${{ github.sha }}"
        },
        "name": "Build the two exact owned compiler inputs once",
        "run": "python3 -B tools/compile_rust_owned_thread_inputs.py --expected-head \"$EXPECTED_HEAD\" --rust-bin \"$(dirname \"$(rustup which rustc)\")\" --output \"$RUNNER_TEMP/rust-owned-thread-inputs\""
      },
      {
        "if": "always()",
        "name": "Retain bounded source, tool, sysroot and actual failure logs",
        "uses": "actions/upload-artifact",
        "with": {
          "if-no-files-found": "error",
          "name": "rust-owned-thread-inputs-${{ github.sha }}",
          "path": "${{ runner.temp }}/rust-owned-thread-inputs/**",
          "retention-days": 3
        }
      }
    ],
    "timeout-minutes": 20
  },
  "jobId": "compiler-inputs",
  "kind": "job",
  "reviewReason": "Build one emitted utility and one owned thread sysroot with exact source and retained failures, preserving existing finite compiler and artifact limits",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-owned-thread-inputs.yml"
}
