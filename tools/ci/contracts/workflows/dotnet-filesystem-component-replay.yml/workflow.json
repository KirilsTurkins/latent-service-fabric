{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "dotnet-filesystem-components-${{ github.ref }}"
    },
    "name": "Retained .NET filesystem component replay",
    "on": {
      "push": {
        "branches": [
          "diagnostic/dotnet-closed-filesystem-replay-20261020"
        ],
        "paths": [
          ".github/workflows/dotnet-filesystem-component-replay.yml",
          "tools/replay_dotnet_filesystem_components.py",
          "tools/tests/test_dotnet_filesystem_components.py"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "actions": "read",
      "contents": "read"
    }
  },
  "requiredJobs": [
    "replay"
  ],
  "reviewReason": "Register new diagnostic-only workflow by one exact branch/path push because GitHub cannot dispatch an unregistered workflow absent from default branch; no production or PR event",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/dotnet-filesystem-component-replay.yml"
}
