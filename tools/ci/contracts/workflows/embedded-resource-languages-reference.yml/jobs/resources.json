{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Fresh ${{ matrix.language }} transitive data and trap recovery",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 20,
    "strategy": {
      "fail-fast": false,
      "matrix": {
        "language": "${{ fromJSON(inputs.language == 'rust' && '[\"rust\"]' || inputs.language == 'typescript' && '[\"typescript\"]' || '[\"rust\",\"typescript\"]') }}"
      }
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain",
        "if": "matrix.language == 'rust'",
        "with": {
          "targets": "wasm32-unknown-unknown"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-zig",
        "if": "matrix.language == 'rust'",
        "with": {
          "version": "0.16.0"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-node",
        "if": "matrix.language == 'typescript'",
        "with": {
          "node-version": "24.19.0"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-bytecodealliance-actions/wasm-tools/setup",
        "with": {
          "version": "1.254.0"
        }
      },
      {
        "name": "Install the original bounded compiler namespace and source controls",
        "run": "sudo apt-get update\nsudo apt-get install --yes bubblewrap\nsudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0\npython3 -m pip install -r tools/requirements.lock\n"
      },
      {
        "name": "Check fixed artifact selections original programmes and drift refusals",
        "run": "python3 -B -m unittest tools.tests.test_embedded_resource_conformance tools.tests.test_go_embedded_resource_replay tools.tests.test_embedded_resource_language_replay -v"
      },
      {
        "name": "Authenticate the successful native producer before restoring executables",
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "run": "python3 -B tools/replay_go_embedded_resources.py --record-producer --output \"$RUNNER_TEMP/embedded-native-producer.json\""
      },
      {
        "name": "Restore only the authenticated native normal bundle",
        "uses": "KirilsTurkins/lsf-download-artifact",
        "with": {
          "name": "go-scratch-prepared-94d0f8b0c1508df50e2830e6d678661c1e76bc36",
          "run-id": 39373374237,
          "github-token": "${{ github.token }}",
          "path": "${{ runner.temp }}/embedded-native-normal"
        }
      },
      {
        "name": "Acquire only pinned public companion components and normal provenance",
        "env": {
          "GH_TOKEN": "${{ github.token }}",
          "RESOURCE_LANGUAGE": "${{ matrix.language }}"
        },
        "run": "python3 -B tools/replay_embedded_resource_languages.py --language \"$RESOURCE_LANGUAGE\" --acquire --output \"$RUNNER_TEMP/embedded-original\""
      },
      {
        "name": "Install the existing pinned Rust binding compiler",
        "if": "matrix.language == 'rust'",
        "run": "python3 tools/install_guest_bindgen.py \"$RUNNER_TEMP/embedded-tools\"\necho \"$RUNNER_TEMP/embedded-tools\" >> \"$GITHUB_PATH\"\n"
      },
      {
        "name": "Install the existing pinned public TypeScript compiler",
        "if": "matrix.language == 'typescript'",
        "run": "python3 tools/typescript_capsule.py install-tools \"$RUNNER_TEMP/embedded-tools\""
      },
      {
        "name": "Build one fresh greeting sign and require the complete original plus six new calls",
        "env": {
          "RESOURCE_LANGUAGE": "${{ matrix.language }}"
        },
        "run": "python3 -B tools/replay_embedded_resource_languages.py --language \"$RESOURCE_LANGUAGE\" \\\n  --original \"$RUNNER_TEMP/embedded-original\" --normal-qualification \"$RUNNER_TEMP/embedded-native-normal\" \\\n  --producer-receipt \"$RUNNER_TEMP/embedded-native-producer.json\" --tools \"$RUNNER_TEMP/embedded-tools\" \\\n  --output \"$RUNNER_TEMP/embedded-resources\"\n"
      },
      {
        "name": "Retain bounded public provenance components actual results and failures",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "embedded-resource-${{ matrix.language }}-${{ github.sha }}",
          "retention-days": 3,
          "if-no-files-found": "warn",
          "path": "${{ runner.temp }}/embedded-native-producer.json\n${{ runner.temp }}/embedded-original/acquisition.json\n${{ runner.temp }}/embedded-resources/*.json\n${{ runner.temp }}/embedded-resources/logs/**\n${{ runner.temp }}/embedded-resources/build/*.json\n${{ runner.temp }}/embedded-resources/build/logs/**\n${{ runner.temp }}/embedded-resources/build/component.wasm\n${{ runner.temp }}/embedded-resources/node/workflow.json\n${{ runner.temp }}/embedded-resources/node/FAILED.json\n${{ runner.temp }}/embedded-resources/node/controls/*.json\n"
        }
      }
    ]
  },
  "jobId": "resources",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/embedded-resource-languages-reference.yml"
}
