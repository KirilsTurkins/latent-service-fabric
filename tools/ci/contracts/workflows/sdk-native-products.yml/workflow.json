{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "sdk-native-products-${{ github.ref }}"
    },
    "name": "SDK current native products",
    "on": {
      "push": {
        "branches": [
          "feat/sdk-current-native-products-20261020",
          "diag/sdk-v7-native-products-20261020",
          "feat/http-phase-nominal-semantics-20261020",
          "fix/http-phase-unused-nominal-type-20261020"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "products"
  ],
  "reviewReason": "Retain original native build and thirteen controls; add exact emitted nominal-response omission control and four source-bound final-graph controls, with unchanged budgets and historical obligations.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/sdk-native-products.yml"
}
