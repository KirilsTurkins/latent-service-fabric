    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "products"
  ],
  "reviewReason": "Reviewed exact nominal HTTP phase authority fix: retain all original native-five build, twenty-five Rust and four Python controls, source/material checks, steps and bounds; append two exact-count declared-source metadata and real binding compiler controls.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/sdk-native-products.yml"
}
