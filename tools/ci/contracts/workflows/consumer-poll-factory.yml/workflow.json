{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "consumer-poll-factory-${{ github.ref }}"
    },
    "name": "Consumer poll-factory native ownership",
    "on": {
      "push": {
        "branches": [
          "feat/sdk-745-consumer-poll-factory-20261105"
        ],
        "paths": [
          ".github/workflows/consumer-poll-factory.yml",
          "crates/vendor/wasmtime/**",
          "crates/latent-wasmtime/**",
          "tools/qualify_consumer_poll_factory.py",
          "tools/qualify_stream_outers.py",
          "tools/host_codec_wasmtime.py",
          "tools/ci_rust_artifacts.py",
          "tools/toolchain.toml",
          "Cargo.toml",
          "Cargo.lock",
          "rust-toolchain.toml"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "ownership"
  ],
  "reviewReason": "Limit native consumer-factory checks to the dedicated push branch.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/consumer-poll-factory.yml"
}
