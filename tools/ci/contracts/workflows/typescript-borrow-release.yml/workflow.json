{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "typescript-borrow-release-${{ github.ref }}"
    },
    "name": "TypeScript canonical borrow release controls",
    "on": {
      "push": {
        "branches": [
          "feat/typescript-borrow-release-source-20261024"
        ],
        "paths": [
          ".github/workflows/typescript-borrow-release.yml",
          "tools/qualify_typescript_borrow_release.py",
          "tools/typescript_borrow_splicer_inputs.py",
          "tools/typescript_borrow_retry_inputs.py",
          "tools/typescript_guest/**",
          "tools/tests/test_typescript_import_cancellation.py",
          "tools/tests/test_typescript_borrow_controls.py",
          "tools/tests/test_typescript_borrow_splicer_inputs.py",
          "tools/tests/test_typescript_borrow_retry_inputs.py",
          "tools/tests/test_typescript_borrow_support.py",
          "sdk/typescript-guest/activation/**"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "native-controls"
  ],
  "reviewReason": "Add the two maintained-support source guard test path; same authenticated producer/branch/permissions and no libJS or engine rebuild",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/typescript-borrow-release.yml"
}
