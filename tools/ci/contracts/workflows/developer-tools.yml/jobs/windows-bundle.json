{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Windows candidate inventory and provenance",
    "needs": "windows",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 15,
    "permissions": {
      "contents": "read",
      "id-token": "write",
      "attestations": "write"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "KirilsTurkins/lsf-download-artifact",
        "with": {
          "name": "developer-windows-inputs-${{ github.sha }}",
          "path": "target/windows-input"
        }
      },
      {
        "name": "Assemble Windows candidate using existing dependency inventory owner",
        "run": "python tools/build_dev_bundle.py --frontend target/windows-input --portable target/windows-input/portable/latent-portable-test-host.exe --output target/dev-windows"
      },
      {
        "name": "Attest Windows candidate without release authority",
        "if": "github.event_name != 'pull_request'",
        "id": "attest",
        "uses": "KirilsTurkins/lsf-attest-build-provenance",
        "with": {
          "subject-path": "target/dev-windows/candidate/SHA256SUMS"
        }
      },
      {
        "name": "Retain offline Windows attestation",
        "if": "github.event_name != 'pull_request'",
        "env": {
          "BUNDLE_PATH": "${{ steps.attest.outputs.bundle-path }}"
        },
        "run": "install -m 0644 \"$BUNDLE_PATH\" target/dev-windows/candidate/attestation.json"
      },
      {
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "developer-windows-candidate-${{ github.sha }}",
          "path": "target/dev-windows/candidate/",
          "if-no-files-found": "error",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "windows-bundle",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/developer-tools.yml"
}
