{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "developer-tools-${{ github.ref }}"
    },
    "name": "Developer tools",
    "on": {
      "pull_request": {
        "paths": [
          ".cargo/managed-guest.toml",
          ".github/workflows/developer-tools.yml",
          "tools/dev_workflow/**",
          "tools/latent_dev.py",
          "tools/build_dev_frontend.py",
          "tools/dev_frontend_linux.py",
          "tools/build_dev_bundle.py",
          "tools/build_dev_rootfs.py",
          "tools/build_dev_guest_tools.py",
          "tools/dev_tool_distribution.py",
          "tools/dev_guest_recipe.py",
          "tools/dev_guest_tools.py",
          "tools/dev_managed_*.py",
          "tools/dev_go_distribution.py",
          "tools/dev_typescript_distribution.py",
          "tools/guest_runtime_profiles.py",
          "tools/run_dev_guest_tools_tests.py",
          "tools/static_api_build.py",
          "tools/static_api/**",
          "examples/static-api/**",
          "tools/dev_node_application_probe.py",
          "tools/dev_clock_fixture_probe.py",
          "tools/run_dev_clock_portable.py",
          "tools/dev_failure_fixture_probe.py",
          "tools/run_dev_failure_portable.py",
          "tools/dev_node_fault_probe.py",
          "tools/dev_recovery_fixture_probe.py",
          "tools/run_dev_recovery_ci.py",
          "tools/dev_http_fixture_probe.py",
          "tools/dev_blob_fixture_probe.py",
          "tools/dev_secret_fixture_probe.py",
          "tools/dev_metric_fixture_probe.py",
          "tools/dev_local_service_fixture_probe.py",
          "tools/dev_event_fixture_probe.py",
          "tools/dev_workspace_isolation_probe.py",
          "tools/dev_watch_fixture_probe.py",
          "tools/dev_watch_fixture_inputs.py",
          "tools/dev_watch_inflight.py",
          "tools/dev_watch_revocation.py",
          "tools/run_dev_metric_portable.py",
          "tools/run_dev_http_portable.py",
          "apps/latentd/src/config/**",
          "apps/latentd/Cargo.toml",
          "tools/compare_dev_node_portable.py",
          "tools/run_portable_guest_tests.py",
          "tools/compare_portable_guest_tests.py",
          "tools/c_capsule*.py",
          "tools/c_guest/**",
          "tools/java_capsule*.py",
          "tools/java_guest/**",
          "tools/dotnet_capsule.py",
          "tools/dotnet_guest/**",
          "tools/dotnet_guest_bindings.py",
          "tools/go_capsule*.py",
          "tools/go_guest/**",
          "tools/typescript_capsule.py",
          "tools/typescript_guest/**",
          "tools/rust_capsule*.py",
          "tools/rust_capsule.lock",
          "tools/build_observation.py",
          "tools/toolchain.toml",
          "tools/install_guest_bindgen.py",
          "tools/dev_distribution.py",
          "tools/dev_rootfs_inventory.py",
          "tools/dev_guest_smoke.py",
          "packaging/dev/**",
          "tools/native_runtime_build.py",
          "tools/dev-frontend-windows.lock",
          "tools/dev-frontend-linux.lock",
          "tools/build_process*.py",
          "tools/tests/test_dev_*.py",
          "tools/portable-test-host/**",
          "tools/run_portable_dev_tests.py",
          "tools/portable_dev_provider_tests.py",
          "tools/build_portable_dev_guests.py",
          "tools/build_portable_c_guests.py",
          "tools/run_portable_c_tests.py",
          "tools/build_guest_capsules.py",
          "sdk/rust-guest/**",
          "sdk/c-guest/**",
          "sdk/java-guest/**",
          "sdk/dotnet-guest/**",
          "sdk/go-guest/**",
          "sdk/typescript-guest/**",
          "Cargo.toml",
          "Cargo.lock",
          "crates/**",
          "tools/toolchain-smoke/**",
          "wit/**"
        ]
      },
      "push": {
        "branches": [
          "feat/559-*",
          "!feat/559-preflight-ready",
          "!feat/559-packaged-qualification"
        ],
        "paths-ignore": [
          ".github/workflows/developer-platform-preflight.yml",
          ".github/workflows/developer-packaged-qualification.yml",
          "tools/dev_packaged_*.py",
          "tools/prepare_dev_packaged_probe.py",
          "tools/tests/test_dev_packaged_probe.py",
          "packaging/dev/qualification-trusted-root.jsonl",
          "packaging/dev/qualification.Dockerfile",
          "tools/ci/contracts/**",
          "docs/**"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "contracts",
    "guest-tools",
    "linux-portable",
    "portable-differential",
    "windows",
    "windows-bundle",
    "wsl-image"
  ],
  "reviewReason": "Issue #732: preserve existing developer-tool qualification exclusions for the ownership-local contract directory.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/developer-tools.yml"
}
