{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "resource-tenants-${{ github.ref }}"
    },
    "name": "Same-node resource tenant isolation",
    "on": {
      "push": {
        "branches": [
          "feat/sdk-resource-tenant-isolation-20261020"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "actions": "read",
      "contents": "read"
    }
  },
  "requiredJobs": [
    "tenants"
  ],
  "reviewReason": "Index the new bounded workflow through only its exact owned feature-branch push plus manual dispatch; no original PR/push job or budget changes.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/resource-tenant-isolation.yml"
}
