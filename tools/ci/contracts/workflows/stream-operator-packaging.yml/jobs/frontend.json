{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Stream operator frontend (${{ matrix.os }})",
    "strategy": {
      "fail-fast": false,
      "matrix": {
        "include": [
          {
            "os": "ubuntu-24.04",
            "lock": "tools/dev-frontend-linux.lock"
          },
          {
            "os": "windows-2025",
            "lock": "tools/dev-frontend-windows.lock"
          }
        ]
      }
    },
    "runs-on": "${{ matrix.os }}",
    "timeout-minutes": 12,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install exact hashed frontend and schema-validator inputs",
        "run": "python -m pip install --require-hashes -r \"${{ matrix.lock }}\""
      },
      {
        "name": "Exercise protected preparation and isolated frontend source boundaries",
        "run": "python -B -m unittest tools.tests.test_outbound_stream_preparation tools.tests.test_outbound_stream_operator tools.tests.test_dev_frontend_preflight_packaging tools.tests.test_dev_frontend_native_wheel"
      },
      {
        "name": "Build frozen frontend and execute outside-checkout smoke checks",
        "run": "python tools/build_dev_frontend.py --output target/stream-operator-frontend"
      },
      {
        "name": "Retain actual frontend products and existing source/license inventories",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "stream-operator-frontend-${{ matrix.os }}-${{ github.sha }}",
          "path": "target/stream-operator-frontend/build.json\ntarget/stream-operator-frontend/helper.pyz\ntarget/stream-operator-frontend/python-inventory.json\ntarget/stream-operator-frontend/licenses/\ntarget/stream-operator-frontend/dist/\n",
          "if-no-files-found": "error",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "frontend",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/stream-operator-packaging.yml"
}
