{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "stream-operator-packaging-${{ github.ref }}"
    },
    "name": "Stream operator frontend packaging",
    "on": {
      "push": {
        "branches": [
          "feat/stream-operator-lifecycle-20261023"
        ],
        "paths": [
          ".github/workflows/stream-operator-packaging.yml"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "frontend"
  ],
  "reviewReason": "One explicit feature-owned frontend-only Linux/Windows campaign exercises protected stream preparation and frozen packaging without Cargo, kernels, guests or compiler distributions; permissions and action pins remain exact.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/stream-operator-packaging.yml"
}
