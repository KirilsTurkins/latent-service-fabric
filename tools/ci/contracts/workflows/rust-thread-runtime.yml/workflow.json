{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "rust-original-thread-runtime-${{ github.ref }}"
    },
    "name": "Signed original Rust default ThreadPool progress",
    "on": {
      "push": {
        "branches": [
          "feat/rust-thread-runtime-20261023"
        ],
        "paths": [
          ".github/workflows/rust-thread-runtime.yml"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "actions": "read",
      "contents": "read"
    }
  },
  "requiredJobs": [
    "signed-default-pools"
  ],
  "reviewReason": "Use exact repaired native and compiler evidence for signed ThreadPool execution.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/rust-thread-runtime.yml"
}
