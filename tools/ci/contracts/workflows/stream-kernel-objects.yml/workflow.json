{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "stream-kernel-objects-${{ github.ref }}"
    },
    "name": "Stream maintained kernel object check",
    "on": {
      "push": {
        "branches": [
          "test/stream-kernel-objects-20261021",
          "feat/stream-kernel-netlabel-consumer-20261021",
          "feat/stream-kernel-netport-objects-20261021",
          "feat/stream-kernel-audit-owner-20261021",
          "feat/stream-kernel-avc-consumer-20261021",
          "feat/stream-kernel-audit-skb-20261021",
          "feat/stream-kernel-route-owners-20261021",
          "feat/stream-kernel-route-consumer-20261021",
          "feat/stream-kernel-route-cache-20261021",
          "feat/stream-kernel-packet-prefix-20261021",
          "feat/stream-kernel-device-closure-20261021",
          "feat/stream-kernel-device-setup-20261021",
          "feat/stream-kernel-device-registration-20261021"
        ],
        "paths": [
          ".github/workflows/stream-kernel-objects.yml",
          "tools/qualify_host_stream_kernel_objects.py",
          "tools/host_stream_kernel_protocol.py",
          "tools/host_stream_kernel_netlabel.py",
          "tools/host_stream_kernel_netport.py",
          "tools/host_stream_kernel_sidcache.py",
          "tools/host_stream_kernel_avc.py",
          "tools/host_stream_kernel_audit_skb.py",
          "tools/host_stream_kernel_audit.py",
          "tools/host_stream_kernel_bind.py",
          "tools/host_stream_kernel_route.py",
          "tools/host_stream_kernel_route_cache.py",
          "tools/host_stream_kernel_packet.py",
          "tools/tests/fixtures/host_stream_kernel_packet.json",
          "tools/host_stream_kernel_device.py",
          "tools/tests/fixtures/host_stream_kernel_device.json",
          "tools/host_stream_kernel_device_firmware.py",
          "tools/tests/fixtures/host_stream_kernel_device_firmware.json",
          "tools/host_stream_kernel_device_core.py",
          "tools/tests/fixtures/host_stream_kernel_device_core.json",
          "tools/host_stream_kernel_device_capabilities.py",
          "tools/tests/fixtures/host_stream_kernel_device_capabilities.json",
          "tools/host_stream_kernel_device_registration.py",
          "tools/tests/fixtures/host_stream_kernel_device_registration.json",
          "tools/host_stream_kernel_device_sysfs.py",
          "tools/tests/fixtures/host_stream_kernel_device_sysfs.json",
          "tools/host_stream_kernel_device_uevent.py",
          "tools/tests/fixtures/host_stream_kernel_device_uevent.json",
          "tools/host_stream_kernel_device_uevent_delivery.py",
          "tools/tests/fixtures/host_stream_kernel_device_uevent_delivery.json",
          "research/standard-outbound/linux-6.12-lineage/**"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "audit": {
            "default": false,
            "description": "Compile the closed mandatory audit and SKB source profile",
            "type": "boolean"
          },
          "avc": {
            "default": false,
            "description": "Compile the closed AVC with SID-cache source profile",
            "type": "boolean"
          },
          "bind": {
            "default": false,
            "description": "Compile the closed bind-bucket source profile with mandatory audit",
            "type": "boolean"
          },
          "device": {
            "default": false,
            "description": "Compile the closed NodeFixed PCI birth and constant-name source profile",
            "type": "boolean"
          },
          "firmware": {
            "default": false,
            "description": "Compile the closed cached ACPI companion lifetime source profile",
            "type": "boolean"
          },
          "netlabel": {
            "default": false,
            "description": "Compile the closed nested Netlabel source profile instead of original six objects",
            "type": "boolean"
          },
          "netport": {
            "default": false,
            "description": "Compile the closed Netport cache profile instead of the original object profiles",
            "type": "boolean"
          },
          "packet": {
            "default": false,
            "description": "Compile the closed copied-TCP linear packet source profile",
            "type": "boolean"
          },
          "registration": {
            "default": false,
            "description": "Compile the closed registration sysfs IDR and uevent source-only profile",
            "type": "boolean"
          },
          "route": {
            "default": false,
            "description": "Compile the closed IPv4 route source profile with original reference owners",
            "type": "boolean"
          },
          "route_cache": {
            "default": false,
            "description": "Compile the closed route-cache parent and drain source profile",
            "type": "boolean"
          },
          "sidcache": {
            "default": false,
            "description": "Compile the closed SID-cache and audit-string source profile",
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "audit-objects",
    "avc-objects",
    "bind-objects",
    "device-objects",
    "firmware-objects",
    "netlabel-objects",
    "netport-objects",
    "packet-objects",
    "registration-objects",
    "route-cache-objects",
    "route-objects",
    "selected-objects",
    "sidcache-objects"
  ],
  "reviewReason": "Reviewed grouped uninstalled PCI registration sysfs IDR and uevent consumers; exclusive48object/201function compile retains all prior profiles commands cases security and original bounds; no runtime physical closure link boot or installation qualification",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/stream-kernel-objects.yml"
}
