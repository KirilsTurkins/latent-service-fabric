{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "stream-kernel-objects-${{ github.ref }}"
    },
    "name": "Stream maintained kernel object check",
    "on": {
      "push": {
        "branches": [
          "test/stream-kernel-objects-20261021",
          "feat/stream-kernel-netlabel-consumer-20261021",
          "feat/stream-kernel-netport-objects-20261021",
          "feat/stream-kernel-audit-owner-20261021",
          "feat/stream-kernel-avc-consumer-20261021",
          "feat/stream-kernel-audit-skb-20261021",
          "feat/stream-kernel-route-owners-20261021",
          "feat/stream-kernel-route-consumer-20261021"
        ],
        "paths": [
          ".github/workflows/stream-kernel-objects.yml",
          "tools/qualify_host_stream_kernel_objects.py",
          "tools/host_stream_kernel_protocol.py",
          "tools/host_stream_kernel_netlabel.py",
          "tools/host_stream_kernel_netport.py",
          "tools/host_stream_kernel_sidcache.py",
          "tools/host_stream_kernel_avc.py",
          "tools/host_stream_kernel_audit_skb.py",
          "tools/host_stream_kernel_audit.py",
          "tools/host_stream_kernel_bind.py",
          "tools/host_stream_kernel_route.py",
          "research/standard-outbound/linux-6.12-lineage/**"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "audit": {
            "default": false,
            "description": "Compile the closed mandatory audit and SKB source profile",
            "type": "boolean"
          },
          "avc": {
            "default": false,
            "description": "Compile the closed AVC with SID-cache source profile",
            "type": "boolean"
          },
          "bind": {
            "default": false,
            "description": "Compile the closed bind-bucket source profile with mandatory audit",
            "type": "boolean"
          },
          "netlabel": {
            "default": false,
            "description": "Compile the closed nested Netlabel source profile instead of original six objects",
            "type": "boolean"
          },
          "netport": {
            "default": false,
            "description": "Compile the closed Netport cache profile instead of the original object profiles",
            "type": "boolean"
          },
          "route": {
            "default": false,
            "description": "Compile the closed IPv4 route source profile with original reference owners",
            "type": "boolean"
          },
          "sidcache": {
            "default": false,
            "description": "Compile the closed SID-cache and audit-string source profile",
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "audit-objects",
    "avc-objects",
    "bind-objects",
    "netlabel-objects",
    "netport-objects",
    "route-objects",
    "selected-objects",
    "sidcache-objects"
  ],
  "reviewReason": "Add one exclusive route object-only lane preserving all seven previous job bodies, 22 objects and75 global oracles, every original case/guard and original config/runtime/diagnostic bounds. No kernel link, boot, execution or installation qualification.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/stream-kernel-objects.yml"
}
