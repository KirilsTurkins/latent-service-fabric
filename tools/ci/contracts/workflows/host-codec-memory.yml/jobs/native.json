{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "Original ledger shared tables and runtime memory ownership diagnostics",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "actions/setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "Swatinem/rust-cache",
        "with": {
          "cache-all-crates": false,
          "cache-bin": false,
          "cache-on-failure": false,
          "cache-targets": true,
          "cache-workspace-crates": false,
          "key": "ubuntu-24.04",
          "prefix-key": "lsf-ci-dependencies-v2",
          "save-if": false,
          "shared-key": "host-correctness"
        }
      },
      {
        "name": "Install existing locked Python dependencies",
        "run": "python3 -m pip install -r tools/requirements.lock"
      },
      {
        "name": "Refuse missing, ignored or changed control evidence",
        "run": "python3 -B -m unittest tools.tests.test_host_codec_native -v"
      },
      {
        "id": "own-native-memory",
        "name": "Execute one hundred seventy-two source-bound controls with the ordinary native host",
        "run": "python3 -B tools/qualify_host_codec_native.py --source-commit \"${{ github.sha }}\" --output \"$RUNNER_TEMP/host-codec-memory\""
      },
      {
        "if": "always()",
        "name": "Retain exact source, products, outcomes and bounded failure logs",
        "uses": "actions/upload-artifact",
        "with": {
          "if-no-files-found": "warn",
          "name": "host-codec-memory-${{ github.sha }}",
          "path": "${{ runner.temp }}/host-codec-memory/",
          "retention-days": 7
        }
      }
    ],
    "timeout-minutes": 25
  },
  "jobId": "native",
  "kind": "job",
  "reviewReason": "Keep the same finite native recipe and five host products while selecting exactly172 original-budget and C ABI controls",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/host-codec-memory.yml"
}
