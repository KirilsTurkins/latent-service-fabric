{"definition":{"name":"RustSec current change","runs-on":"ubuntu-24.04","steps":[{"name":"Check out scanner controls","uses":"KirilsTurkins/lsf-checkout","with":{"path":"controls","persist-credentials":false,"ref":"${{ inputs.controls-ref }}"}},{"name":"Check out scan input, never execute it","uses":"KirilsTurkins/lsf-checkout","with":{"path":"source","persist-credentials":false,"ref":"${{ inputs.source-ref }}"}},{"env":{"GH_TOKEN":"${{ github.event_name == 'push' && github.ref == 'refs/heads/development' && github.token || '' }}"},"name":"Install digest-pinned cargo-audit outside the input checkout","run":"python3 controls/tools/security_install.py --tool cargo-audit --destination \"$RUNNER_TEMP/security-tools\""},{"name":"Audit the unchanged or changed resolved lockfile against fresh RustSec data","run":"python3 controls/tools/security_scan.py rustsec --repo source --tools \"$RUNNER_TEMP/security-tools\" --scratch \"$RUNNER_TEMP/security-scan\""}],"timeout-minutes":8},"jobId":"audit","kind":"job","reviewReason":"Scope the credential to the exact pinned cargo-audit installer only on development push; retain the independently reviewed scanner and scan input.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/security-rustsec.yml"}
