{
  "kind": "workflow",
  "policy": {
    "name": "Phase 1 controlled comparison",
    "on": {
      "workflow_dispatch": {
        "inputs": {
          "profile": {
            "default": "smoke",
            "description": "Smoke validates one small pair; full collects seven independent pairs",
            "options": [
              "smoke",
              "full"
            ],
            "type": "choice"
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "comparison"
  ],
  "reviewReason": "Lossless sharding of the reviewed v1 inventory; owner fingerprints remain enforced.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/phase1-controlled-comparison.yml"
}
