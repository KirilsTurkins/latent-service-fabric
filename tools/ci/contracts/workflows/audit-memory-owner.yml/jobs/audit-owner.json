{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Twenty-five original audit payload and node owner controls",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 25,
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "KirilsTurkins/lsf-rust-cache",
        "with": {
          "prefix-key": "lsf-ci-dependencies-v2",
          "shared-key": "host-correctness",
          "key": "ubuntu-24.04",
          "cache-targets": true,
          "cache-bin": false,
          "cache-workspace-crates": false,
          "cache-all-crates": false,
          "cache-on-failure": false,
          "save-if": false
        }
      },
      {
        "name": "Install locked Python dependencies",
        "run": "python3 -m pip install -r tools/requirements.lock"
      },
      {
        "name": "Refuse altered controls or discarded prebuild failures",
        "run": "python3 -B -m unittest tools.tests.test_audit_memory_programme -v"
      },
      {
        "name": "Execute only the selected audit owner controls and compile changed consumers",
        "run": "python3 -B tools/qualify_audit_memory.py --source-commit \"${{ github.sha }}\" --output \"$RUNNER_TEMP/audit-memory-owner\""
      },
      {
        "name": "Retain exact source inputs and bounded actual compiler/control failures",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "audit-memory-owner-${{ github.sha }}",
          "path": "${{ runner.temp }}/audit-memory-owner/",
          "if-no-files-found": "error",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "audit-owner",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/audit-memory-owner.yml"
}
