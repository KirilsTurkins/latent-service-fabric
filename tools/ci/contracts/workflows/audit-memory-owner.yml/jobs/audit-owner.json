{"baselineRevision":"50f003dd006e0786494936c49e55dc683cf26fd6","before":{},"coverage":{},"definition":{"env":{"CARGO_BUILD_JOBS":"2","CARGO_INCREMENTAL":"0","PYTHONDONTWRITEBYTECODE":"1"},"name":"Twenty-five original audit payload and node owner controls","runs-on":"ubuntu-24.04","steps":[{"uses":"KirilsTurkins/lsf-checkout","with":{"persist-credentials":false}},{"uses":"KirilsTurkins/lsf-setup-python","with":{"python-version":"3.13.5"}},{"uses":"dtolnay/rust-toolchain"},{"uses":"KirilsTurkins/lsf-rust-cache","with":{"cache-all-crates":false,"cache-bin":false,"cache-on-failure":false,"cache-targets":true,"cache-workspace-crates":false,"key":"ubuntu-24.04","prefix-key":"lsf-ci-dependencies-v2","save-if":false,"shared-key":"host-correctness"}},{"name":"Install locked Python dependencies","run":"python3 -m pip install -r tools/requirements.lock"},{"name":"Refuse altered controls or discarded prebuild failures","run":"python3 -B -m unittest tools.tests.test_audit_memory_programme -v"},{"name":"Execute only the selected audit owner controls and compile changed consumers","run":"python3 -B tools/qualify_audit_memory.py --source-commit \"${{ github.sha }}\" --output \"$RUNNER_TEMP/audit-memory-owner\""},{"if":"always()","name":"Retain exact source inputs and bounded actual compiler/control failures","uses":"KirilsTurkins/lsf-upload-artifact","with":{"if-no-files-found":"error","name":"audit-memory-owner-${{ github.sha }}","path":"${{ runner.temp }}/audit-memory-owner/","retention-days":7}}],"timeout-minutes":25},"jobId":"audit-owner","kind":"job","reviewReason":"Execute only25 new exact libtest controls including actual ack-admission terminal repair, compiler-check changed RPC/CLI/node consumers; no193-suite, guest, std or five-product rebuild.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/audit-memory-owner.yml"}
