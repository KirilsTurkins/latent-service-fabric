{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Current Rust types and six original-owner controls",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 25,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install normal pinned validator dependencies",
        "run": "python3 -m pip install --requirement tools/requirements.lock"
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "KirilsTurkins/lsf-rust-cache",
        "with": {
          "prefix-key": "lsf-ci-dependencies-v2",
          "shared-key": "host-correctness",
          "key": "ubuntu-24.04",
          "cache-bin": false,
          "cache-workspace-crates": false,
          "cache-targets": true
        }
      },
      {
        "name": "Refuse incomplete or ignored focused outcomes",
        "run": "python3 -B -m unittest tools.tests.test_host_stream_protected -v"
      },
      {
        "name": "Compile current source and execute exactly six host controls",
        "run": "python3 -B tools/qualify_host_stream_protected.py --source-commit \"${{ github.sha }}\" --output \"$RUNNER_TEMP/protected-stream-host\""
      },
      {
        "name": "Retain only finite public command channels and receipt",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "protected-stream-host-${{ github.sha }}",
          "path": "${{ runner.temp }}/protected-stream-host/receipt.json\n${{ runner.temp }}/protected-stream-host/*.stdout.log\n${{ runner.temp }}/protected-stream-host/*.stderr.log\n",
          "if-no-files-found": "warn",
          "retention-days": 3
        }
      }
    ]
  },
  "jobId": "host-controls",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/protected-stream-host.yml"
}
