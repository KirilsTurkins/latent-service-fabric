{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Packaged rotation candidate and actual277 configuration checks",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 12,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install only exact frontend inputs",
        "run": "python -m pip install --require-hashes -r tools/dev-frontend-linux.lock"
      },
      {
        "name": "Exercise new rotation and affected shared preparation controls",
        "run": "python -B -m unittest tools.tests.test_outbound_stream_rotation tools.tests.test_outbound_stream_preparation.StreamPreparation"
      },
      {
        "name": "Build only the current frozen Python frontend",
        "run": "python -B tools/build_dev_frontend.py --output target/stream-rotation-frontend"
      },
      {
        "name": "Fetch the existing node's immutable source closure",
        "run": "git fetch --depth=1 origin 277c8104499d414053573bce066b5e9091e74a20"
      },
      {
        "name": "Observe the actual packaged command with the authenticated original node",
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "run": "python -B tools/qualify_stream_operator_rotation.py --frontend-root target/stream-rotation-frontend --output target/stream-rotation-node-check"
      },
      {
        "name": "Retain only frontend products and redacted public outcomes",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "stream-operator-rotation-${{ github.sha }}",
          "path": "target/stream-rotation-frontend/build.json\ntarget/stream-rotation-frontend/helper.pyz\ntarget/stream-rotation-frontend/python-inventory.json\ntarget/stream-rotation-frontend/licenses/\ntarget/stream-rotation-frontend/dist/\ntarget/stream-rotation-node-check/result.json\n",
          "if-no-files-found": "error",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "rotation",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/stream-operator-rotation.yml"
}
