{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "c-guest-authoring-${{ github.ref }}"
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "C guest authoring",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/c-guest/**",
          "sdk/transaction-contract/**",
          "tools/**",
          "crates/**",
          "wit/**",
          "schemas/**",
          "Cargo.*",
          "docs/component-development/c-authoring.md",
          ".github/workflows/c-guest-authoring.yml"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/c-guest/**",
          "sdk/transaction-contract/**",
          "tools/**",
          "crates/**",
          "wit/**",
          "schemas/**",
          "Cargo.*",
          "docs/component-development/c-authoring.md",
          ".github/workflows/c-guest-authoring.yml"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "runtime"
  ],
  "reviewReason": "Preserve both original workflow obligations, required jobs, compiler/isolation flags, original time limits and failure artifacts while combining Phase4 transaction authoring with current development dependency/runtime support.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/c-guest-authoring.yml"
}
