{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "c-guest-authoring-${{ github.ref }}"
    },
    "name": "C guest authoring",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/c-guest/**",
          "sdk/transaction-contract/**",
          "tools/**",
          "crates/**",
          "wit/**",
          "schemas/**",
          "Cargo.*",
          "docs/component-development/c-authoring.md",
          ".github/workflows/c-guest-authoring.yml"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/c-guest/**",
          "sdk/transaction-contract/**",
          "tools/**",
          "crates/**",
          "wit/**",
          "schemas/**",
          "Cargo.*",
          "docs/component-development/c-authoring.md",
          ".github/workflows/c-guest-authoring.yml"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "runtime"
  ],
  "reviewReason": "Build both real authored transaction variants with existing exact compiler pins and retain bounded source, recipe, binding and failure artifacts without claiming node execution",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/c-guest-authoring.yml"
}
