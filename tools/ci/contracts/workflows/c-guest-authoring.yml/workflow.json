{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "c-guest-authoring-${{ github.ref }}"
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "C guest authoring",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/c-guest/**",
          "sdk/transaction-contract/**",
          "tools/**",
          "crates/**",
          "wit/**",
          "schemas/**",
          "Cargo.*",
          "docs/component-development/c-authoring.md",
          ".github/workflows/c-guest-authoring.yml"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/c-guest/**",
          "sdk/transaction-contract/**",
          "tools/**",
          "crates/**",
          "wit/**",
          "schemas/**",
          "Cargo.*",
          "docs/component-development/c-authoring.md",
          ".github/workflows/c-guest-authoring.yml"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "qualify-scratch-refusals": {
            "default": false,
            "description": "Run the original normal C qualification and same-products scratch child",
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "runtime",
    "scratch-refusals",
    "standard-facilities"
  ],
  "reviewReason": "Add explicit default-false manual scratch selection retaining mandatory original runtime35 and new same-products child20; skip only unchanged extra standards25 on that manual selection, with all PR/push/default jobs and commands preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/c-guest-authoring.yml"
}
