{
"kind":"workflow",
"policy":{
"concurrency":{
"cancel-in-progress":false,
"group":"java-dependency-checkpoints-${{ github.ref }}"
},
"name":"Java published dependency checkpoints",
"on":{
"push":{
"branches":[
"feat/java-runtime-next-20261023"
],
"paths":[
"tools/fixtures/java-dependency-checkpoints/**",
"tools/java_dependency_checkpoint_*.py",
"tools/qualify_java_dependency_checkpoints.py",
"tools/tests/test_java_dependency_checkpoints.py",
"sdk/java-guest/fibers/conformance/compiler/DependencyCheckpointControl.java",
".github/workflows/java-dependency-checkpoints.yml"
]
},
"workflow_dispatch":{
"inputs":{
"native-origin":{
"default":"current",
"description":"Native products for the six signed checkpoint calls",
"options":[
"current",
"historical"
],
"required":true,
"type":"choice"
}
}
}
},
"permissions":{
"actions":"read",
"contents":"read"
}
},
"requiredJobs":[
"dependency-checkpoints"
],
"reviewReason":"Run the original six signed calls with either the current five ordinary products or the authenticated historical five products.",
"schemaVersion":"latent.ci.contracts.v1",
"workflow":".github/workflows/java-dependency-checkpoints.yml"
}
