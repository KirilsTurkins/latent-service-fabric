  },
  "definition": {
    "name": "Phase 1 ${{ inputs.profile }} ${{ matrix.kind }}",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 360,
    "strategy": {
      "fail-fast": false,
      "matrix": {
        "kind": "${{ fromJSON(inputs.kind == 'all' && '[\"scale\",\"soak\",\"benchmark\"]' || format('[\"{0}\"]', inputs.kind)) }}"
      }
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "fetch-depth": 0,
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5",
          "cache": "pip",
          "cache-dependency-path": "tools/requirements.lock"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain",
        "with": {
          "targets": "wasm32-wasip2,wasm32-unknown-unknown"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-bytecodealliance-actions/wasm-tools/setup",
        "with": {
          "version": "1.254.0"
        }
      },
      {
        "name": "Install validator dependencies",
        "run": "python -m pip install --requirement tools/requirements.lock"
      },
      {
        "name": "Build required guest fixtures",
        "run": "unset CARGO_INCREMENTAL\nbash tools/build_phase1_measurement_fixtures.sh\n"
      },
      {
        "name": "Run measurements with bounded owned collectors",
        "env": {
          "MEASUREMENT_PROFILE": "${{ inputs.profile }}",
          "MEASUREMENT_KIND": "${{ matrix.kind }}"
        },
        "run": "unset CARGO_INCREMENTAL\npython3 tools/run_phase1_measurements.py --profile \"$MEASUREMENT_PROFILE\" --kind \"$MEASUREMENT_KIND\"\n"
      },
      {
        "name": "Retain measurements and failure diagnostics",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "phase1-${{ inputs.profile }}-${{ matrix.kind }}-${{ github.sha }}",
          "path": "target/phase1-measurements/",
          "if-no-files-found": "warn",
          "retention-days": 30
        }
      }
    ]
  },
  "jobId": "measurements",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/phase1-measurements.yml"
}
