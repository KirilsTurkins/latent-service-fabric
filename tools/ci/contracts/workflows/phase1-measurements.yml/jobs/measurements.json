{"definition":{"name":"Phase 1 ${{ inputs.profile }} ${{ matrix.kind }}","runs-on":"ubuntu-24.04","steps":[{"uses":"KirilsTurkins/lsf-checkout","with":{"fetch-depth":0,"persist-credentials":false}},{"uses":"KirilsTurkins/lsf-setup-python","with":{"cache":"pip","cache-dependency-path":"tools/requirements.lock","python-version":"3.13.5"}},{"uses":"dtolnay/rust-toolchain","with":{"targets":"wasm32-wasip2,wasm32-unknown-unknown"}},{"uses":"KirilsTurkins/lsf-bytecodealliance-actions/wasm-tools/setup","with":{"version":"1.254.0"}},{"name":"Install validator dependencies","run":"python -m pip install --requirement tools/requirements.lock"},{"name":"Build required guest fixtures","run":"unset CARGO_INCREMENTAL\nbash tools/build_phase1_measurement_fixtures.sh\n"},{"env":{"MEASUREMENT_KIND":"${{ matrix.kind }}","MEASUREMENT_PROFILE":"${{ inputs.profile }}"},"name":"Run measurements with bounded owned collectors","run":"unset CARGO_INCREMENTAL\npython3 tools/run_phase1_measurements.py --profile \"$MEASUREMENT_PROFILE\" --kind \"$MEASUREMENT_KIND\"\n"},{"if":"always()","name":"Retain measurements and failure diagnostics","uses":"KirilsTurkins/lsf-upload-artifact","with":{"if-no-files-found":"warn","name":"phase1-${{ inputs.profile }}-${{ matrix.kind }}-${{ github.sha }}","path":"target/phase1-measurements/","retention-days":30}}],"strategy":{"fail-fast":false,"matrix":{"kind":"${{ fromJSON(inputs.kind == 'all' && '[\"scale\",\"soak\",\"benchmark\"]' || format('[\"{0}\"]', inputs.kind)) }}"}},"timeout-minutes":360},"jobId":"measurements","kind":"job","reviewReason":"Lossless sharding of the reviewed v1 inventory; owner fingerprints remain enforced.","schemaVersion":"latent.ci.contracts.v1","workflow":".github/workflows/phase1-measurements.yml"}
