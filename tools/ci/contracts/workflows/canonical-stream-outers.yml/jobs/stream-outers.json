{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "Five consumer implementation and two public HostReady controls",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "actions/setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "Swatinem/rust-cache",
        "with": {
          "cache-all-crates": false,
          "cache-bin": false,
          "cache-directories": "target/debug\ntarget/release\ntarget/wasm32-unknown-unknown\ntarget/wasm32-wasip2\n",
          "cache-on-failure": false,
          "cache-targets": false,
          "cache-workspace-crates": false,
          "key": "ubuntu-24.04",
          "prefix-key": "lsf-ci-dependencies-v3-contract-profiles",
          "save-if": false,
          "shared-key": "host-contracts"
        }
      },
      {
        "uses": "bytecodealliance/actions/wasm-tools/setup",
        "with": {
          "version": "1.254.0"
        }
      },
      {
        "name": "Execute only seven consumer cell ownership controls",
        "run": "python3 -B tools/qualify_stream_outers.py --source-commit \"${{ github.sha }}\" --consumer-cell --output \"$RUNNER_TEMP/canonical-stream-outers\""
      },
      {
        "if": "always()",
        "name": "Retain seven source-bound consumer cell outcomes",
        "uses": "actions/upload-artifact",
        "with": {
          "if-no-files-found": "warn",
          "name": "canonical-consumer-cells-${{ github.sha }}",
          "path": "${{ runner.temp }}/canonical-stream-outers/receipt.json\n${{ runner.temp }}/canonical-stream-outers/FAILED.json\n${{ runner.temp }}/canonical-stream-outers/source-inputs.json\n${{ runner.temp }}/canonical-stream-outers/commands.json\n${{ runner.temp }}/canonical-stream-outers/commands/logs/*.txt\n",
          "retention-days": 3
        }
      }
    ],
    "timeout-minutes": 45
  },
  "jobId": "stream-outers",
  "kind": "job",
  "reviewReason": "Reviewed #736 consumer-cell v18: five finite private implementation counters plus two affected public HostReady cases;18 commands/36 raw channels, unchanged two locked Cargo targets/features/45m2400/900/60/30/cleanup5/j2. No WAT/old canonical4/stream6/cache replay. Existing stream/cache function sources exact; completed cache programme deliberately replaced only in this branch-owned workflow. Mandatory14-file isolated-workspace cache auth retained.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/canonical-stream-outers.yml"
}
