{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "Four borrowed HTTP metadata controls",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "KirilsTurkins/lsf-rust-cache",
        "with": {
          "cache-all-crates": false,
          "cache-bin": false,
          "cache-directories": "target/debug\ntarget/release\ntarget/wasm32-unknown-unknown\ntarget/wasm32-wasip2\n",
          "cache-on-failure": false,
          "cache-targets": false,
          "cache-workspace-crates": false,
          "key": "ubuntu-24.04",
          "prefix-key": "lsf-ci-dependencies-v3-contract-profiles",
          "save-if": false,
          "shared-key": "host-contracts"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-bytecodealliance-actions/wasm-tools/setup",
        "with": {
          "version": "1.254.0"
        }
      },
      {
        "name": "Build two exact targets and execute four HTTP metadata controls",
        "run": "python3 -B tools/qualify_stream_outers.py --source-commit \"${{ github.sha }}\" --http-metadata --output \"$RUNNER_TEMP/canonical-stream-outers\""
      },
      {
        "if": "always()",
        "name": "Retain four source-bound HTTP metadata outcomes",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "if-no-files-found": "warn",
          "name": "borrowed-http-metadata-${{ github.sha }}",
          "path": "${{ runner.temp }}/canonical-stream-outers/receipt.json\n${{ runner.temp }}/canonical-stream-outers/FAILED.json\n${{ runner.temp }}/canonical-stream-outers/source-inputs.json\n${{ runner.temp }}/canonical-stream-outers/commands.json\n${{ runner.temp }}/canonical-stream-outers/commands/logs/*.txt\n",
          "retention-days": 3
        }
      }
    ],
    "timeout-minutes": 45
  },
  "jobId": "stream-outers",
  "kind": "job",
  "reviewReason": "Reviewed #736 source-owned HTTP policy/digest allocation removal. Borrow existing ResourceTarget grammar without JSON Value/serialized Vec/owned ResourceRequest and stream the original bounded length-framed digest without a temporary parts Vec. Exact original predicates, sealed policy/admission, redirect one-slot ownership, all old modes, 275/cache14 and grants remain. Four exact ordinary controls (two NEW semantic/golden/bounds controls plus existing redirect/managed component); two locked targets,12commands24raw, original job/process/cleanup/log/source caps. Semantic controls have no ActivationBudget claim. Opaque Url/IDNA/IP formatter/origin/redirect/wire/control/TLS/transitive costs remain explicit gaps. Old ten-case CLI retains selectors/oracles with necessary exact registry84-to86 refresh; no old programme replay.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/canonical-stream-outers.yml"
}
