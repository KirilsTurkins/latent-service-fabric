{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "Ten HTTP-input and canonical string controls",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "KirilsTurkins/lsf-rust-cache",
        "with": {
          "cache-all-crates": false,
          "cache-bin": false,
          "cache-directories": "target/debug\ntarget/release\ntarget/wasm32-unknown-unknown\ntarget/wasm32-wasip2\n",
          "cache-on-failure": false,
          "cache-targets": false,
          "cache-workspace-crates": false,
          "key": "ubuntu-24.04",
          "prefix-key": "lsf-ci-dependencies-v3-contract-profiles",
          "save-if": false,
          "shared-key": "host-contracts"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-bytecodealliance-actions/wasm-tools/setup",
        "with": {
          "version": "1.254.0"
        }
      },
      {
        "name": "Build two exact targets and execute ten HTTP-input controls",
        "run": "python3 -B tools/qualify_stream_outers.py --source-commit \"${{ github.sha }}\" --http-input --output \"$RUNNER_TEMP/canonical-stream-outers\""
      },
      {
        "if": "always()",
        "name": "Retain ten source-bound HTTP and canonical API outcomes",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "if-no-files-found": "warn",
          "name": "prepaid-http-input-${{ github.sha }}",
          "path": "${{ runner.temp }}/canonical-stream-outers/receipt.json\n${{ runner.temp }}/canonical-stream-outers/FAILED.json\n${{ runner.temp }}/canonical-stream-outers/source-inputs.json\n${{ runner.temp }}/canonical-stream-outers/commands.json\n${{ runner.temp }}/canonical-stream-outers/commands/logs/*.txt\n",
          "retention-days": 3
        }
      }
    ],
    "timeout-minutes": 45
  },
  "jobId": "stream-outers",
  "kind": "job",
  "reviewReason": "Reviewed #736 buffered HTTP ingress and public same-Store canonical string view. Ten exact ordinary cases: six native original-session ingress controls, one unchanged preallocated API reference, two public canonical API encoding/Store controls and one unchanged installed managed HTTP case. Two locked test targets,24commands48raw; all original job/process/grant/log/source caps and old owner modes remain unchanged. No vendor-private unit, Blob, language or cache programme replay; parser/HeaderMap/redirect/TLS/control/transitive allocations remain explicit unpaid scopes. Source-only pending the bounded owning programme.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/canonical-stream-outers.yml"
}
