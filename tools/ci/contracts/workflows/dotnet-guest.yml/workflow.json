{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "dotnet-guest-${{ github.ref }}"
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": ".NET guest qualification",
    "on": {
      "pull_request": {
        "paths": [
          "sdk/dotnet-guest/**",
          "sdk/transaction-contract/**",
          "tools/qualify_transaction_contracts.py",
          "tools/compile_transaction_guests.py",
          "tools/transaction_guest_project.py",
          "tools/transaction_guest_variants.py",
          "tools/tests/test_transaction_guest_authoring.py",
          "tools/tests/test_transaction_guest_compilers.py",
          "examples/rust-capsules/transactional-aggregate/**",
          "tools/dotnet_guest*",
          "tools/dotnet_guest/**",
          "examples/dotnet-standard-http/**",
          "tools/dotnet_standard_http*.py",
          "tools/dotnet_internal_io_port.py",
          "tools/qualify_dotnet_standard_http.py",
          "tools/dotnet_standard_entropy*.py",
          "tools/qualify_dotnet_standard_entropy.py",
          "tools/dotnet_task_runtime*.py",
          "tools/qualify_dotnet_task_runtime.py",
          "tools/tests/test_dotnet_task_runtime.py",
          "tools/tests/test_dotnet_secure_entropy.py",
          "tools/tests/test_dotnet_managed_entropy.py",
          "tools/dotnet_standard_console*.py",
          "tools/qualify_dotnet_standard_console.py",
          "tools/tests/test_dotnet_standard_console.py",
          "docs/component-development/dotnet-standard-console.md",
          "tools/standard_http/**",
          "tools/dotnet_capsule.py",
          "tools/dotnet_application_dependencies.py",
          "tools/dotnet_registry_tls.py",
          "tools/dotnet_private_feed_fixture.py",
          "tools/qualify_dotnet_private_dependencies.py",
          "tools/tests/test_dotnet_private_feeds.py",
          "tools/tests/test_dotnet_private_lifecycle.py",
          "tools/tests/fixtures/nuget-public-ca.pem",
          "docs/testing/dotnet-private-feed-lifecycle.md",
          "tools/dotnet_dependency_authoring.py",
          "tools/dotnet_dependency_fixture.py",
          "tools/dotnet_dependency_recovery.py",
          "tools/dotnet_reflection_fixture.py",
          "tools/qualify_dotnet_reflection.py",
          "tools/qualify_dotnet_reflection_boundaries.py",
          "tools/dotnet_catalogue_free_build.py",
          "tools/tests/test_dotnet_reflection_boundaries.py",
          "docs/testing/dotnet-reflection-boundaries.md",
          "tools/tests/test_dotnet_reflection.py",
          "docs/testing/dotnet-reflection-qualification.md",
          "tools/tests/test_dotnet_dependency_recovery.py",
          "tools/dotnet_compiler_isolation.py",
          "tools/application_dependenc*.py",
          "tools/captured_compiler_isolation.py",
          "tools/*dotnet*guest*capsules.py",
          "tools/*dotnet_capsule*.py",
          "tools/*rust_capsule*.py",
          "tools/guest_runtime_grants.py",
          "tools/wait_capsule_audit_idle.py",
          "tools/tests/test_dotnet_capsule_authoring.py",
          "tools/tests/test_dotnet_http_errors.py",
          "tools/probe_dotnet_http_errors.py",
          "tools/tests/test_dotnet_application_dependencies.py",
          "tools/tests/test_dotnet_dependency_authoring.py",
          "docs/component-development/dotnet-authoring.md",
          "docs/component-development/dotnet-dependencies.md",
          "crates/latent-signing/**",
          "crates/latent-packaging/**",
          "crates/latent-policy/**",
          "apps/latentd/**",
          ".cargo/managed-guest.toml",
          "tools/toolchain-smoke/**",
          "wit/**",
          "crates/latent-wasmtime/**",
          ".github/workflows/dotnet-guest.yml"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "install_tools_diagnostic": {
            "default": false,
            "description": "Run only the unchanged failed scratch tool installer and retain its bounded diagnostics",
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "published-tasks",
    "scratch-refusals",
    "tool-install-diagnostic",
    "toolchain"
  ],
  "reviewReason": "Reviewed explicit default-false manual installer-only diagnostic. The seven scratch setup/install steps are exact copies; all original workflow fields restore after removing only the input, new job and exact normal-toolchain manual exclusion. No guest/native host/AOT programme, target setup, compiler arguments, original commands, budgets or upload paths change. Retain bounded existing public installer streams to determine the original unknown closed-runtime-compile failure.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/dotnet-guest.yml"
}
