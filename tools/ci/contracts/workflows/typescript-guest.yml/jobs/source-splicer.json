{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "if": "${{ !inputs.observe-failed-fetch && !inputs.observe-fetch-boundaries && !inputs.replay-entropy-policy && !inputs.qualify-standard-clocks && !inputs.qualify-scratch-refusals }}",
    "name": "Source-owned asynchronous import compiler",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "actions/setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "actions/setup-node",
        "with": {
          "node-version": "24.19.0"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain",
        "with": {
          "targets": "wasm32-wasip1"
        }
      },
      {
        "name": "Check compiler closure ownership and source-splicer input identities",
        "run": "python3 -m unittest tools.tests.test_typescript_splicer_build tools.tests.test_typescript_splicer_input tools.tests.test_typescript_import_source -v"
      },
      {
        "name": "Install the original locked compiler namespace",
        "run": "python3 tools/typescript_capsule.py install-tools \"$RUNNER_TEMP/typescript-splicer-tools\""
      },
      {
        "name": "Compile and transpile the actual derived source splicer",
        "run": "python3 tools/build_typescript_source_splicer.py --tools \"$RUNNER_TEMP/typescript-splicer-tools\" --output \"$RUNNER_TEMP/typescript-source-splicer\""
      },
      {
        "name": "Freeze reusable source compiler products",
        "uses": "actions/upload-artifact",
        "with": {
          "if-no-files-found": "error",
          "name": "typescript-source-splicer-input-${{ github.sha }}",
          "path": "${{ runner.temp }}/typescript-source-splicer/*.json\n${{ runner.temp }}/typescript-source-splicer/splicer/**\n${{ runner.temp }}/typescript-source-splicer/licenses/**\n",
          "retention-days": 7
        }
      },
      {
        "if": "always()",
        "name": "Retain actual source compiler products and failed attempts",
        "uses": "actions/upload-artifact",
        "with": {
          "if-no-files-found": "error",
          "name": "typescript-source-splicer-${{ github.sha }}",
          "path": "tools/ci/contracts/\n${{ runner.temp }}/typescript-source-splicer/*.json\n${{ runner.temp }}/typescript-source-splicer/*.log\n${{ runner.temp }}/typescript-source-splicer/componentize.archive\n${{ runner.temp }}/typescript-source-splicer/spidermonkey-embedding-splicer.wasm\n${{ runner.temp }}/typescript-source-splicer/splicer/**\n${{ runner.temp }}/typescript-source-splicer/licenses/**\n",
          "retention-days": 7
        }
      }
    ],
    "timeout-minutes": 20
  },
  "jobId": "source-splicer",
  "kind": "job",
  "reviewReason": "Add only a default-false manual three-case captured node:fs refusal job using authenticated historical contracts/package tools, preserving all existing language commands, budgets and original native attribution.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/typescript-guest.yml"
}
