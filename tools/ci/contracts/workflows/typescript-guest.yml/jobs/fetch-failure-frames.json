{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "if": "${{ github.event_name == 'workflow_dispatch' && inputs.observe-failed-fetch }}",
    "name": "Private numeric frames for the authenticated failed Fetch component",
    "permissions": {
      "actions": "read",
      "contents": "read"
    },
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "actions/setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install the existing locked Python source-control dependencies",
        "run": "python3 -m pip install -r tools/requirements.lock"
      },
      {
        "name": "Check bounded replay, package restoration and numeric frame controls",
        "run": "python3 -m unittest tools.tests.test_typescript_fetch_frames -v"
      },
      {
        "name": "Preserve the reviewed observer outside the original source checkout",
        "run": "cp tools/diagnose_typescript_fetch_failure.py \"$RUNNER_TEMP/diagnose-typescript-fetch.py\""
      },
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false,
          "ref": "0754391a20027a539f1d5b7c0426719a4bd6c3c1"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "Swatinem/rust-cache",
        "with": {
          "cache-all-crates": false,
          "cache-bin": false,
          "cache-targets": true,
          "cache-workspace-crates": false,
          "key": "ubuntu-24.04",
          "prefix-key": "lsf-ci-dependencies-v2",
          "shared-key": "host-correctness"
        }
      },
      {
        "name": "Install only the existing private observer boundary",
        "run": "sudo apt-get update\nsudo apt-get install --yes bubblewrap\nsudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0\n"
      },
      {
        "name": "Read the original failed component and bounded build documents",
        "uses": "actions/download-artifact",
        "with": {
          "github-token": "${{ github.token }}",
          "name": "typescript-signed-fetch-0754391a20027a539f1d5b7c0426719a4bd6c3c1",
          "path": "${{ runner.temp }}/typescript-original-fetch",
          "run-id": 39276911555
        }
      },
      {
        "name": "Read the original exact-source native products",
        "uses": "actions/download-artifact",
        "with": {
          "github-token": "${{ github.token }}",
          "name": "typescript-fetch-native-input-0754391a20027a539f1d5b7c0426719a4bd6c3c1",
          "path": "${{ runner.temp }}/typescript-original-native",
          "run-id": 39276911555
        }
      },
      {
        "name": "Replay the unchanged signed component with only private host frame overlays",
        "run": "chmod u+x \"$RUNNER_TEMP/typescript-original-native/native-binaries/\"*\npython3 -B \"$RUNNER_TEMP/diagnose-typescript-fetch.py\" --attempt \"$RUNNER_TEMP/typescript-original-fetch\" --native \"$RUNNER_TEMP/typescript-original-native\" --output \"$RUNNER_TEMP/typescript-fetch-frames\"\n"
      },
      {
        "if": "always()",
        "name": "Retain separate bounded private compiler setup diagnostics",
        "uses": "actions/upload-artifact",
        "with": {
          "if-no-files-found": "warn",
          "name": "typescript-fetch-private-cargo-${{ github.sha }}",
          "path": "${{ runner.temp }}/typescript-fetch-frames/private-build.stderr.txt\n${{ runner.temp }}/typescript-fetch-frames/private-build.stdout.txt\n${{ runner.temp }}/typescript-fetch-frames/private-fetch.stderr.txt\n${{ runner.temp }}/typescript-fetch-frames/private-fetch.stdout.txt\n",
          "retention-days": 1
        }
      },
      {
        "if": "always()",
        "name": "Retain only closed observations and original public CLI rows",
        "uses": "actions/upload-artifact",
        "with": {
          "if-no-files-found": "warn",
          "name": "typescript-fetch-private-frames-${{ github.sha }}",
          "path": "${{ runner.temp }}/typescript-fetch-frames/observation.json\n${{ runner.temp }}/typescript-fetch-frames/node/observation.json\n${{ runner.temp }}/typescript-fetch-frames/node/controls/*.json\n",
          "retention-days": 7
        }
      }
    ],
    "timeout-minutes": 15
  },
  "jobId": "fetch-failure-frames",
  "kind": "job",
  "reviewReason": "Hydrate only exact original checksummed crates.io lock inputs through data-only locked fetch before unchanged offline private host build; retain setup output and hard bounds.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/typescript-guest.yml"
}
