{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Same-component signed Math.random policy and fresh-state programme",
    "if": "${{ github.event_name == 'workflow_dispatch' && inputs.replay-entropy-policy }}",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 15,
    "permissions": {
      "contents": "read",
      "actions": "read"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install the existing locked Python dependencies",
        "run": "python3 -m pip install -r tools/requirements.lock"
      },
      {
        "name": "Check exact artifact package and explicit policy controls",
        "run": "python3 -B -m unittest tools.tests.test_typescript_entropy_campaign tools.tests.test_typescript_entropy_replay -v"
      },
      {
        "name": "Acquire only fixed public layers and original native five products",
        "timeout-minutes": 5,
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "run": "python3 -B tools/replay_typescript_standard_entropy.py --acquire --inputs \"$RUNNER_TEMP/typescript-entropy-original-inputs\""
      },
      {
        "name": "Re-sign unchanged components and execute normal27 plus entropy6 and missing-grant denial",
        "run": "python3 -B tools/replay_typescript_standard_entropy.py --inputs \"$RUNNER_TEMP/typescript-entropy-original-inputs\" --output \"$RUNNER_TEMP/typescript-entropy-policy-replay\""
      },
      {
        "name": "Retain source-bound policy transitions outcomes and physical cleanup",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "typescript-entropy-policy-replay-${{ github.sha }}",
          "path": "${{ runner.temp }}/typescript-entropy-original-inputs/acquisition.json\n${{ runner.temp }}/typescript-entropy-policy-replay/*.json\n${{ runner.temp }}/typescript-entropy-policy-replay/node/*.json\n${{ runner.temp }}/typescript-entropy-policy-replay/node/controls/*.json\n",
          "if-no-files-found": "warn",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "entropy-policy-replay",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/typescript-guest.yml"
}
