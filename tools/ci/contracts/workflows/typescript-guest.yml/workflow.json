{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "typescript-guest-${{ github.ref }}"
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "TypeScript guest qualification",
    "on": {
      "pull_request": {
        "paths": [
          "sdk/typescript-guest/**",
          "sdk/transaction-contract/**",
          "tools/qualify_transaction_contracts.py",
          "tools/compile_transaction_guests.py",
          "tools/transaction_guest_project.py",
          "tools/transaction_guest_variants.py",
          "tools/tests/test_transaction_guest_authoring.py",
          "tools/tests/test_transaction_guest_compilers.py",
          "examples/rust-capsules/transactional-aggregate/**",
          "crates/latent-wasmtime/examples/typescript_runtime_probe.rs",
          "crates/latent-wasmtime/examples/typescript_runtime_probe/**",
          "tools/typescript_guest/**",
          "tools/typescript_capsule.py",
          "tools/typescript*dependencies.py",
          "tools/typescript_dependency_authoring.py",
          "tools/npm_lock_authoring.py",
          "tools/typescript_generator_authoring.py",
          "tools/typescript_generator_fixture.py",
          "tools/tests/test_typescript_generator_authoring.py",
          "tools/tests/test_typescript_generator_fixture.py",
          "tools/typescript_registry_tls.py",
          "tools/npm_private_registry_fixture.py",
          "tools/qualify_npm_private_dependencies.py",
          "tools/tests/test_typescript_registry_tls.py",
          "tools/tests/test_npm_private_registry.py",
          "tools/tests/test_typescript_dependency_authoring.py",
          "tools/tests/test_npm_lock_authoring.py",
          "tools/guest_authoring_frontend.py",
          "tools/typescript_dependency_fixture.py",
          "tools/application_dependenc*.py",
          "tools/captured_compiler_isolation.py",
          "tools/build_typescript_guest_capsules.py",
          "tools/build_typescript_promise_library.py",
          "tools/build_typescript_native_engine.py",
          "tools/build_typescript_source_splicer.py",
          "tools/tests/test_typescript_splicer_build.py",
          "tools/tests/test_typescript_native_build.py",
          "tools/tests/test_typescript_promise_library.py",
          "tools/qualify_typescript_capsules.py",
          "tools/qualify_typescript_standard_clocks.py",
          "tools/typescript_standard_clock*.py",
          "tools/tests/test_typescript*clock*.py",
          "docs/component-development/typescript-standard-clocks.md",
          "tools/qualify_typescript_standard_entropy.py",
          "tools/typescript_entropy_probe.py",
          "tools/tests/test_typescript_entropy.py",
          "tools/tests/test_typescript_entropy_campaign.py",
          "docs/component-development/typescript-standard-entropy.md",
          "tools/qualify_typescript_dependencies.py",
          "tools/qualify_typescript_dependency_refusals.py",
          "tools/tests/test_typescript_dependency_refusals.py",
          "tools/qualify_typescript_fetch_component.py",
          "tools/tests/test_typescript_fetch_component.py",
          "tools/qualify_typescript_fetch_runtime.py",
          "tools/tests/test_typescript_fetch_runtime.py",
          "tools/tests/test_typescript_application_dependencies.py",
          "tools/*rust_capsule*.py",
          "crates/latent-wasmtime/tests/**",
          "crates/latent-signing/**",
          "crates/latent-packaging/**",
          "apps/latentd/**",
          ".cargo/managed-guest.toml",
          "docs/component-development/typescript-authoring.md",
          "docs/component-development/typescript-dependencies.md",
          "examples/typescript-capsules/**",
          "wit/platform/**",
          "tools/toolchain.toml",
          "examples/renderer-profile/package*.json",
          ".github/workflows/typescript-guest.yml"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/typescript-guest/**",
          "sdk/transaction-contract/**",
          "tools/qualify_transaction_contracts.py",
          "tools/compile_transaction_guests.py",
          "tools/transaction_guest_project.py",
          "tools/transaction_guest_variants.py",
          "tools/tests/test_transaction_guest_authoring.py",
          "tools/tests/test_transaction_guest_compilers.py",
          "examples/rust-capsules/transactional-aggregate/**",
          "crates/latent-wasmtime/examples/typescript_runtime_probe.rs",
          "crates/latent-wasmtime/examples/typescript_runtime_probe/**",
          "tools/typescript_guest/**",
          "tools/typescript_capsule.py",
          "tools/typescript*dependencies.py",
          "tools/typescript_dependency_authoring.py",
          "tools/npm_lock_authoring.py",
          "tools/typescript_generator_authoring.py",
          "tools/typescript_generator_fixture.py",
          "tools/tests/test_typescript_generator_authoring.py",
          "tools/tests/test_typescript_generator_fixture.py",
          "tools/typescript_registry_tls.py",
          "tools/npm_private_registry_fixture.py",
          "tools/qualify_npm_private_dependencies.py",
          "tools/tests/test_typescript_registry_tls.py",
          "tools/tests/test_npm_private_registry.py",
          "tools/tests/test_typescript_dependency_authoring.py",
          "tools/tests/test_npm_lock_authoring.py",
          "tools/guest_authoring_frontend.py",
          "tools/typescript_dependency_fixture.py",
          "tools/application_dependenc*.py",
          "tools/captured_compiler_isolation.py",
          "tools/build_typescript_guest_capsules.py",
          "tools/build_typescript_promise_library.py",
          "tools/build_typescript_native_engine.py",
          "tools/build_typescript_source_splicer.py",
          "tools/tests/test_typescript_splicer_build.py",
          "tools/tests/test_typescript_native_build.py",
          "tools/tests/test_typescript_promise_library.py",
          "tools/qualify_typescript_capsules.py",
          "tools/qualify_typescript_standard_clocks.py",
          "tools/typescript_standard_clock*.py",
          "tools/tests/test_typescript*clock*.py",
          "docs/component-development/typescript-standard-clocks.md",
          "tools/qualify_typescript_standard_entropy.py",
          "tools/typescript_entropy_probe.py",
          "tools/tests/test_typescript_entropy.py",
          "tools/tests/test_typescript_entropy_campaign.py",
          "docs/component-development/typescript-standard-entropy.md",
          "tools/qualify_typescript_dependencies.py",
          "tools/qualify_typescript_dependency_refusals.py",
          "tools/tests/test_typescript_dependency_refusals.py",
          "tools/qualify_typescript_fetch_component.py",
          "tools/tests/test_typescript_fetch_component.py",
          "tools/qualify_typescript_fetch_runtime.py",
          "tools/tests/test_typescript_fetch_runtime.py",
          "tools/tests/test_typescript_application_dependencies.py",
          "tools/*rust_capsule*.py",
          "crates/latent-wasmtime/tests/**",
          "crates/latent-signing/**",
          "crates/latent-packaging/**",
          "apps/latentd/**",
          ".cargo/managed-guest.toml",
          "docs/component-development/typescript-authoring.md",
          "docs/component-development/typescript-dependencies.md",
          "examples/typescript-capsules/**",
          "wit/platform/**",
          "tools/toolchain.toml",
          "examples/renderer-profile/package*.json",
          ".github/workflows/typescript-guest.yml"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "observe-failed-fetch": {
            "default": false,
            "description": "Replay the authenticated d412 Fetch failure with bounded private frames",
            "type": "boolean"
          },
          "observe-fetch-boundaries": {
            "default": false,
            "description": "Compile only new boundary probes using authenticated d412 SDK products",
            "type": "boolean"
          },
          "qualify-scratch-refusals": {
            "default": false,
            "description": "Require reachable node:fs refusal using existing authenticated native tools",
            "type": "boolean"
          },
          "qualify-standard-clocks": {
            "default": false,
            "description": "Build two ordinary clock probes using original engine and native products",
            "type": "boolean"
          },
          "replay-entropy-policy": {
            "default": false,
            "description": "Re-sign unchanged02f components and qualify the explicit zero-input policy ceiling",
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "boundary",
    "entropy-policy-replay",
    "fetch-boundaries",
    "fetch-component",
    "fetch-failure-frames",
    "fetch-runtime",
    "promise-library",
    "scratch-refusals",
    "source-splicer",
    "standard-clocks"
  ],
  "reviewReason": "Add only a default-false manual three-case captured node:fs refusal job using authenticated historical contracts/package tools, preserving all existing language commands, budgets and original native attribution.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/typescript-guest.yml"
}
