{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "typescript-guest-${{ github.ref }}"
    },
    "env": {
      "CARGO_BUILD_JOBS": "2",
      "CARGO_INCREMENTAL": "0",
      "CARGO_PROFILE_DEV_DEBUG": "0",
      "CARGO_PROFILE_DEV_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_DEV_OVERFLOW_CHECKS": "true",
      "CARGO_PROFILE_TEST_DEBUG": "0",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true"
    },
    "name": "TypeScript guest qualification",
    "on": {
      "pull_request": {
        "paths": [
          "sdk/typescript-guest/**",
          "sdk/transaction-contract/**",
          "tools/qualify_transaction_contracts.py",
          "tools/compile_transaction_guests.py",
          "tools/transaction_guest_project.py",
          "tools/transaction_guest_variants.py",
          "tools/tests/test_transaction_guest_authoring.py",
          "tools/tests/test_transaction_guest_compilers.py",
          "examples/rust-capsules/transactional-aggregate/**",
          "crates/latent-wasmtime/examples/typescript_runtime_probe.rs",
          "crates/latent-wasmtime/examples/typescript_runtime_probe/**",
          "tools/typescript_guest/**",
          "tools/typescript_capsule.py",
          "tools/typescript*dependencies.py",
          "tools/typescript_dependency_authoring.py",
          "tools/npm_lock_authoring.py",
          "tools/tests/test_typescript_dependency_authoring.py",
          "tools/tests/test_npm_lock_authoring.py",
          "tools/guest_authoring_frontend.py",
          "tools/typescript_dependency_fixture.py",
          "tools/application_dependenc*.py",
          "tools/captured_compiler_isolation.py",
          "tools/build_typescript_guest_capsules.py",
          "tools/build_typescript_promise_library.py",
          "tools/build_typescript_native_engine.py",
          "tools/build_typescript_source_splicer.py",
          "tools/tests/test_typescript_splicer_build.py",
          "tools/tests/test_typescript_native_build.py",
          "tools/tests/test_typescript_promise_library.py",
          "tools/qualify_typescript_capsules.py",
          "tools/qualify_typescript_dependencies.py",
          "tools/qualify_typescript_fetch_component.py",
          "tools/tests/test_typescript_fetch_component.py",
          "tools/tests/test_typescript_application_dependencies.py",
          "tools/*rust_capsule*.py",
          "crates/latent-wasmtime/tests/**",
          "crates/latent-signing/**",
          "crates/latent-packaging/**",
          "apps/latentd/**",
          ".cargo/managed-guest.toml",
          "docs/component-development/typescript-authoring.md",
          "docs/component-development/typescript-dependencies.md",
          "examples/typescript-capsules/**",
          "wit/platform/**",
          "tools/toolchain.toml",
          "examples/renderer-profile/package*.json",
          ".github/workflows/typescript-guest.yml"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          "sdk/typescript-guest/**",
          "sdk/transaction-contract/**",
          "tools/qualify_transaction_contracts.py",
          "tools/compile_transaction_guests.py",
          "tools/transaction_guest_project.py",
          "tools/transaction_guest_variants.py",
          "tools/tests/test_transaction_guest_authoring.py",
          "tools/tests/test_transaction_guest_compilers.py",
          "examples/rust-capsules/transactional-aggregate/**",
          "crates/latent-wasmtime/examples/typescript_runtime_probe.rs",
          "crates/latent-wasmtime/examples/typescript_runtime_probe/**",
          "tools/typescript_guest/**",
          "tools/typescript_capsule.py",
          "tools/typescript*dependencies.py",
          "tools/typescript_dependency_authoring.py",
          "tools/npm_lock_authoring.py",
          "tools/tests/test_typescript_dependency_authoring.py",
          "tools/tests/test_npm_lock_authoring.py",
          "tools/guest_authoring_frontend.py",
          "tools/typescript_dependency_fixture.py",
          "tools/application_dependenc*.py",
          "tools/captured_compiler_isolation.py",
          "tools/build_typescript_guest_capsules.py",
          "tools/build_typescript_promise_library.py",
          "tools/build_typescript_native_engine.py",
          "tools/build_typescript_source_splicer.py",
          "tools/tests/test_typescript_splicer_build.py",
          "tools/tests/test_typescript_native_build.py",
          "tools/tests/test_typescript_promise_library.py",
          "tools/qualify_typescript_capsules.py",
          "tools/qualify_typescript_dependencies.py",
          "tools/qualify_typescript_fetch_component.py",
          "tools/tests/test_typescript_fetch_component.py",
          "tools/tests/test_typescript_application_dependencies.py",
          "tools/*rust_capsule*.py",
          "crates/latent-wasmtime/tests/**",
          "crates/latent-signing/**",
          "crates/latent-packaging/**",
          "apps/latentd/**",
          ".cargo/managed-guest.toml",
          "docs/component-development/typescript-authoring.md",
          "docs/component-development/typescript-dependencies.md",
          "examples/typescript-capsules/**",
          "wit/platform/**",
          "tools/toolchain.toml",
          "examples/renderer-profile/package*.json",
          ".github/workflows/typescript-guest.yml"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "boundary",
    "fetch-component",
    "promise-library",
    "source-splicer"
  ],
  "reviewReason": "Build an actual Fetch-selected async-import component from same-run source-owned engine and splicer without inferring signed/provider execution.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/typescript-guest.yml"
}
