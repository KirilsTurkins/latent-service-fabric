{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Exact three canonical HTTP phase cases; unchanged transport proofs retained separately",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "Swatinem/rust-cache",
        "with": {
          "cache-all-crates": false,
          "cache-bin": false,
          "cache-on-failure": false,
          "cache-targets": true,
          "cache-workspace-crates": false,
          "key": "ubuntu-24.04",
          "prefix-key": "lsf-ci-dependencies-v2",
          "save-if": false,
          "shared-key": "host-correctness"
        }
      },
      {
        "name": "Check exact type-only phase provider admission boundary",
        "run": "cargo test --locked -p latent-wasmtime --lib surface::tests::phase_type_owner_requires_selected_installed_phase_and_never_supplies_legacy_calls -- --exact --nocapture"
      },
      {
        "name": "Check actual nominal preparation and reject operational owner injection",
        "run": "cargo test --locked -p latent-wasmtime --test streaming_http fixture::phase_nominal_owner_has_no_operational_binding_or_session -- --exact --nocapture"
      },
      {
        "name": "Execute the new canonical ABI with actual sockets and fresh Stores",
        "run": "cargo test --locked -p latent-wasmtime --test streaming_http phases:: -- --nocapture\n"
      }
    ],
    "timeout-minutes": 45
  },
  "jobId": "canonical",
  "kind": "job",
  "reviewReason": "Add the actual preparation/type-owner classification control; retain original admission control and exact three canonical command.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/http-phase-canonical-only.yml"
}
