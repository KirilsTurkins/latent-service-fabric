  "definition": {
    "name": "Exact three canonical HTTP phase cases; unchanged transport proofs retained separately",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "Swatinem/rust-cache",
        "with": {
          "cache-all-crates": false,
          "cache-bin": false,
          "cache-on-failure": false,
          "cache-targets": true,
          "cache-workspace-crates": false,
          "key": "ubuntu-24.04",
          "prefix-key": "lsf-ci-dependencies-v2",
          "save-if": false,
          "shared-key": "host-correctness"
        }
      },
      {
        "name": "Execute the new canonical ABI with actual sockets and fresh Stores",
        "run": "cargo test --locked -p latent-wasmtime --test streaming_http phases:: -- --nocapture\n"
      }
    ],
    "timeout-minutes": 45
  },
  "jobId": "canonical",
  "kind": "job",
  "reviewReason": "Execute exactly the three failing canonical cases with original pinned setup/environment/timebound; prior unchanged transport and semantic proofs stay separately source-bound, never recounted.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/http-phase-canonical-only.yml"
}
