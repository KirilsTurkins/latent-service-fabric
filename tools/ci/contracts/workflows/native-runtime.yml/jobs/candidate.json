  "definition": {
    "if": "github.event_name != 'workflow_dispatch' || inputs.artifact_run == ''",
    "name": "Exact-source native Linux candidate",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 90,
    "permissions": {
      "contents": "read",
      "id-token": "write",
      "attestations": "write"
    },
    "outputs": {
      "version": "${{ steps.identity.outputs.version }}"
    },
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "name": "Prepare private exact-source host workspace without changing runner ACLs",
        "run": "python3 tools/prepare_native_workspace.py"
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5",
          "cache": "pip",
          "cache-dependency-path": "tools/requirements.lock"
        }
      },
      {
        "name": "Select maintained CI profile",
        "run": "python3 tools/ci_profile.py"
      },
      {
        "name": "Install pinned validation requirements",
        "run": "python3 -m pip install --requirement tools/requirements.lock"
      },
      {
        "name": "Fast native artifact and installer safety checks",
        "run": "python3 -m unittest tools.tests.test_native_runtime tools.tests.test_native_release_gate\npython3 tools/validate_workflow_actions.py\npython3 tools/validate_docs.py\n"
      },
      {
        "uses": "dtolnay/rust-toolchain",
        "with": {
          "targets": "wasm32-wasip2,wasm32-unknown-unknown"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-bytecodealliance-actions/wasm-tools/setup",
        "with": {
          "version": "1.254.0"
        }
      },
      {
        "uses": "KirilsTurkins/lsf-rust-cache",
        "with": {
          "prefix-key": "lsf-native-dependencies-v1",
          "cache-targets": false,
          "cache-bin": false,
          "cache-workspace-crates": false,
          "cache-all-crates": false,
          "cache-on-failure": false,
          "cache-directories": "target/native-build/x86_64-unknown-linux-gnu/release/.fingerprint\ntarget/native-build/x86_64-unknown-linux-gnu/release/build\ntarget/native-build/x86_64-unknown-linux-gnu/release/deps\n",
          "save-if": "${{ github.ref == 'refs/heads/development' }}"
        }
      },
      {
        "name": "Select exact source version",
        "id": "identity",
        "run": "version=$(python3 -c 'import tomllib; print(tomllib.load(open(\"Cargo.toml\", \"rb\"))[\"workspace\"][\"package\"][\"version\"])')\necho \"version=$version\" >> \"$GITHUB_OUTPUT\"\n"
      },
      {
        "name": "Build exact-source unsigned candidate",
        "env": {
          "NATIVE_VERSION": "${{ steps.identity.outputs.version }}",
          "DEVELOPMENT_TEST_NODE": "${{ inputs.development_test_node || false }}"
        },
        "run": "cd \"$NATIVE_WORKSPACE\"\nversion=\"$NATIVE_VERSION\"\nfixture_args=()\nif [ \"$DEVELOPMENT_TEST_NODE\" = true ]; then fixture_args=(--development-test-node); fi\npython3 tools/build_native_runtime.py --commit \"$GITHUB_SHA\" --version \"$version\" --output \"$PWD/target/native-release\" \"${fixture_args[@]}\"\n"
      },
      {
        "name": "Build separately authenticated public-only VM fixture helper",
        "run": "cd \"$NATIVE_WORKSPACE\"\ncargo +1.97.1 fmt --manifest-path tools/native-fixture/Cargo.toml -- --check\ncargo +1.97.1 build --locked --release --manifest-path tools/native-fixture/Cargo.toml \\\n  --target x86_64-unknown-linux-gnu --target-dir target/native-fixture-build --jobs 2\ninstall -D -m 0755 target/native-fixture-build/x86_64-unknown-linux-gnu/release/latent-native-vm-fixture target/native-test-tools/fixture-helper\n"
      },
      {
        "name": "Attest candidate checksum inventory, not release authority",
        "id": "attest",
        "uses": "KirilsTurkins/lsf-attest-build-provenance",
        "with": {
          "subject-path": "${{ env.NATIVE_WORKSPACE }}/target/native-release/SHA256SUMS\n${{ env.NATIVE_WORKSPACE }}/target/native-test-tools/fixture-helper\n"
        }
      },
      {
        "name": "Retain offline attestation material",
        "env": {
          "ATTESTATION_BUNDLE": "${{ steps.attest.outputs.bundle-path }}"
        },
        "run": "install -m 0644 \"$ATTESTATION_BUNDLE\" \"$NATIVE_WORKSPACE/target/native-release/SHA256SUMS.sigstore.json\""
      },
      {
        "name": "Retain authenticated candidate, not a published release",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "native-runtime-candidate${{ inputs.development_test_node && '-development-test' || '' }}-${{ github.sha }}",
          "path": "${{ env.NATIVE_WORKSPACE }}/target/native-release/",
          "if-no-files-found": "error",
          "retention-days": 14
        }
      },
      {
        "name": "Retain test tooling separately from the runtime bundle",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "native-runtime-test-tools-${{ github.sha }}",
          "path": "${{ env.NATIVE_WORKSPACE }}/target/native-test-tools/",
          "if-no-files-found": "error",
          "retention-days": 14
        }
      },
      {
        "name": "Retain bounded build failure",
        "if": "failure()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "native-runtime-build-failure-${{ github.sha }}",
          "path": "${{ env.NATIVE_WORKSPACE }}/target/native-build-failure.*",
          "if-no-files-found": "ignore",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "candidate",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/native-runtime.yml"
}
