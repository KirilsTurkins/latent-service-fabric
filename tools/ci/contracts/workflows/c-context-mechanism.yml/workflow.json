{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "c-context-mechanism-${{ github.ref }}"
    },
    "name": "C compiler stack and TLS mechanism",
    "on": {
      "push": {
        "branches": [
          "feat/c-tls-keys-20261020"
        ],
        "paths": [
          "crates/latent-component-threading/**",
          "sdk/c-guest/runtime-fixtures/context-lowering/**",
          "sdk/c-guest/runtime/tls-keys.c",
          "tools/qualify_c_context_lowering.py",
          ".github/workflows/c-context-mechanism.yml"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "compiler"
  ],
  "reviewReason": "Extend only the explicit unqualified C compiler mechanism with bounded pthread-key and errno PAL controls; retain original26 Rust and original C isolation/refusal controls, limits and engine defaults.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/c-context-mechanism.yml"
}
