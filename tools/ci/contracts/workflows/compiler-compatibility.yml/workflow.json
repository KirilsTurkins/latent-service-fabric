{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "compiler-diagnostics-${{ github.ref }}"
    },
    "name": "Compiler and signed initializer callback diagnostics",
    "on": {
      "push": {
        "branches": [
          "feat/java-dotnet-diagnostics-679-20261021"
        ],
        "paths": [
          ".github/workflows/compiler-compatibility.yml",
          "sdk/java-guest/**",
          "sdk/dotnet-guest/**",
          "tools/java_guest/**",
          "tools/dotnet_guest/**",
          "tools/java_capsule.py",
          "tools/java_capsule_build.py",
          "tools/dotnet_capsule.py",
          "tools/compiler_compatibility_*.py",
          "tools/qualify_compiler_compatibility.py",
          "tools/fixtures/compatibility-java/**",
          "tools/fixtures/compatibility-dotnet/**"
        ]
      }
    },
    "permissions": {
      "actions": "read",
      "contents": "read"
    }
  },
  "requiredJobs": [
    "dotnet-diagnostics",
    "java-diagnostics"
  ],
  "reviewReason": "Dedicated exact-branch substantive compiler and signed initializer callback diagnostics; preserve every historical workflow and default; no native rebuild or graph-based API certification.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/compiler-compatibility.yml"
}
