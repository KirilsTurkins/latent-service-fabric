{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "if": false,
    "needs": "closure-required",
    "runs-on": "ubuntu-24.04",
    "steps": [
      {
        "uses": "actions/checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "actions/setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install only locked readers",
        "run": "python3 -m pip install --requirement tools/requirements.lock"
      },
      {
        "uses": "actions/download-artifact",
        "with": {
          "name": "compatibility-closure-${{ github.sha }}-c",
          "path": "${{ runner.temp }}/compatibility-inputs/c"
        }
      },
      {
        "uses": "actions/download-artifact",
        "with": {
          "name": "compatibility-closure-${{ github.sha }}-go",
          "path": "${{ runner.temp }}/compatibility-inputs/go"
        }
      },
      {
        "uses": "actions/download-artifact",
        "with": {
          "name": "compatibility-closure-${{ github.sha }}-dotnet",
          "path": "${{ runner.temp }}/compatibility-inputs/dotnet"
        }
      },
      {
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "name": "Authenticate five exact passed cells from cc8b and723ffc without rebuilding or invoking guests",
        "run": "python3 -B tools/compatibility_preserved_cells.py --output \"$RUNNER_TEMP/compatibility-preserved\""
      },
      {
        "env": {
          "SOURCE_COMMIT": "${{ github.sha }}"
        },
        "name": "Require every exact cell and preserve historical scope",
        "run": "python3 -B tools/compatibility_closure_matrix.py assemble --inputs \"$RUNNER_TEMP/compatibility-inputs\" --source-commit \"$SOURCE_COMMIT\" --preserved \"$RUNNER_TEMP/compatibility-preserved\" --diagnostics \"$RUNNER_TEMP/compatibility-current-diagnostics\" --output \"$RUNNER_TEMP/compatibility-completion.json\""
      },
      {
        "uses": "actions/upload-artifact",
        "with": {
          "if-no-files-found": "error",
          "name": "compatibility-closure-matrix-${{ github.sha }}",
          "path": "${{ runner.temp }}/compatibility-completion.json",
          "retention-days": 3
        }
      }
    ],
    "timeout-minutes": 10
  },
  "jobId": "closure-matrix",
  "kind": "job",
  "reviewReason": "Reviewed root CI faithful mock-constructor/selected-rustc fixture corrections and ONE Go diagnostic route; all existing case IDs/decorators/skips preserved. Exact module helper setup changes are reviewed source, not a skipped control. Static false disables diagnostic rollup without expression obfuscation.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/compiler-compatibility.yml"
}
