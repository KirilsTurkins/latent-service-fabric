{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Actual frozen operator and native277 configuration checks",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 10,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Fetch only the immutable compiled source closures",
        "run": "git fetch --depth=1 origin 277c8104499d414053573bce066b5e9091e74a20 380c7df8f26ec3f0f6e54d616e8d08b80cb5cc73"
      },
      {
        "name": "Exercise four new origin and refusal-classification controls",
        "run": "python -S -B -m unittest tools.tests.test_stream_operator_node"
      },
      {
        "name": "Reuse authenticated products and observe actual configuration-only refusals",
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "run": "python -S -B tools/qualify_stream_operator_node.py --output target/stream-operator-node-check"
      },
      {
        "name": "Retain only redacted public configuration outcomes",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "stream-operator-node-check-${{ github.sha }}",
          "path": "target/stream-operator-node-check/result.json",
          "if-no-files-found": "error",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "node-check",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/stream-operator-node-check.yml"
}
