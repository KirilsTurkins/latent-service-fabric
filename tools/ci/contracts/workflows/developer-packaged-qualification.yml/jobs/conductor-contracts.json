{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Packaged qualification conductor contracts (${{ matrix.os }})",
    "strategy": {
      "fail-fast": false,
      "matrix": {
        "os": [
          "ubuntu-24.04",
          "windows-2025"
        ]
      }
    },
    "runs-on": "${{ matrix.os }}",
    "timeout-minutes": 5,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Check archive rejection and bounded conductor processes",
        "run": "python -m unittest tools.tests.test_dev_packaged_probe"
      }
    ]
  },
  "jobId": "conductor-contracts",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/developer-packaged-qualification.yml"
}
