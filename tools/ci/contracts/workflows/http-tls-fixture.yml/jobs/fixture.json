{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "TLS transport and owned process controls without a guest or provider build",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 5,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "name": "Install the existing locked reference dependencies",
        "run": "python3 -m pip install -r tools/requirements.lock"
      },
      {
        "name": "Check closed TLS readiness and receipt controls",
        "run": "python3 -B -m unittest tools.tests.test_http_tls_peer -v"
      },
      {
        "name": "Execute actual TLS versions trust hostname and transport retirement",
        "run": "python3 -B tools/qualify_http_tls_peer.py --output \"$RUNNER_TEMP/http-tls-peer\""
      },
      {
        "name": "Retain public certificate and bounded transport receipts",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "http-tls-peer-${{ github.sha }}",
          "path": "${{ runner.temp }}/http-tls-peer/*.json\n${{ runner.temp }}/http-tls-peer/certificate.der\n",
          "if-no-files-found": "warn",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "fixture",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/http-tls-fixture.yml"
}
