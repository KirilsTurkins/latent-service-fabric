{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": false,
      "group": "http-tls-fixture-${{ github.ref }}"
    },
    "name": "Controlled HTTP TLS fixture",
    "on": {
      "push": {
        "branches": [
          "feat/http-tls-fixture-20261020"
        ],
        "paths": [
          ".github/workflows/http-tls-fixture.yml",
          "tools/standard_http/tls_peer.py",
          "tools/http_tls_peer_reference.py",
          "tools/qualify_http_tls_peer.py",
          "tools/tests/test_http_tls_peer.py"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "fixture"
  ],
  "reviewReason": "Add a bounded independent TLS fixture reference lane with ten portable controls and six real TLS/HTTP outcomes; no guest/provider/kernel qualification or previous command replacement.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/http-tls-fixture.yml"
}
