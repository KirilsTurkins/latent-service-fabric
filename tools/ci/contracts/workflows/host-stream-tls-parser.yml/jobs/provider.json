{
  "baselineRevision": "50f003dd006e0786494936c49e55dc683cf26fd6",
  "before": {},
  "coverage": {},
  "definition": {
    "name": "Bounded provider real-peer ownership controls",
    "needs": "parser",
    "runs-on": "ubuntu-24.04",
    "timeout-minutes": 60,
    "steps": [
      {
        "uses": "KirilsTurkins/lsf-checkout",
        "with": {
          "persist-credentials": false
        }
      },
      {
        "uses": "KirilsTurkins/lsf-setup-python",
        "with": {
          "python-version": "3.13.5"
        }
      },
      {
        "uses": "dtolnay/rust-toolchain"
      },
      {
        "uses": "KirilsTurkins/lsf-rust-cache",
        "with": {
          "prefix-key": "lsf-ci-dependencies-v2",
          "shared-key": "host-correctness",
          "key": "ubuntu-24.04",
          "cache-targets": true,
          "cache-bin": false,
          "cache-workspace-crates": false
        }
      },
      {
        "name": "Check provider receipt refusal controls",
        "run": "python3 -m unittest tools.tests.test_host_stream_tls_provider_reference -v"
      },
      {
        "name": "Build selected provider and execute all original ownership controls",
        "run": "python3 tools/qualify_host_stream_tls_provider.py --output \"$RUNNER_TEMP/host-tls-provider-reference\" --source-commit \"${{ github.sha }}\""
      },
      {
        "name": "Retain bounded source-bound provider evidence",
        "if": "always()",
        "uses": "KirilsTurkins/lsf-upload-artifact",
        "with": {
          "name": "host-tls-provider-reference-${{ github.sha }}",
          "path": "${{ runner.temp }}/host-tls-provider-reference/receipt.json\n${{ runner.temp }}/host-tls-provider-reference/cargo.stdout.log\n${{ runner.temp }}/host-tls-provider-reference/cargo.stderr.log\n${{ runner.temp }}/host-tls-provider-reference/tests.stdout.log\n${{ runner.temp }}/host-tls-provider-reference/tests.stderr.log\n${{ runner.temp }}/host-tls-provider-reference/list.stdout.log\n${{ runner.temp }}/host-tls-provider-reference/ignored.stdout.log\n",
          "if-no-files-found": "warn",
          "retention-days": 7
        }
      }
    ]
  },
  "jobId": "provider",
  "kind": "job",
  "reviewReason": "Reviewed security fork identities only; commands, permissions, inputs, conditions and historical coverage are preserved.",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/host-stream-tls-parser.yml"
}
