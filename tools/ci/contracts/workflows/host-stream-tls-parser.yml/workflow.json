{
  "kind": "workflow",
  "policy": {
    "concurrency": {
      "cancel-in-progress": true,
      "group": "host-tls-parser-${{ github.ref }}"
    },
    "name": "Current host TLS parser reference",
    "on": {
      "pull_request": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/host-stream-tls-parser.yml",
          "sdk/host-stream-tls/rustls-0.23.46-bounds/**",
          "tools/host_stream_tls_patch.py",
          "tools/host_stream_tls_provider.py",
          "tools/native_runtime_build.py",
          "tools/ci_suite_inventory.py",
          "crates/vendor/rustls-outbound/**",
          "tools/qualify_host_stream_tls_parser.py",
          "tools/qualify_host_stream_tls_provider.py",
          "tools/tests/test_host_stream_tls*.py",
          "crates/latent-streams/**",
          "Cargo.toml",
          "Cargo.lock",
          "rust-toolchain.toml"
        ]
      },
      "push": {
        "branches": [
          "development"
        ],
        "paths": [
          ".github/workflows/host-stream-tls-parser.yml",
          "sdk/host-stream-tls/rustls-0.23.46-bounds/**",
          "tools/host_stream_tls_patch.py",
          "tools/host_stream_tls_provider.py",
          "tools/native_runtime_build.py",
          "tools/ci_suite_inventory.py",
          "crates/vendor/rustls-outbound/**",
          "tools/qualify_host_stream_tls_parser.py",
          "tools/qualify_host_stream_tls_provider.py",
          "tools/tests/test_host_stream_tls*.py",
          "crates/latent-streams/**",
          "Cargo.toml",
          "Cargo.lock",
          "rust-toolchain.toml"
        ]
      },
      "workflow_dispatch": {}
    },
    "permissions": {
      "contents": "read"
    }
  },
  "requiredJobs": [
    "parser",
    "provider"
  ],
  "reviewReason": "Add test-only actual bounded TLS provider real-peer controls with unchanged public refusal, original23-case ownership catalogue and finite source-bound witness; accounting remains unqualified",
  "schemaVersion": "latent.ci.contracts.v1",
  "workflow": ".github/workflows/host-stream-tls-parser.yml"
}
