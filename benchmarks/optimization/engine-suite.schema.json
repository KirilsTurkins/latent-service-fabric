      "enum": [
        "passed",
        "failed"
      ]
    },
    "reason": {
      "enum": [
        null,
        "collection-failed"
      ]
    },
    "elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repetition",
          "sequence_ordinal",
