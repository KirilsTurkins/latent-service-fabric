            "minItems": 6,
            "maxItems": 6
          },
          "started_micros": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "maxLength": 20
          },
          "finished_micros": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "maxLength": 20
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
