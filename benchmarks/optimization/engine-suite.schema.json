              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$",
                "maxLength": 20
              }
            }
          },
          "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$",
                "maxLength": 20
              }
            }
          },
          "process": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$",
                    "maxLength": 20
                  }
                }
              }
            ]
          },
          "raw": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$",
                    "maxLength": 20
                  }
                }
              }
            ]
          },
          "log": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$",
                    "maxLength": 20
                  }
                }
              }
            ]
          },
          "cleanup": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$",
                    "maxLength": 20
                  }
                }
              }
            ]
          },
          "host_before": {
            "type": "object"
          },
          "host_after": {
            "type": "object"
          },
          "cgroup_before": {
            "type": "object"
          },
          "cgroup_after": {
            "type": "object"
          }
        }
      },
      "minItems": 0,
      "maxItems": 35
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "maxLength": 20
          }
        }
      },
      "minItems": 1,
      "maxItems": 4096
