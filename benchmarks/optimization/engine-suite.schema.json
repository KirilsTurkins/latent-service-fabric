          "engine_profile_id",
          "status",
          "reason",
          "command",
          "started_micros",
          "finished_micros",
          "identity",
          "plan",
          "process",
          "raw",
          "log",
          "cleanup",
          "host_before",
          "host_after",
          "cgroup_before",
          "cgroup_after"
