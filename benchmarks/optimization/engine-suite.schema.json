  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "smoke"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "profile": {
                "const": "smoke"
              },
              "repetitions": {
                "const": 1
              },
              "rows": {
                "minItems": 5,
                "maxItems": 5
              },
              "per_process": {
                "properties": {
                  "invokes": {
                    "const": 52
                  },
                  "commands": {
                    "const": 125
                  }
                }
              }
            }
          },
          "runs": {
            "maxItems": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "full"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "profile": {
                "const": "full"
              },
              "repetitions": {
                "const": 7
              },
              "rows": {
                "minItems": 35,
                "maxItems": 35
              },
              "per_process": {
                "properties": {
                  "invokes": {
                    "const": 794
                  },
                  "commands": {
                    "const": 1609
                  }
                }
              }
            }
          },
          "runs": {
            "maxItems": 35
          }
        }
      }
    }
