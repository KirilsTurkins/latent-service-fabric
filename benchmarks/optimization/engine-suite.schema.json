        "properties": {
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "sequence_ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "variant": {
            "enum": [
              "control",
              "candidate"
            ]
          },
          "engine_profile_id": {
            "enum": [
              "D0",
              "P0",
              "D1",
              "P1"
            ]
