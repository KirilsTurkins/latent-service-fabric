{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog suite evidence envelope",
  "description": "Closed bounded envelope. Exact source, owner order, every operation, same-root reopen, resource ownership and allocation attribution require the matching semantic replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "plan",
    "builds",
    "runner_source",
    "runner_source_after",
    "status",
    "reason",
    "elapsed_nanos",
    "normal_elapsed_nanos",
    "allocation_elapsed_nanos",
    "tools",
    "symbols",
    "runs",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.catalog-suite.v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "builds": {
      "$ref": "#/$defs/artifact"
    },
    "runner_source": {
      "type": "object"
    },
    "runner_source_after": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "reason": {
      "enum": [
        null,
        "collection-failed"
      ]
    },
    "elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "normal_elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "allocation_elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heaptrack": {
          "type": "object"
        },
        "heaptrack_print": {
          "type": "object"
        },
        "zstd": {
          "type": "object"
        },
        "nm": {
          "type": "object"
        }
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control": {
          "type": "object"
        },
        "candidate": {
          "type": "object"
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repetition",
          "variant",
          "shape",
          "mode",
          "sequence_ordinal",
          "case",
          "status",
          "reason",
          "command",
          "started_micros",
          "finished_micros",
          "plan",
          "identity",
          "data_owner",
          "reopen_input",
          "post_exit",
          "cleanup",
          "raw",
          "log",
          "ready",
          "result",
          "process",
          "probe_process",
          "resources",
          "cpu",
          "profile_refs",
          "host_after",
          "cgroup_after",
          "host_before",
          "cgroup_before"
        ],
        "properties": {
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "variant": {
            "enum": [
              "control",
              "candidate"
            ]
          },
          "shape": {
            "enum": [
              "distinct",
              "shared"
            ]
          },
          "mode": {
            "enum": [
              "initial",
              "reopen",
              "allocation"
            ]
          },
          "sequence_ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 39
          },
          "case": {
            "enum": [
              null,
              "default-success",
              "named-success",
              "route-miss",
              "export-miss"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "reason": {
            "enum": [
              null,
              "collector-failed"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 6,
            "maxItems": 9
          },
          "started_micros": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "maxLength": 20
          },
          "finished_micros": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$",
                "maxLength": 20
              }
