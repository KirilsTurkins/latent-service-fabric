                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "cgroup_after": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "host_before": {
            "type": "object"
          },
          "cgroup_before": {
            "type": "object"
          }
        }
      },
      "minItems": 0,
      "maxItems": 40
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "smoke"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "profile": {
                "const": "smoke"
              },
              "rows": {
                "minItems": 40,
                "maxItems": 40
              },
              "normal_pairs_per_shape": {
                "const": 3
              }
            }
          },
          "runs": {
            "maxItems": 40
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "full"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "profile": {
                "const": "full"
              },
              "rows": {
                "minItems": 24,
                "maxItems": 24
              },
              "normal_pairs_per_shape": {
                "const": 1
              }
            }
          },
          "runs": {
            "maxItems": 24
          }
        }
      }
    }
