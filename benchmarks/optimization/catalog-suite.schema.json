          },
          "plan": {
            "$ref": "#/$defs/artifact"
          },
          "identity": {
            "$ref": "#/$defs/artifact"
          },
          "data_owner": {
            "$ref": "#/$defs/artifact"
          },
          "reopen_input": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/artifact"
              }
            ]
          },
          "post_exit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/artifact"
              }
            ]
          },
          "cleanup": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/artifact"
              }
            ]
          },
          "raw": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/artifact"
              }
            ]
          },
          "log": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/artifact"
              }
            ]
          },
          "ready": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/artifact"
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/artifact"
              }
            ]
          },
          "process": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "probe_process": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "resources": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "cpu": {
            "oneOf": [
