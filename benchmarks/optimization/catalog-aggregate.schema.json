  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "status",
    "population_complete",
    "attempt_count_complete",
    "qualifying_full_population",
    "scope",
    "suite",
    "builds",
    "plan",
    "sources",
    "validated_commands",
    "validated_resolves",
    "validated_collectors",
    "planned_collectors",
    "elapsed_nanos",
    "normal_elapsed_nanos",
    "allocation_elapsed_nanos",
    "validated_invocations",
    "runs",
    "normal_pairs",
    "allocation_pairs",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.catalog-aggregate.v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "failed"
      ]
    },
    "population_complete": {
      "type": "boolean"
    },
    "attempt_count_complete": {
      "type": "boolean"
    },
    "qualifying_full_population": {
      "type": "boolean"
    },
    "scope": {
      "const": "zero-invoke-catalog-publication-public-resolve-pin-reopen-and-separate-tiny-allocation"
    },
