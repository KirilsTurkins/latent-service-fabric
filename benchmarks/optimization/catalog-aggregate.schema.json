      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "suite.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "builds": {
      "$ref": "#/$defs/artifact"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "candidate"
      ],
      "properties": {
        "control": {
          "type": "object"
        },
        "candidate": {
          "type": "object"
        }
      }
    },
