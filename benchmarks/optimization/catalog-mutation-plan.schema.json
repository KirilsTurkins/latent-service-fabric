{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/benchmarks/optimization/catalog-mutation-plan.schema.json",
  "title": "Closed catalog mutation collector selectors; exact ordering requires semantic replay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "repetition", "variant", "shape", "populated_size", "mode", "sequence_ordinal"],
  "properties": {
    "schema": {"const": "latent.optimization.catalog-mutation-plan.v1"},
    "profile": {"enum": ["smoke", "full"]},
    "repetition": {"type": "integer", "const": 1},
    "variant": {"enum": ["control", "candidate"]},
    "shape": {"enum": ["distinct", "shared"]},
    "populated_size": {"type": "integer", "enum": [4, 8, 100, 1000, 10000]},
    "mode": {"enum": ["initial", "reopen", "allocation", "allocation-reopen"]},
    "sequence_ordinal": {"type": "integer", "minimum": 0, "maximum": 31}
  },
  "oneOf": [
    {
      "properties": {
        "profile": {"const": "smoke"},
        "mode": {"enum": ["initial", "reopen"]},
        "populated_size": {"const": 4},
        "sequence_ordinal": {"maximum": 7}
      }
    },
    {
      "properties": {
        "profile": {"const": "smoke"},
        "mode": {"enum": ["allocation", "allocation-reopen"]},
        "populated_size": {"const": 4},
        "sequence_ordinal": {"minimum": 8, "maximum": 15}
      }
    },
    {
      "properties": {
        "profile": {"const": "full"},
        "mode": {"enum": ["initial", "reopen"]},
        "populated_size": {"enum": [100, 1000, 10000]},
        "sequence_ordinal": {"maximum": 23}
      }
    },
    {
      "properties": {
        "profile": {"const": "full"},
        "mode": {"enum": ["allocation", "allocation-reopen"]},
        "populated_size": {"const": 8},
        "sequence_ordinal": {"minimum": 24, "maximum": 31}
      }
    }
  ]
}
