              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "smoke"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "profile": {
                "const": "smoke"
              }
            }
          },
          "runs": {
            "maxItems": 16
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "full"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "profile": {
                "const": "full"
              }
            }
          },
          "runs": {
            "maxItems": 32
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "collection-failed"
          }
        }
      }
    }
  ]
}
