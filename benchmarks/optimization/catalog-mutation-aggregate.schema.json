        },
        "normal_totals": {},
        "allocation_totals": {},
        "totals": {},
        "order": {
          "const": "sizes-ascending-shapes-distinct-shared-parity-first-arm-adjacent-reopen"
        },
        "maximum_normal_seconds": {},
