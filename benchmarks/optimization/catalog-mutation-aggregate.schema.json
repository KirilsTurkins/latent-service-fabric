{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Closed bounded envelope; exact source, process, fixture, operation and observer associations require mandatory semantic replay.",
  "title": "Catalog mutation aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "status",
    "population_complete",
    "attempt_count_complete",
    "qualifying_full_population",
    "scope",
    "suite",
    "builds",
    "plan",
    "sources",
    "validated_commands",
    "validated_resolves",
    "validated_invocations",
    "validated_mutations",
    "validated_reopens",
    "validated_collectors",
    "planned_collectors",
    "elapsed_nanos",
    "normal_elapsed_nanos",
    "allocation_elapsed_nanos",
    "runs",
    "normal_pairs",
    "allocation_pairs",
    "comparison_scope"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.catalog-mutation-aggregate.v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "failed"
      ]
    },
    "population_complete": {
      "type": "boolean"
    },
    "attempt_count_complete": {
      "type": "boolean"
    },
    "qualifying_full_population": {
      "type": "boolean"
    },
    "scope": {
      "const": "zero-invoke-public-versioned-mutations-adjacent-reopen-and-separate-allocation"
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "suite.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "builds": {
      "$ref": "#/$defs/artifact"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "candidate"
      ],
      "properties": {
        "control": {
          "type": "object",
          "maxProperties": 4096
        },
        "candidate": {
          "type": "object",
          "maxProperties": 4096
        }
      }
    },
    "validated_commands": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "validated_resolves": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "validated_invocations": {
      "const": "0"
    },
    "validated_mutations": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "validated_reopens": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "validated_collectors": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "planned_collectors": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "normal_elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "allocation_elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "runs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "maxProperties": 96
      }
    },
    "normal_pairs": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "maxProperties": 4096
      }
    },
    "allocation_pairs": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "maxProperties": 4096
      }
    },
    "comparison_scope": {
      "const": "one-paired-observation-per-size-shape-operation-no-process-quantiles"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetition",
        "variant",
        "shape",
        "populated_size",
        "mode",
        "sequence_ordinal"
      ],
      "properties": {
        "repetition": {
          "type": "integer",
          "const": 1
        },
        "variant": {
          "enum": [
            "control",
            "candidate"
          ]
        },
        "shape": {
          "enum": [
            "distinct",
            "shared"
          ]
        },
        "populated_size": {
          "type": "integer",
          "enum": [
            4,
            100,
            1000,
            10000
          ]
        },
        "mode": {
          "enum": [
            "initial",
            "reopen",
            "allocation",
            "allocation-reopen"
          ]
        },
        "sequence_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "normal_sizes",
        "allocation_size",
        "pairs_per_size_shape",
        "rows",
        "mutations",
        "normal_totals",
        "allocation_totals",
        "totals",
        "order",
        "maximum_normal_seconds",
        "maximum_allocation_seconds",
        "maximum_artifact_bytes",
        "maximum_artifact_files",
        "maximum_folded_expanded_bytes",
        "maximum_profile_records",
        "maximum_document_bytes",
        "maximum_row_bytes",
        "maximum_samples",
        "sampler_interval_millis",
        "measured_symbols",
        "normal_boundary",
        "reopen_boundary",
        "allocation_boundary",
        "allocation_reopen_boundary"
      ],
      "properties": {
        "schema": {
          "const": "latent.optimization.catalog-mutation-suite-plan.v1"
