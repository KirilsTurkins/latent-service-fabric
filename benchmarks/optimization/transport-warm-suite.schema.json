{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.fabric/schemas/optimization/transport-warm-suite.schema.json",
  "$comment": "Bounded structural envelope. Mandatory exact source/build, plan, ownership, hash and offered-population replay uses tools.optimization_revision_evidence.validate_suite or recovery_builds.load. Smoke never qualifies as full evidence.",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1048576
        },
        {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "plan",
    "requested_refs",
    "status",
    "reason",
    "elapsed_nanos",
    "measurement_elapsed_nanos",
    "identity",
    "cleanup",
    "runs",
    "artifacts",
    "builds",
    "clock_ticks_per_second"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.transport-warm-suite.v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "plan": {
      "oneOf": [
        {
          "const": {
            "schema": "latent.optimization.transport-warm-plan.v1",
            "profile": "smoke",
            "repetitions": 1,
            "scenarios": [
              "cold-restart"
            ],
            "cases": [
              {
                "id": "prewarm-echo",
                "client_plan": {
                  "schema": "latent.optimization.client-plan.v1",
                  "tenant": "optimization",
                  "services": [
                    "optimization/workloads"
                  ],
                  "contract": "optimization:benchmark/workloads@0.1.0",
                  "route": null,
                  "function": "echo",
                  "payload": [
                    "optimization-reference-v1"
                  ],
                  "warmup_attempts": 0,
                  "measured_attempts": 1,
                  "batch_size": 1,
                  "concurrency": 1,
                  "runtime_workers": 2,
                  "schedule": {
                    "mode": "closed-loop"
                  },
                  "budget_millis": 1000,
                  "cpu_fuel": 10000000000,
                  "memory_bytes": 67108864,
                  "log_bytes": 16384,
                  "connect_timeout_millis": 5000,
                  "response_timeout_millis": 5000,
                  "maximum_output_bytes": 33554432
                }
              },
              {
                "id": "warm-echo",
                "client_plan": {
                  "schema": "latent.optimization.client-plan.v1",
                  "tenant": "optimization",
                  "services": [
                    "optimization/workloads"
                  ],
                  "contract": "optimization:benchmark/workloads@0.1.0",
                  "route": null,
                  "function": "echo",
                  "payload": [
                    "optimization-reference-v1"
                  ],
                  "warmup_attempts": 4,
                  "measured_attempts": 12,
                  "batch_size": 12,
                  "concurrency": 1,
                  "runtime_workers": 2,
                  "schedule": {
                    "mode": "closed-loop"
                  },
                  "budget_millis": 1000,
                  "cpu_fuel": 10000000000,
                  "memory_bytes": 67108864,
                  "log_bytes": 16384,
                  "connect_timeout_millis": 5000,
                  "response_timeout_millis": 5000,
                  "maximum_output_bytes": 33554432
                }
              }
            ],
            "setup_cases": [
              "prewarm-echo"
            ],
            "maximum_run_seconds": "600",
            "maximum_build_seconds": "10800",
            "maximum_artifact_bytes": "1073741824",
            "build_profile": "release",
            "pair_order": "odd-control-candidate-even-candidate-control",
            "timer_observation": "unavailable-external-daemon-use-separate-recovery-diagnostic"
          }
        },
        {
          "const": {
            "schema": "latent.optimization.transport-warm-plan.v1",
            "profile": "full",
            "repetitions": 7,
            "scenarios": [
              "cold-restart"
            ],
            "cases": [
              {
                "id": "prewarm-echo",
                "client_plan": {
                  "schema": "latent.optimization.client-plan.v1",
                  "tenant": "optimization",
                  "services": [
                    "optimization/workloads"
                  ],
                  "contract": "optimization:benchmark/workloads@0.1.0",
                  "route": null,
                  "function": "echo",
                  "payload": [
                    "optimization-reference-v1"
                  ],
                  "warmup_attempts": 0,
                  "measured_attempts": 1,
                  "batch_size": 1,
                  "concurrency": 1,
                  "runtime_workers": 2,
                  "schedule": {
                    "mode": "closed-loop"
                  },
                  "budget_millis": 1000,
                  "cpu_fuel": 10000000000,
                  "memory_bytes": 67108864,
                  "log_bytes": 16384,
                  "connect_timeout_millis": 5000,
                  "response_timeout_millis": 5000,
                  "maximum_output_bytes": 33554432
                }
              },
              {
                "id": "warm-echo",
                "client_plan": {
                  "schema": "latent.optimization.client-plan.v1",
                  "tenant": "optimization",
                  "services": [
                    "optimization/workloads"
                  ],
                  "contract": "optimization:benchmark/workloads@0.1.0",
                  "route": null,
                  "function": "echo",
                  "payload": [
                    "optimization-reference-v1"
                  ],
                  "warmup_attempts": 40,
                  "measured_attempts": 400,
                  "batch_size": 100,
                  "concurrency": 1,
                  "runtime_workers": 2,
                  "schedule": {
                    "mode": "closed-loop"
                  },
                  "budget_millis": 1000,
                  "cpu_fuel": 10000000000,
                  "memory_bytes": 67108864,
                  "log_bytes": 16384,
                  "connect_timeout_millis": 5000,
                  "response_timeout_millis": 5000,
                  "maximum_output_bytes": 33554432
                }
              }
            ],
            "setup_cases": [
              "prewarm-echo"
            ],
            "maximum_run_seconds": "1800",
            "maximum_build_seconds": "10800",
            "maximum_artifact_bytes": "1073741824",
            "build_profile": "release",
            "pair_order": "odd-control-candidate-even-candidate-control",
            "timer_observation": "unavailable-external-daemon-use-separate-recovery-diagnostic"
          }
        }
      ]
    },
    "requested_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "candidate",
        "harness"
      ],
      "properties": {
        "control": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "harness": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "reason": {
      "enum": [
        null,
        "collection-failed"
      ]
    },
    "elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "measurement_elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "identity": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "cleanup": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "runs": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/json"
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "builds": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "clock_ticks_per_second": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": null
          },
          "builds": {
            "$ref": "#/$defs/artifact"
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "const": "collection-failed"
          }
        }
      }
    }
  ]
}
