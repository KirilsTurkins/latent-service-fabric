{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.fabric/schemas/optimization/codec-aggregate.schema.json",
  "$comment": "Structural bounds only; tools.optimization_codec.evidence.validate_suite performs required exact-source, semantic, ownership and allocation replay.",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1048576
        },
        {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "status",
    "suite_sha256",
    "builds",
    "population_complete",
    "attempt_count_complete",
    "attempted_processes",
    "validated_processes",
    "validated_codec_operations",
    "validated_preflight_operations",
    "validated_warmup_operations",
    "validated_measured_operations",
    "guest_invocations",
    "runs",
    "pairs",
    "across_pairs",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.codec-aggregate.v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "failed"
      ]
    },
    "suite_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "builds": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "population_complete": {
      "type": "boolean"
    },
    "attempt_count_complete": {
      "type": "boolean"
    },
    "attempted_processes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 168
    },
    "validated_processes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "validated_codec_operations": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "validated_preflight_operations": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "validated_warmup_operations": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "validated_measured_operations": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "guest_invocations": {
      "const": "0"
    },
    "runs": {
      "type": "array",
      "maxItems": 168,
      "items": {
        "$ref": "#/$defs/json"
      }
    },
    "pairs": {
      "type": "array",
      "maxItems": 84,
      "items": {
        "$ref": "#/$defs/json"
      }
    },
    "across_pairs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/json"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "profile": {
            "const": "full"
          },
          "population_complete": {
            "const": true
          },
          "attempt_count_complete": {
            "const": true
          },
          "attempted_processes": {
            "const": 168
          },
          "validated_processes": {
            "const": "168"
          },
          "validated_codec_operations": {
            "const": "449680"
          },
          "validated_preflight_operations": {
            "const": "1008"
          },
          "validated_warmup_operations": {
            "const": "6720"
          },
          "validated_measured_operations": {
            "const": "441952"
          }
        }
      }
    }
  ]
}
