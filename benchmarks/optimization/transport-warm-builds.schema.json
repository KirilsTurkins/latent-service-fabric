{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.fabric/schemas/optimization/transport-warm-builds.schema.json",
  "$comment": "Bounded structural envelope. Mandatory exact source/build, plan, ownership, hash and offered-population replay uses tools.optimization_revision_evidence.validate_suite or recovery_builds.load. Smoke never qualifies as full evidence.",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1048576
        },
        {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "reason",
    "elapsed_nanos",
    "requested_refs",
    "identity",
    "cleanup",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.transport-warm-builds.v1"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "reason": {
      "enum": [
        null,
        "collection-failed"
      ]
    },
    "elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "requested_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "candidate",
        "harness"
      ],
      "properties": {
        "control": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "harness": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "identity": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "cleanup": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "const": "collection-failed"
          }
        }
      }
    }
  ]
}
