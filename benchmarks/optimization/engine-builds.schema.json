{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "engine-builds evidence envelope",
  "description": "Closed bounded envelope. Complete source, ordering, configuration, outcome and ownership qualification requires the matching semantic replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requested_refs",
    "build",
    "builds",
    "harness",
    "cleanup",
    "fixtures"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.engine-builds.v1"
    },
    "requested_refs": {
      "type": "object"
    },
    "build": {
      "type": "object"
    },
    "builds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "candidate"
      ],
      "properties": {
        "control": {
          "type": "object"
        },
        "candidate": {
          "type": "object"
        }
      }
    },
    "harness": {
      "type": "object"
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_worktree_removed"
      ],
      "properties": {
        "owned_worktree_removed": {
          "const": true
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        }
      }
    }
  }
}
