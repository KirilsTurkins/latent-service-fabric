{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.fabric/schemas/optimization/codec-suite.schema.json",
  "$comment": "Structural bounds only; tools.optimization_codec.evidence.validate_suite performs required exact-source, semantic, ownership and allocation replay.",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1048576
        },
        {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "plan",
    "builds",
    "runner_source",
    "runner_source_after",
    "status",
    "reason",
    "elapsed_nanos",
    "tools",
    "symbols",
    "runs",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "latent.optimization.codec-suite.v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "plan": {
      "oneOf": [
        {
          "const": {
            "schema": "latent.optimization.codec-population.v1",
            "profile": "smoke",
            "pairs": 1,
            "families": [
              "scalar-params",
              "byte-list",
              "nested-record",
              "string-64k",
              "string-near-limit",
              "escaped-unicode"
            ],
            "modes": [
              "normal",
              "allocation"
            ],
            "family_plans": [
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "smoke",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "scalar-params",
                "warmup_iterations": 2,
                "measured_iterations": 4,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "smoke",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "byte-list",
                "warmup_iterations": 2,
                "measured_iterations": 4,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "smoke",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "nested-record",
                "warmup_iterations": 2,
                "measured_iterations": 4,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "smoke",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "string-64k",
                "warmup_iterations": 2,
                "measured_iterations": 4,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "smoke",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "string-near-limit",
                "warmup_iterations": 2,
                "measured_iterations": 4,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "smoke",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "escaped-unicode",
                "warmup_iterations": 2,
                "measured_iterations": 4,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              }
            ],
            "pair_order": "odd-control-candidate-even-candidate-control",
            "maximum_run_seconds": "7200",
            "maximum_artifact_bytes": "2147483648",
            "maximum_artifact_files": 4096,
            "maximum_profile_records": 12000000,
            "maximum_folded_expanded_bytes": "134217728",
            "normal_timeout_seconds": 90,
            "allocation_timeout_seconds": 180,
            "extraction_timeout_seconds": 120,
            "symbols": [
              "latent_wasmtime::values::tests::measurement::measured_decode_and_drop",
              "latent_wasmtime::values::tests::measurement::measured_encode_and_drop"
            ],
            "boundary": "separate-actual-codec-and-result-drop-batches-no-guest-invocation"
          }
        },
        {
          "const": {
            "schema": "latent.optimization.codec-population.v1",
            "profile": "full",
            "pairs": 7,
            "families": [
              "scalar-params",
              "byte-list",
              "nested-record",
              "string-64k",
              "string-near-limit",
              "escaped-unicode"
            ],
            "modes": [
              "normal",
              "allocation"
            ],
            "family_plans": [
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "full",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "scalar-params",
                "warmup_iterations": 20,
                "measured_iterations": 4096,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "full",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "byte-list",
                "warmup_iterations": 20,
                "measured_iterations": 573,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "full",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "nested-record",
                "warmup_iterations": 20,
                "measured_iterations": 2943,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "full",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "string-64k",
                "warmup_iterations": 20,
                "measured_iterations": 127,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "full",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "string-near-limit",
                "warmup_iterations": 20,
                "measured_iterations": 68,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              },
              {
                "schema": "latent.optimization.codec-plan.v1",
                "profile": "full",
                "repetition": 1,
                "variant": "control",
                "mode": "normal",
                "family": "escaped-unicode",
                "warmup_iterations": 20,
                "measured_iterations": 85,
                "observation_hold_millis": 100,
                "maximum_output_bytes": "8388608"
              }
            ],
            "pair_order": "odd-control-candidate-even-candidate-control",
            "maximum_run_seconds": "7200",
            "maximum_artifact_bytes": "2147483648",
            "maximum_artifact_files": 4096,
            "maximum_profile_records": 12000000,
            "maximum_folded_expanded_bytes": "134217728",
            "normal_timeout_seconds": 90,
            "allocation_timeout_seconds": 180,
            "extraction_timeout_seconds": 120,
            "symbols": [
              "latent_wasmtime::values::tests::measurement::measured_decode_and_drop",
              "latent_wasmtime::values::tests::measurement::measured_encode_and_drop"
            ],
            "boundary": "separate-actual-codec-and-result-drop-batches-no-guest-invocation"
          }
        }
      ]
    },
    "builds": {
      "$ref": "#/$defs/artifact"
    },
    "runner_source": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "runner_source_after": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "reason": {
      "enum": [
        null,
        "collection-failed"
      ]
    },
    "elapsed_nanos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "tools": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "symbols": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "runs": {
      "type": "array",
      "maxItems": 168,
      "items": {
        "$ref": "#/$defs/json"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  }
}
