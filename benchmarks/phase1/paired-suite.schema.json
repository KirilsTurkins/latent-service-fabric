{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/benchmarks/phase1/paired-suite.schema.json",
  "title": "paired-suite shape (semantic replay is also required)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "method",
    "profile",
    "plan",
    "control_build",
    "candidate_guest_sources",
    "runs",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "latent.phase1.paired-suite.v1"
    },
    "method": {
      "const": "historical-runtime-productionization-bundle-v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "repetition",
        "warmup_samples",
        "measured_samples",
        "maximum_run_seconds",
        "maximum_output_bytes"
      ],
      "properties": {
        "schema": {
          "const": "latent.phase1.paired-plan.v1"
        },
        "profile": {
          "enum": [
            "smoke",
            "full"
          ]
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "warmup_samples": {
          "enum": [
            2,
            40
          ]
        },
        "measured_samples": {
          "enum": [
            4,
            400
          ]
        },
        "maximum_run_seconds": {
          "enum": [
            "120",
            "600"
          ]
        },
        "maximum_output_bytes": {
          "const": "16777216"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "const": "smoke"
              }
            }
          },
          "then": {
            "properties": {
              "warmup_samples": {
                "const": 2
              },
              "measured_samples": {
                "const": 4
              },
              "maximum_run_seconds": {
                "const": "120"
              }
            }
          },
          "else": {
            "properties": {
              "warmup_samples": {
                "const": 40
              },
              "measured_samples": {
                "const": 400
              },
              "maximum_run_seconds": {
                "const": "600"
              }
            }
          }
        }
      ]
    },
    "control_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "candidate_guest_sources": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "artifact"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              }
            }
          }
        }
      }
    },
    "historical_method_sources": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "artifact"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              }
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repetition",
          "arm",
          "status",
          "reason",
          "identity",
          "command",
          "started_micros",
          "finished_micros",
          "raw",
          "process",
          "cleanup",
          "host_after"
        ],
        "properties": {
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "arm": {
            "enum": [
              "control",
              "candidate"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "identity": {
            "type": "object"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "started_micros": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "finished_micros": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "raw": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "process": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "cleanup": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "host_after": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          }
        }
      }
    }
  }
}
