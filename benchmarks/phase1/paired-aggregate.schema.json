{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/benchmarks/phase1/paired-aggregate.schema.json",
  "title": "paired-aggregate shape (semantic replay is also required)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "method",
    "profile",
    "status",
    "phase1_completion",
    "observational_only",
    "source",
    "controls",
    "population",
    "arms",
    "pairs",
    "across_pairs",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "latent.phase1.paired-aggregate.v1"
    },
    "method": {
      "const": "historical-runtime-productionization-bundle-v1"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "incomplete"
      ]
    },
    "phase1_completion": {
      "const": "incomplete"
    },
    "observational_only": {
      "const": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "controls": {
      "type": "object"
    },
    "population": {
      "type": "object"
    },
    "arms": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object"
      }
    },
    "pairs": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object"
      }
    },
    "across_pairs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
