root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonl,proto,wit,yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Preserve exact-byte fixtures and pinned upstream data. Their contents are
# validated as repository inputs rather than normalized by editor settings.
[**/fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[**/testdata/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[wit/deps/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Generated output and retained benchmark evidence must remain byte-stable.
[.generated/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[benchmarks/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[*.{bin,gif,gz,jpeg,jpg,png,tar,wasm,zst}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
