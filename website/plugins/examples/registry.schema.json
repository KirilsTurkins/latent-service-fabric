{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LSF example registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}
