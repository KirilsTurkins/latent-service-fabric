          "before": "exports.isInteger = num => {",
          "after": "// The maintained derivative bounds every AST walker before recursion.\nexports.MAX_AST_DEPTH = 128;\nexports.assertDepth = ast => {\n  const pending = [[ast, 0]];\n  let count = 1;\n  while (pending.length) {\n    const [node, depth] = pending.pop();\n    if (depth > exports.MAX_AST_DEPTH) {\n      throw new RangeError('braces AST depth exceeds the maintained limit');\n    }\n    if (node && Array.isArray(node.nodes)) {\n      for (const child of node.nodes) {\n        if (++count > 65536) {\n          throw new RangeError('braces AST nodes exceed the maintained limit');\n        }\n        pending.push([child, depth + 1]);\n      }\n    }\n  }\n};\n\nexports.isInteger = num => {",
