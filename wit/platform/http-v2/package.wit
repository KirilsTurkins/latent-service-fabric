package latent:http@0.2.0;

// Immediate bounded operations. Success means a complete HTTP response, not
// application success or transactional acceptance. No automatic retry is implied.
interface client {
    enum method { get, head, post, put, patch, delete, options }

    record header { name: string, value: string }

    record request {
        method: method,
        url: string,
        headers: list<header>,
        body: option<list<u8>>,
        body-media-type: option<string>,
        idempotency-key: option<string>,
        timeout-millis: option<u64>,
    }

    record response {
        status: u16,
        headers: list<header>,
        body: list<u8>,
        body-media-type: option<string>,
    }

    variant http-error {
        invalid-url,
        invalid-request,
        permission-denied,
        request-too-large,
        response-too-large,
        deadline-exceeded,
        cancelled,
        budget-exhausted,
        dns-failed,
        tls-failed,
        connection-failed,
        unavailable,
        // The remote operation may have occurred. Cancellation or loss of a
        // response does not undo it; an idempotency key is not retry authority.
        uncertain,
    }

    send: async func(request: request) -> result<response, http-error>;
}
