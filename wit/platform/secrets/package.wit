package latent:secrets@0.1.0;

interface reader {
    record secret-value {
        bytes: list<u8>,
        media-type: string,
        version: option<string>,
        expires-at-unix-millis: option<u64>,
    }

    variant secret-error {
        not-found,
        permission-denied,
        expired,
        unavailable,
    }

    read: func(reference: string) -> result<secret-value, secret-error>;
}
