package latent:platform@0.2.0;

// Recognition profile only. An application imports just the interfaces it
// requires; publication/binding still needs separately installed providers and
// current activation grants. State/timers remain later-phase contracts.
world capsule {
    import latent:context/context@0.1.0;
    import latent:log/log@0.1.0;
    import latent:clock/monotonic@0.1.0;
    import latent:clock/wall@0.1.0;
    import latent:random/random@0.1.0;
    import latent:blob/blob@0.1.0;
    import latent:secrets/reader@0.1.0;
    import latent:events/publisher@0.2.0;
    import latent:http/client@0.2.0;
    import latent:telemetry/custom@0.1.0;
    import latent:service/invoke@0.1.0;
}
