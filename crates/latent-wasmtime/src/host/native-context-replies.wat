;; Tiny ordinary sync-WIT context adapter control. No guest engine/compiler.
(component
  (type $context (instance
          (type (;0;) (option string))
          (type (;1;) (tuple string string))
          (type (;2;) (list 1))
          (type (;3;) (record (field "subject" string) (field "kind" string) (field "tenant" 0) (field "service" 0) (field "claims" 2)))
          (export (;4;) "invocation-principal" (type (eq 3)))
          (type (;5;) (record (field "trace-id" string) (field "span-id" string) (field "trace-flags" u8) (field "baggage" 2)))
          (export (;6;) "trace-context" (type (eq 5)))
          (type (;7;) (option u64))
          (type (;8;) (record (field "cpu-fuel" u64) (field "memory-bytes" u64) (field "wall-time-limit-millis" 7) (field "child-calls" u32) (field "outbound-requests" u32) (field "state-read-bytes" u64) (field "state-write-bytes" u64) (field "blob-read-bytes" u64) (field "blob-write-bytes" u64) (field "log-bytes" u64) (field "effect-count" u32)))
          (export (;9;) "resource-budget" (type (eq 8)))
          (type (;10;) (func (result string)))
          (export (;0;) "activation-id" (func (type 10)))
          (export (;1;) "root-activation-id" (func (type 10)))
          (type (;11;) (func (result 0)))
          (export (;2;) "parent-activation-id" (func (type 11)))
          (type (;12;) (func (result 4)))
          (export (;3;) "principal" (func (type 12)))
          (type (;13;) (func (result 6)))
          (export (;4;) "trace" (func (type 13)))
          (type (;14;) (func (result 7)))
          (export (;5;) "deadline-unix-millis" (func (type 14)))
          (type (;15;) (func (result 9)))
          (export (;6;) "remaining-budget" (func (type 15)))
          (type (;16;) (func (result 2)))
          (export (;7;) "metadata" (func (type 16)))
        ))
  (import "latent:context/context@0.1.0" (instance $context (type $context)))
  (alias export $context "invocation-principal" (type $principal))
  (alias export $context "trace-context" (type $trace))
  (alias export $context "resource-budget" (type $budget))
  (type $pairs (list (tuple string string)))
  (core module $allocation
    (memory (export "memory") 2)
    (global $next (mut i32) (i32.const 4096))
    (global $mode (mut i32) (i32.const 0))
    (func (export "mode") (param i32) local.get 0 global.set $mode)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) (local $ptr i32)
      global.get $mode i32.const 1 i32.eq if unreachable end
      global.get $mode i32.const 2 i32.eq if (loop $pending br $pending) end
      global.get $next local.get 2 i32.const 1 i32.sub i32.add
      i32.const 0 local.get 2 i32.sub i32.and local.tee $ptr
      local.get 3 i32.add global.set $next local.get $ptr))
  (core instance $allocation (instantiate $allocation))
  (alias export $context "activation-id" (func $host0))
  (core func $lower0 (canon lower (func $host0) (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (alias export $context "root-activation-id" (func $host1))
  (core func $lower1 (canon lower (func $host1) (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (alias export $context "parent-activation-id" (func $host2))
  (core func $lower2 (canon lower (func $host2) (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (alias export $context "principal" (func $host3))
  (core func $lower3 (canon lower (func $host3) (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (alias export $context "trace" (func $host4))
  (core func $lower4 (canon lower (func $host4) (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (alias export $context "metadata" (func $host5))
  (core func $lower5 (canon lower (func $host5) (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (alias export $context "deadline-unix-millis" (func $host6))
  (core func $lower6 (canon lower (func $host6) (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (alias export $context "remaining-budget" (func $host7))
  (core func $lower7 (canon lower (func $host7) (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (core module $bridge
    (import "host" "activation-id" (func $h0 (param i32)))
    (import "host" "root-activation-id" (func $h1 (param i32)))
    (import "host" "parent-activation-id" (func $h2 (param i32)))
    (import "host" "principal" (func $h3 (param i32)))
    (import "host" "trace" (func $h4 (param i32)))
    (import "host" "metadata" (func $h5 (param i32)))
    (import "host" "deadline-unix-millis" (func $h6 (param i32)))
    (import "host" "remaining-budget" (func $h7 (param i32)))
    (func (export "activation-id") (result i32) i32.const 0 call $h0 i32.const 0)
    (func (export "root-activation-id") (result i32) i32.const 0 call $h1 i32.const 0)
    (func (export "parent-activation-id") (result i32) i32.const 0 call $h2 i32.const 0)
    (func (export "principal") (result i32) i32.const 0 call $h3 i32.const 0)
    (func (export "trace") (result i32) i32.const 0 call $h4 i32.const 0)
    (func (export "metadata") (result i32) i32.const 0 call $h5 i32.const 0)
    (func (export "deadline-unix-millis") (result i32) i32.const 0 call $h6 i32.const 0)
    (func (export "remaining-budget") (result i32) i32.const 0 call $h7 i32.const 0)
)
  (core instance $host
    (export "activation-id" (func $lower0))
    (export "root-activation-id" (func $lower1))
    (export "parent-activation-id" (func $lower2))
    (export "principal" (func $lower3))
    (export "trace" (func $lower4))
    (export "metadata" (func $lower5))
    (export "deadline-unix-millis" (func $lower6))
    (export "remaining-budget" (func $lower7))
)
  (core instance $bridge (instantiate $bridge (with "host" (instance $host))))
  (func (export "activation-id") (result string) (canon lift (core func $bridge "activation-id") (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (func (export "root-activation-id") (result string) (canon lift (core func $bridge "root-activation-id") (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (func (export "parent-activation-id") (result (option string)) (canon lift (core func $bridge "parent-activation-id") (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (func (export "principal") (result $principal) (canon lift (core func $bridge "principal") (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (func (export "trace") (result $trace) (canon lift (core func $bridge "trace") (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (func (export "metadata") (result $pairs) (canon lift (core func $bridge "metadata") (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (func (export "deadline-unix-millis") (result (option u64)) (canon lift (core func $bridge "deadline-unix-millis") (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (func (export "remaining-budget") (result $budget) (canon lift (core func $bridge "remaining-budget") (memory $allocation "memory") (realloc (func $allocation "realloc")) string-encoding=utf8))
  (func (export "mode") (param "mode" u32) (canon lift (core func $allocation "mode")))
)
