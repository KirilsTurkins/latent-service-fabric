;; Synthetic canonical values; echo-post has an explicit async component type.
;; Its core ABI, canon lift and post-return remain synchronous.
(component
  (import "wait" (func $wait))
  (core func $lower (canon lower (func $wait)))
  (core module $m
    (import "host" "wait" (func $wait))
    (memory (export "memory") 1)
    (data (i32.const 0) "\80\00\00\00\04\00\00\00")
    (data (i32.const 8) "\88\00\00\00\03\00\00\00")
    (data (i32.const 16) "\90\00\00\00\02\00\00\00")
    (data (i32.const 24) "\00\02\00\00\00\04\00\00")
    (data (i32.const 32) "\01\00\00\00\80\00\00\00\04\00\00\00")
    (data (i32.const 64) "\80\00\00\00\04\00\00\00\05\00\00\00\00\00\00\00\80\00\00\00\04\00\00\00")
    (data (i32.const 96) "\80\00\00\00\04\00\00\00\94\00\00\00\01\00\00\00")
    (data (i32.const 128) "tiny")
    (data (i32.const 136) "\e9\00\3d\d8\00\de")
    (data (i32.const 144) "\e9\ff")
    (data (i32.const 148) "\ff")
    (func (export "utf8") (result i32) i32.const 0)
    (func (export "utf16") (result i32) i32.const 8)
    (func (export "latin1") (result i32) i32.const 16)
    (func (export "large") (result i32) i32.const 24)
    (func (export "declared") (result i32) i32.const 32)
    (func (export "nested") (result i32) i32.const 64)
    (func (export "partial") (result i32) i32.const 96)
    (func (export "echo") (param i32 i32) (result i32) i32.const 0)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) i32.const 256)
    (func (export "post") (param i32) call $wait))
  (core instance $host (export "wait" (func $lower)))
  (core instance $i (instantiate $m (with "host" (instance $host))))
  (func (export "utf8") (result string)
    (canon lift (core func $i "utf8") (memory $i "memory")))
  (func (export "utf16") (result string)
    (canon lift (core func $i "utf16") (memory $i "memory") string-encoding=utf16))
  (func (export "latin1") (result string)
    (canon lift (core func $i "latin1") (memory $i "memory") string-encoding=latin1+utf16))
  (func (export "large") (result string)
    (canon lift (core func $i "large") (memory $i "memory")))
  (func (export "declared") (result (result u32 (error string)))
    (canon lift (core func $i "declared") (memory $i "memory")))
  (type $flags-def (flags "read" "write" "admin"))
  (export $flags "flags-type" (type $flags-def))
  (type $choice-def (variant (case "one" string)))
  (export $choice "choice-type" (type $choice-def))
  (type $nested-def (record (field "name" string) (field "permissions" $flags) (field "choice" $choice)))
  (export $nested "nested-type" (type $nested-def))
  (func (export "nested") (result $nested)
    (canon lift (core func $i "nested") (memory $i "memory")))
  (type $partial-def (record (field "first" string) (field "invalid" string)))
  (export $partial "partial-type" (type $partial-def))
  (func (export "partial") (result $partial)
    (canon lift (core func $i "partial") (memory $i "memory")))
  (type $echo-post-type (func async (param "input" string) (result string)))
  (func (export "echo-post") (type $echo-post-type)
    (canon lift (core func $i "echo") (memory $i "memory") (realloc (core func $i "realloc")) (post-return (core func $i "post"))))
  (func (export "post-wait") (result string)
    (canon lift (core func $i "utf8") (memory $i "memory") (post-return (core func $i "post")))))
