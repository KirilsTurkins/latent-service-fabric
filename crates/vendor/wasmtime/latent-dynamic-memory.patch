+        struct PanicOnDrop;
+        impl std::task::Wake for PanicOnDrop {
+            fn wake(self: std::sync::Arc<Self>) {}
+        }
+        impl Drop for PanicOnDrop {
+            fn drop(&mut self) {
+                panic!("controlled state-waker unwind");
+            }
+        }
