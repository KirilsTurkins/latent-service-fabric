+/// Exact continuation backing without assuming a zero Option discriminant.
+unsafe fn alloc_dynamic_cont_table_elements(len: usize) -> Result<TryVec<ContTableElem>> {
+    let layout = Layout::array::<ContTableElem>(len)?;
