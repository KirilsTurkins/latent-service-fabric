+    Accounted(NativeVec<(K, V)>),
+}
+
+pub(super) enum RegistryIndices {
+    Legacy(TrySecondaryMap<StaticModuleIndex, Option<RegisteredModuleId>>),
+    Accounted(NativeVec<Option<RegisteredModuleId>>),
