+    assert_eq!(polls.load(SeqCst), 2);
+    drop(escaped);
+    drop(waker.lock().unwrap().take());
+    drop(set);
+    assert_eq!(probe.requests.load(SeqCst), 4);
+    assert_eq!(probe.live.load(SeqCst), 0);
