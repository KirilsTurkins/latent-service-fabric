# `dist/index.js` is a special file in Actions.
# When you reference an action with `uses:` in a workflow,
# `index.js` is the code that will run.
# For our project, we generate this file through a build process
# from other source files.
# We need to make sure the checked-in `index.js` actually matches what we expect it to be.
name: Check dist

on:
  push:
    branches:
      - main
      - development
      - feat/security-deepmerge-20261029
    paths-ignore:
      - '**.md'
  pull_request:
    paths-ignore:
      - '**.md'
  workflow_dispatch:

jobs:
  check-dist:
    if: github.ref != 'refs/heads/development' && github.ref != 'refs/heads/feat/security-deepmerge-20261029'
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v7

      - name: Set Node.js 24.x
        uses: actions/setup-node@v6
        with:
          node-version: 24.x

      - name: Install dependencies
        run: npm ci

      - name: Rebuild the index.js file
        run: npm run build

      - name: Compare the expected and actual dist/ directories
        run: |
          if [ "$(git diff --ignore-space-at-eol dist/ | wc -l)" -gt "0" ]; then
            echo "Detected uncommitted changes after build.  See status below:"
            git diff
            exit 1
          fi

      # If dist/ was different than expected, upload the expected version as an artifact
      - uses: actions/upload-artifact@v7
        if: ${{ failure() && steps.diff.conclusion == 'failure' }}
        with:
          name: dist
          path: dist/


  development-deepmerge:
    if: github.repository == 'KirilsTurkins/lsf-checkout' && (github.ref == 'refs/heads/development' || github.ref == 'refs/heads/feat/security-deepmerge-20261029')
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    permissions:
      contents: read
    env:
      npm_config_registry: https://registry.npmjs.org/
      npm_config_update_notifier: 'false'
    steps:
      - uses: KirilsTurkins/lsf-checkout@c3024dfac542bb46ebccc7829ddf1f95e0be8da9
        with:
          persist-credentials: false
      - uses: KirilsTurkins/lsf-setup-node@c1136b2d97fe79ef645e9508b2048a222f50a170
        with:
          node-version: 24.19.0
          package-manager-cache: false
      - name: Require existing exact tools and empty npm configuration
        run: |
          export npm_config_userconfig="$RUNNER_TEMP/deepmerge-user.npmrc"
          export npm_config_globalconfig="$RUNNER_TEMP/deepmerge-global.npmrc"
          export npm_config_cache="$RUNNER_TEMP/deepmerge-npm-cache"
          printf '%s\n' "npm_config_userconfig=$npm_config_userconfig" \
            "npm_config_globalconfig=$npm_config_globalconfig" \
            "npm_config_cache=$npm_config_cache" >> "$GITHUB_ENV"
          : > "$npm_config_userconfig"
          : > "$npm_config_globalconfig"
          test "$(node --version)" = 'v24.19.0'
          test "$(npm --version)" = '11.17.0'
      - name: Install the committed graph without lifecycle scripts
        run: npm ci --ignore-scripts --no-audit --no-fund
      - name: Require exact installed repaired source
        run: node .lsf-source/verify-installed-deepmerge.mjs > "$RUNNER_TEMP/deepmerge-installed.json"
      - name: Reuse existing action build and unit contracts
        run: |
          npm run build
          npm run format-check
          npm run lint
          npm test -- --runInBand
      - name: Require committed dist README and dependency inputs unchanged
        run: git diff --exit-code -- dist README.md package.json package-lock.json .lsf-source
      - uses: KirilsTurkins/lsf-upload-artifact@01d82cc6ae713563e8d04f36a17af500cf82a6a9
        if: always()
        with:
          name: checkout-development-deepmerge-${{ github.sha }}
          path: |
            ${{ runner.temp }}/deepmerge-installed.json
            dist/
            README.md
            package.json
            package-lock.json
            .lsf-source/
          if-no-files-found: warn
          retention-days: 3
