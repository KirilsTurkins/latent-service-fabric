{
  "name": "buf-setup",
  "version": "1.6.0",
  "scripts": {
    "build": "esbuild --minify --bundle --sourcemap '--define:process.env.NODE_ENV=\"production\"' --outdir=dist --platform=node --target=node24 ./src/main.ts",
    "eslint": "eslint --max-warnings 0 .",
    "format": "prettier --write '**/*.{json,js,jsx,ts,tsx,css}' --loglevel error",
    "lint": "npm run eslint && npm run types-check",
    "types-check": "tsc --noemit"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=20",
    "npm": ">=8"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "3.0.1",
    "https-proxy-agent": "^7.0.2",
    "semver": "^6.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "esbuild": "0.28.2",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "uuid@8": "11.1.1",
    "@fastify/busboy@2": "3.2.4",
    "@octokit/plugin-paginate-rest@9": "9.2.2",
    "@octokit/request@8": "8.4.1",
    "@octokit/request-error@5": "5.1.1",
    "undici@5": "6.29.1",
    "uuid@3": "11.1.1",
    "ajv@6": "6.15.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "braces@3": "3.0.3",
    "cross-spawn@7": "7.0.6",
    "esbuild@0": "0.28.2",
    "flatted@3": "3.4.4",
    "js-yaml@4": "4.3.2",
    "micromatch@4": "4.0.8",
    "minimatch@3": "3.1.5",
    "minimatch@9": "9.0.9",
    "picomatch@2": "2.3.2"
  }
}
