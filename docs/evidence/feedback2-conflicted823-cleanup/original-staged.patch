+pub(crate) fn server_version(line: &[u8]) -> Option<String> {
+    #[derive(Deserialize)]
+    struct Version<'a> {
+        #[serde(borrow)]
+        version: &'a str,
+    }
+    let bytes = line.strip_prefix(b"INFO ")?;
+    guard(bytes).ok()?;
