yml:runtime:Install pinned validation and bindings":{"job":"runtime","jobIf":"success()","name":"Install pinned validation and bindings","run":"python3 -m pip install --requirement tools/requirements.lock\npython3 tools/install_guest_bindgen.py \"$RUNNER_TEMP/guest-tools\"\necho \"$RUNNER_TEMP/guest-tools\" >> \"$GITHUB_PATH\"","shell":"default","stepIf":"success()","workflow":".github/workflows/c-guest-authoring.yml","workingDirectory":"."},".github/workflows/c-guest-authoring.yml:runtime:Qualify standalone C projects and the printed guide":{"job":"runtime","jobIf":"success()","name":"Qualify standalone C projects and the printed guide","run":"python3 -m unittest tools.tests.test_c_capsule_authoring\npython3 tools/qualify_c_capsules.py --output \"$RUNNER_TEMP/c-capsule-authoring\"","shell":"default","stepIf":"success()","workflow":".github/workflows/c-guest-authoring.yml","workingDirectory":"."},".github/workflows/ci.yml:catalog:Check catalog probe supervision":{"job":"catalog","jobIf":"needs.profile.outputs.profile == 'full'","name":"Check catalog probe supervision","run":"cargo test -p latentd --test catalog_scale --locked","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:catalog:Publish and reopen 100,000 dormant releases in isolated processes":{"job":"catalog","jobIf":"needs.profile.outputs.profile == 'full'","name":"Publish and reopen 100,000 dormant releases in isolated processes","run":"set -o pipefail\ncargo test -p latentd --test catalog_scale --locked production_catalog_100k -- --exact --ignored --nocapture --test-threads=1 2>&1 | tee catalog-scale.log","shell":"bash","stepIf":"github.event_name == 'workflow_dispatch' && inputs.run_catalog_scale","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:catalog:Run catalog recovery, routing, and dormancy regressions":{"job":"catalog","jobIf":"needs.profile.outputs.profile == 'full'","name":"Run catalog recovery, routing, and dormancy regressions","run":"cargo test -p latent-artifacts -p latent-control-store --lib --locked -- --nocapture","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:contracts:Install Python validator dependencies":{"job":"contracts","jobIf":"needs.profile.outputs.profile == 'full'","name":"Install Python validator dependencies","run":"python -m pip install --requirement tools/requirements.lock","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:contracts:Install verified guest binding generator":{"job":"contracts","jobIf":"needs.profile.outputs.profile == 'full'","name":"Install verified guest binding generator","run":"python3 tools/install_guest_bindgen.py \"${RUNNER_TEMP}/lsf-guest-tools\" >> \"${GITHUB_PATH}\"","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:contracts:Record echo capsule build evidence":{"job":"contracts","jobIf":"needs.profile.outputs.profile == 'full'","name":"Record echo capsule build evidence","run":"cat target/capsules/echo/build.json\ncat target/capsules/echo/sha256.txt","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:contracts:Validate contracts, echo component, and generated bindings":{"job":"contracts","jobIf":"needs.profile.outputs.profile == 'full'","name":"Validate contracts, echo component, and generated bindings","run":"unset CARGO_INCREMENTAL\ntools/validate_contracts.sh","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:contracts:Validate standalone optimization benchmark smoke":{"job":"contracts","jobIf":"needs.profile.outputs.profile == 'full'","name":"Validate standalone optimization benchmark smoke","run":"unset CARGO_INCREMENTAL\npython3 tools/run_optimization_benchmarks.py --profile smoke","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:docs:Install documentation validator dependencies":{"job":"docs","jobIf":"success()","name":"Install documentation validator dependencies","run":"python -m pip install --requirement tools/requirements.lock","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:docs:Preserve repository source contracts in the host-only profile":{"job":"docs","jobIf":"success()","name":"Preserve repository source contracts in the host-only profile","run":"python3 tools/validate_repository.py\npython3 tools/validate_foundation.py","shell":"default","stepIf":"needs.profile.outputs.profile == 'fast'","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:docs:Validate deterministic dependency regressions":{"job":"docs","jobIf":"success()","name":"Validate deterministic dependency regressions","run":"python3 -m unittest tools.tests.test_deterministic_tests tools.tests.test_testkit_dependencies","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:docs:Validate documentation and profile selection":{"job":"docs","jobIf":"success()","name":"Validate documentation and profile selection","run":"LSF_REQUIRE_NATIVE_PROCESS_TESTS=1 python3 -m unittest tools.tests.test_ci_profile tools.tests.test_validate_docs tools.tests.test_ci_suite_inventory tools.tests.test_ci_suite_discovery tools.tests.test_ci_result tools.tests.test_ci_coverage tools.tests.test_ci_browser_artifacts tools.tests.test_ci_lanes tools.tests.test_ci_lane_inventory tools.tests.test_local_tests tools.tests.test_ci_cargo tools.tests.test_ci_cargo_cache tools.tests.test_ci_cargo_aot_handoff\npython3 tools/ci_coverage.py\nLSF_REQUIRE_NATIVE_PROCESS_TESTS=1 pyt