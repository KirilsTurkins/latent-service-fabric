:"Prepare immutable browser lane component","run":"mkdir -p \"$RUNNER_TEMP/browser-component\"\ncargo build --locked -p latent-toolchain-smoke --example web-contract --target wasm32-unknown-unknown --release\nwasm-tools component new target/wasm32-unknown-unknown/release/examples/web_contract.wasm -o \"$RUNNER_TEMP/browser-component/application.wasm\"\nwasm-tools validate \"$RUNNER_TEMP/browser-component/application.wasm\"","shell":"default","stepIf":"needs.profile.outputs.renderer == 'true'","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:Qualify actual Angular on the protected T1 node":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"Qualify actual Angular on the protected T1 node","run":"python3 -m unittest tools.tests.test_angular_t1_workflow\nmkdir \"$RUNNER_TEMP/angular-t1-bin\"\nfor binary in latent latentd; do\n  objcopy --strip-debug \"$PWD/target/debug/$binary\" \"$RUNNER_TEMP/angular-t1-bin/$binary\"\ndone\nobjcopy --strip-debug \"$RUNNER_TEMP/angular-t1-compiler/release/latent-aot-compiler\" \"$RUNNER_TEMP/angular-t1-bin/latent-aot-compiler\"\npython3 tools/run_angular_t1_workflow.py --cli \"$RUNNER_TEMP/angular-t1-bin/latent\" --node \"$RUNNER_TEMP/angular-t1-bin/latentd\" --compiler \"$RUNNER_TEMP/angular-t1-bin/latent-aot-compiler\" --fixture-root \"$RUNNER_TEMP/angular-t1-fixture\" > \"$RUNNER_TEMP/phase2-gate/angular-t1-receipt.json\"","shell":"default","stepIf":"needs.profile.outputs.renderer == 'true'","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:Qualify signed static sites through OCI and actual browsers":{"workflow":".github/workflows/ci.yml","job":"rust","name":"Qualify signed static sites through OCI and actual browsers","jobIf":"needs.profile.outputs.profile == 'full'","stepIf":"needs.profile.outputs.renderer == 'true'","workingDirectory":".","shell":"bash","run":"# Reviewed capture owner: tools/static_site.py\nnode --test tools