shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:Run tests":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"Run tests","run":"set -o pipefail\npython3 tools/ci_cargo.py run workspace-tests 2>&1 | tee \"$RUNNER_TEMP/ci-workspace-tests.log\"\npython3 tools/ci_suite_discovery.py --execution-log \"$RUNNER_TEMP/ci-workspace-tests.log\"\npython3 tools/ci_cargo.py run doctests 2>&1 | tee \"$RUNNER_TEMP/ci-doctests.log\"\npython3 tools/ci_suite_discovery.py --recipe explicit-doctests --execution-log \"$RUNNER_TEMP/ci-doctests.log\"\npython3 tools/ci_cargo.py run signing-compatibility 2>&1 | tee \"$RUNNER_TEMP/ci-signing-compatibility.log\"\npython3 tools/ci_suite_discovery.py --recipe signing-compatibility --execution-log \"$RUNNER_TEMP/ci-signing-compatibility.log\"","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:Validate bounded Phase 2 delivery and resource workflows":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"Validate bounded Phase 2 delivery and resource workflows","run":"python3 -m unittest tools.tests.test_ci_rust_artifacts tools.tests.test_phase2_resource_binaries\nfixture_root=\"$(mktemp -d \"${RUNNER_TEMP}/lsf-operator-fixture.XXXXXXXX\")\"\nmkdir -p \"${RUNNER_TEMP}/phase2-gate\"\ntrap 'rm -rf -- \"$fixture_root\"' EXIT\nLSF_OPERATOR_FIXTURE_ROOT=\"${fixture_root}/inputs\" python3 tools/ci_rust_artifacts.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --suite operator-fixture\npython3 -m unittest tools.tests.test_phase2_operator_workflow tools.tests.test_phase2_operator_canary tools.tests.test_phase2_offline_workflow\npython3 tools/run_phase2_operator_workflow.py --cli \"${PWD}/target/debug/latent\" --node \"${PWD}/target/debug/latentd\" --fixture-root \"${fixture_root}/inputs\" --source-commit \"${GITHUB_SHA}\" > \"${RUNNER_TEMP}/phase2-gate/operator-receipt.json\"\n# The executable is authenticated and hashed again in the child. Keep\n# debug sections out of this bounded runtime fixture without rebuilding\n# the workspace or modifying Cargo's cached executable.\nobjcopy --strip-debug \"${PWD}/target/debug/latent-aot-compiler\" \"${fixture_root}/latent-aot-compiler\"\nstat --format='AOT compiler fixture: %s bytes' \"${fixture_root}/latent-aot-compiler\"\nLSF_OPERATOR_FIXTURE_ROOT=\"${fixture_root}/inputs\" LSF_AOT_COMPILER=\"${fixture_root}/latent-aot-compiler\" python3 tools/ci_rust_artifacts.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --suite trust-currentness\npython3 tools/run_security_profile_workflow.py --cli \"${PWD}/target/debug/latent\" --node \"${PWD}/target/debug/latentd\" --compiler \"${fixture_root}/latent-aot-compiler\" --fixture-root \"${fixture_root}/inputs\" > \"${RUNNER_TEMP}/phase2-gate/security-profile-receipt.json\"\npython3 tools/run_phase2_offline_workflow.py --cli \"${PWD}/target/debug/latent\" --node \"${PWD}/target/debug/latentd\" --fixture-root \"${fixture_root}/inputs\" --source-commit \"${GITHUB_SHA}\" > \"${RUNNER_TEMP}/phase2-gate/offline-receipt.json\"\nLSF_OPERATOR_FIXTURE_ROOT=\"${fixture_root}/publication-inputs\" python3 tools/ci_rust_artifacts.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --suite publication-fixture\npython3 tools/run_publication_workflow.py --cli \"${PWD}/target/debug/latent\" --node \"${PWD}/target/debug/latentd\" --fixture-root \"${fixture_root}/publication-inputs\" --source-commit \"${GITHUB_SHA}\" > \"${RUNNER_TEMP}/phase2-gate/publication-receipt.json\"\n# Keep the frozen 512 MiB executable-hash limit without modifying\n# Cargo's debug artifacts or their hard-linked copies. Hash and run\n# these same runtime-only copies, never the unstripped originals.\nresource_bin=\"${fixture_root}/resource-bin\"\nmkdir \"${resource_bin}\"\nfor binary in latent latentd; do\n  objcopy --strip-debug \"${PWD}/target/debug/${binary}\" \"${resource_bin}/${binary}\"\n  stat --format=\"Resource ${binary} fixture: %s bytes\" \"${resource_bin}/${binary}\"\ndone\nLSF_PHASE2_RESOURCE_FIXTURE_ROOT=\"${fixture_root}/resource-inputs\" python3 tools/ci_rust_artifacts.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --suite resource-fixture\npython3 -m unittest tools.tests.test_phase2_gate_resource tools.tests.test_phase2_resource_clock\nLSF_GATE_FIXTURE_ROOT=\"${fixture_root}\" python3 - <<'PY'\nimport hashlib, json, os, pathlib, subprocess\nroot = pathlib.Path.cwd()\nbinaries = pathlib.Path(os.environ[\"LSF_GATE_FIXTURE_ROOT\"]) / \"resource-bin\"\ndef digest(path):\n    with path.open(\"rb\") as source:\n        return \"sha256:\" + hashlib.file_digest(source, \"sha256\").hexdigest()\nidentity = {\n    \"schemaVersion\": \"latent.phase2.resource-build.v1\",\n    \"sourceRevision\": os.environ[\"GITHUB_SHA\"],\n    \"cargoLockSha256\": digest(root / \"Cargo.lock\"),\n    \"cliSha256\": digest(binaries / \"latent\"),\n    \"nodeSha256\": digest(binaries / \"latentd\"),\n    \"rustcVersion\": subprocess.check_output([\"rustc\", \"--version\"], text=True).strip(),\n    \"buildProfile\": \"debug\",\n}\n(pathlib.Path(os.environ[\"LSF_GATE_FIXTURE_ROOT\"]) / \"build.json\").write_text(json.dumps(identity))\nPY\npython3 tools/phase2_gate_resource.py --cli \"${resource_bin}/latent\" --node \"${resource_bin}/latentd\" --fixture-root \"${fixture_root}/resource-inputs\" --build-identity \"${fixture_root}/build.json\" --output \"${RUNNER_TEMP}/phase2-gate/resource-receipt.json\"\npython3 tools/phase2_gate_resource.py --validate \"${RUNNER_TEMP}/phase2-gate/resource-receipt.json\"","shell":"bash","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:Validate small Phase 3 resource regressions":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"Validate small Phase 3 resource regressions","run":"python3 -m unittest tools.tests.test_phase3_resource tools.tests.test_phase3_resource_web","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:Verify complete registered workspace test discovery":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"Verify complete registered workspace test discovery","run":"python3 tools/ci_suite_discovery.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --receipt \"$RUNNER_TEMP/ci-discovery.json\"","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:cargo-cache-identity":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"cargo-cache-identity","run":"python3 tools/ci_cargo_cache.py --github-output \"$GITHUB_OUTPUT\" > \"$RUNNER_TEMP/lsf-cargo-cache-identity.json\"","shell":"default","stepIf":"github.event_name == 'workflow_dispatch' && inputs.cargo_dependency_cache == 'recipe'","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:clippy":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"clippy","run":"status=0\npython3 tools/ci_cargo.py run clippy > \"$RUNNER_TEMP/lsf-clippy.log\" 2>&1 || status=$?\ntail -n 120 \"$RUNNER_TEMP/lsf-clippy.log\"\npython3 - <<'PY'\nimport os\nimport pathlib\nimport re\nlines = (pathlib.Path(os.environ[\"RUNNER_TEMP\"]) / \"lsf-clippy.log\").read_text().splitlines()\nerrors = [\" \".join(lines[i:i + 4]) for i, line in enumerate(lines) if re.match(r\"^error(?:\\[.*?\\])?:\", line)]\ndiagnostic = \" | \".join(errors)[:1000] or \"no compiler errors\"\nwith open(os.environ[\"GITHUB_OUTPUT\"], \"a\", encoding=\"utf-8\") as output:\n    output.write(f\"diagnostic={diagnostic}\\n\")\nPY\nexit \"$status\"","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:integration_lanes":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"integration_lanes","run":"# Reviewed delegated owners: tools/ci_lane_worker.py tools/run_s3_blob_tests.py tools/run_vault_secret_tests.py tools/run_nats_event_tests.py\n# tools/run_capability_policy_workflow.py tools/build_angular_renderer.py tools/run_angular_renderer_tests.py tools/check_owned_diagnostics.py\n# tools/build_angular_package.py tools/run_angular_build_tests.py tools/build_s3_fixture.py\npython3 tools/run_ci_lanes.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --renderer \"$CI_LANE_RENDERER\" --workers \"$CI_LANE_WORKERS\" --output \"$RUNNER_TEMP/ci-lanes\"","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:metadata-working-set":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"metadata-working-set","run":"set -o pipefail\npython3 tools/test.py check --suite selection.metadata-working-set --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --context ci\npython3 tools/test.py prepare --suite selection.metadata-working-set --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --context ci\npython3 tools/test.py run --suite selection.metadata-working-set --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --context ci 2>&1 | tee \"$RUNNER_TEMP/metadata-working-set.log\"","shell":"bash","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:renderer_preflight":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"renderer_preflight","run":"python3 tools/run_angular_renderer_tests.py --preflight --diagnostic-root \"$RUNNER_TEMP/owned-renderer\"","shell":"default","stepIf":"needs.profile.outputs.renderer == 'true'","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:s3_fixture":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"s3_fixture","run":"python3 -m unittest tools.tests.test_s3_fixture_builder tools.tests.test_s3_blob_runner\npython3 tools/build_s3_fixture.py --output \"$RUNNER_TEMP/s3-fixture\"","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:sdks:Install the checksum-pinned Java-compatible Gradle":{"job":"sdks","jobIf":"needs.profile.outputs.profile == 'full'","name":"Install the checksum-pinned Java-compatible Gradle","run":"set -euo pipefail\nversion=\"$(python3 -c 'import tomllib; print(tomllib.load(open(\"tools/toolchain.toml\", \"rb\"))[\"sdk\"][\"gradle\"])')\"\nchecksum=\"$(python3 -c 'import tomllib; print(tomllib.load(open(\"tools/toolchain.toml\", \"rb\"))[\"sdk\"][\"gradle_sha256\"])')\"\ndestination=\"${RUNNER_TEMP}/lsf-gradle\"\nmkdir -p \"$destination\"\ncurl --fail --location --proto '=https' --tlsv1.2 --connect-timeout 15 --max-time 180 \\\n  \"https://services.gradle.org/distributions/gradle-${version}-bin.zip\" -o \"$destination/gradle.zip\"\nprintf '%s  %s\\n' \"$checksum\" \"$destination/gradle.zip\" | sha256sum --check --strict\nunzip -q \"$destination/gradle.zip\" -d \"$destination\"\necho \"$destination/gradle-${version}/bin\" >> \"$GITHUB_PATH\"","shell":"bash","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:sdks:Qualify the Java 25 Gradle build":{"job":"sdks","jobIf":"needs.profile.outputs.profile == 'full'","name":"Qualify the Java 25 Gradle build","run":"set -euo pipefail\nmkdir -p \"$RUNNER_TEMP/java-sdk\"\ngit rev-parse HEAD | tee \"$RUNNER_TEMP/java-sdk/gradle.log\"\nuname -srm | tee -a \"$RUNNER_TEMP/java-sdk/gradle.log\"\npython3 sdk/java-client/tools/java_toolchain.py check | tee -a \"$RUNNER_TEMP/java-sdk/gradle.log\"\ngradle --version | tee -a \"$RUNNER_TEMP/java-sdk/gradle.log\"\npython3 -m unittest tools.tests.test_check_tool_versions tools.tests.test_java_toolchain 2>&1 | tee -a \"$RUNNER_TEMP/java-sdk/gradle.log\"\ntimeout 540 gradle --no-daemon --console=plain -p sdk/java-client clean check 2>&1 | tee -a \"$RUNNER_TEMP/java-sdk/gradle.log\"\necho 'Gradle qualification passed' | tee -a \"$RUNNER_TEMP/java-sdk/gradle.log\"","shell":"bash","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:sdks:Validate SDK surfaces":{"job":"sdks","jobIf":"needs.profile.outputs.profile == 'full'","name":"Validate SDK surfaces","run":"set -euo pipefail\ntools/validate_sdks.sh 2>&1 | tee \"$RUNNER_TEMP/java-sdk/sdk.log\"\nsha256sum sdk/java-client/build/latent-java-client.jar | tee \"$RUNNER_TEMP/java-sdk/jar.sha256\"\npython3 sdk/java-client/tools/java_toolchain.py classes sdk/java-client/build/latent-java-client.jar > \"$RUNNER_TEMP/java-sdk/jar-classfile.json\"\ntest \"$(node sdk/typescript-client/node_modules/typescript/bin/tsc --version)\" = \\\n  \"Version ${EXPECTED_TYPESCRIPT_VERSION}\"","shell":"bash","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/developer-packaged-qualification.yml:conductor-contracts:Check archive rejection and bounded conductor processes":{"job":"conductor-contracts","jobIf":"success()","name":"Check archive rejection and bounded conductor processes","run":"python -m unittest tools.tests.test_dev_packaged_probe","shell":"default","stepIf":"success()","workflow":".github/workflows/developer-packaged-qualification.yml","workingDirectory":"."},".github/workflows/developer-packaged-qualification.yml:linux:Download only selected Linux, Rust and native candidates":{"job":"linux","jobIf":"inputs.platform == 'all' || inputs.platform == 'linux'","name":"Download only selected Linux, Rust and native candidates","run":"python3 -B - <<'PY'\nfrom pathlib import Path\nimport json, os, re, subprocess\nsupport = Path(os.environ['RUNNER_TEMP']) / 'packaged-support'\nselected = json.loads((support / 'selection.json').read_bytes())\nsha = selected['sourceCommit']\nassert re.fullmatch(r'[a-f0-9]{40}', sha)\ntarget = Path(os.environ['RUNNER_TEMP']) / 'packaged-candidates'\ntarget.mkdir()\nselected['artifacts'] = {}\nfor name, kind, artifact in (\n    ('linux', 'developer', 'developer-linux-candidate-' + sha),\n    ('rust', 'developer', 'developer-rust-tools-candidate-' + sha),\n    ('native', 'runtime', 'native-runtime-candidate-development-test-' + sha)):\n    destination = target / name\n    subprocess.run(['gh', 'run', 'download', str(selected['candidateRuns'][kind]['id']),\n        '--repo', 'KirilsTurkins/latent-service-fabric', '--name', artifact, '--dir', str(destination)],\n        check=True, timeout=300)\n    selected['artifacts'][name] = str(destination)\n(support / 'gh-linux').chmod(0o700)\nselected['trust'] = {\n    'developerPolicy': str(support / 'developer-policy.json'),\n    'runtimePolicy': str(support / 'runtime-policy.json'),\n    'trustedRoot': str(support / 'trusted_root.jsonl'),\n    'trustedRootSha256': selected['verificationInputs']['trustedRootSha256'],\n    'hostVerifier': str(support / 'gh-linux'), 'guestVerifier': str(support / 'gh-linux'),\n    'hostVerifierSha256': selected['verificationInputs']['verifierSha256']['linux'],\n    'guestVerifierSha256': selected['verificationInputs']['verifierSha256']['linux']}\n(support / 'inputs.json').write_text(json.dumps(selected), encoding='utf-8')\nPY","shell":"default","stepIf":"success()","workflow":".github/workflows/developer-packaged-qualification.yml","workingDirectory":"."},".github/workflows/developer-packaged-qualification.yml:linux:Execute the generated terminal devcontainer against a separate explicit SSH peer":{"job":"linux","jobIf":"inputs.platform == 'all' || inputs.platform == 'linux'","name":"Execute the generated terminal devcontainer against a separate explicit SSH peer","run":"cd \"$RUNNER_TEMP/packaged-support\"\npython3 -I -B dev_packaged_container_host.py --inputs inputs.json \\\n  --linux-output \"$RUNNER_TEMP/packaged-linux\" --output \"$RUNNER_TEMP/packaged-devcontainer\"","shell":"default","stepIf":"success()","workflow":".github/workflows/developer-packaged-qualification.yml","workingDirectory":"."},".github/workflows/developer-packaged-qualification.yml:linux:Run the authenticated packages in a clean compiler-free disconnected Ubuntu container":{"job":"linux","jobIf":"inputs.platform == 'all' || inputs.platform == 'linux'","name":"Run the authenticated packages in a clean compiler-free disconnected Ubuntu container","run":"cd \"$RUNNER_TEMP/packaged-support\"\npython3 -I -B dev_packaged_linux_host.py --inputs inputs.json --output \"$RUNNER_TEMP/packaged-linux\"","shell":"default","stepIf":"success()","workflow":".github/workflows/developer-packaged-qualification.yml","workingDirectory":"."},".github/workflows/developer-packaged-qualification.yml:support:Stage only conductor, pinned verifier and independent trust files":{"job":"support","jobIf":"github.event_name == 'workflow_dispatch' && inputs.policy_approved && github.repository == 'KirilsTurkins/latent-service-fabric'","name":"Stage only conductor, pinned verifier and independent trust files","run":"python3 -B tools/prepare_dev_packaged_probe.py","shell":"default","stepIf":"success()","workflow":".github/workflows/developer-packaged-qualification.yml","workingDirectory":"."},".github/workflows/developer-packaged-qualification.yml:windows:Download only selected exact-source candidate inputs":{"job":"windows","jobIf":"inputs.platform == 'all' || inputs.platform == 'windows' || inputs.platform == 'windows-recovery'","name":"Download only selected exact-source candidate inputs","run":"$ErrorActionPreference = 'Stop'\n$Support = Join-Path $env:RUNNER_TEMP 'packaged-support'\n$Selection = Get-Content (Join-Path $Support 'selection.json') -Raw | ConvertFrom-Json -AsHashtable\n$Artifacts = Join-Path $env:RUNNER_TEMP 'packaged-candidates'\nNew-Item -ItemType Directory -Path $Artifacts | Out-Null\n$Sha = $Selection.sourceCommit\nif ($Sha -notmatch '^[a-f0-9]{40}$') { throw 'Exact candidate source required.' }\n$Names = [ordered]@{ windows=\"developer-windows-candidate-$Sha\"; wsl=\"developer-wsl-candidate-$Sha\" }\nforeach ($Language in @('rust','c','java','dotnet','go','typescript')) {\n    $Names[$Language] = \"developer-$Language-tools-candidate-$Sha\"\n}\n$Selection.artifacts = @{}\nforeach ($Name in $Names.Keys) {\n    $Destination = Join-Path $Artifacts $Name\n    & gh run download $Selection.candidateRuns.developer.id --repo KirilsTurkins/latent-service-fabric --name $Names[$Name] --dir $Destination\n    if ($LASTEXITCODE -ne 0) { throw \"Candidate download failed: $Name\" }\n    $Selection.artifacts[$Name] = $Destination\n}\n$Destination = Join-Path $Artifacts 'native'\n& gh run download $Selection.candidateRuns.runtime.id --repo KirilsTurkins/latent-service-fabric --name \"native-runtime-candidate-development-test-$Sha\" --dir $Destination\nif ($LASTEXITCODE -ne 0) { throw 'Native candidate download failed.' }\n$Selection.artifacts.native = $Destination\n$Selection.trust = @{\n    developerPolicy=(Join-Path $Support 'developer-policy.json'); runtimePolicy=(Join-Path $Support 'runtime-policy.json');\n    trustedRoot=(Join-Path $Support 'trusted_root.jsonl'); trustedRootSha256=$Selection.verificationInputs.trustedRootSha256;\n    hostVerifier=(Join-Path $Support 'gh.exe'); hostVerifierSha256=$Selection.verificationInputs.verifierSha256.windows;\n    guestVerifier=(Join-Path $Support 'gh-linux'); guestVerifierSha256=$Selection.verificationInputs.verifierSha256.linux\n}\n$Selection.faultProbe = Join-Path $Support 'dev_node_fault_probe.py'\n$Selection | ConvertTo-Json -Depth 15 | Set-Content (Join-Path $Support 'inputs.json') -Encoding utf8","shell":"pwsh","stepIf":"success()","workflow":".github/workflows/developer-packaged-qualification.yml","workingDirectory":"."},".github/workflows/developer-packaged-qualification.yml:windows:Exercise packaged frontend with host SDKs and Python absent from its PATH":{"job":"windows","jobIf":"inputs.platform == 'all' || inputs.platform == 'windows' || inputs.platform == 'windows-recovery'","name":"Exercise packaged frontend with host SDKs and Python absent from its PATH","run":"$Support = Join-Path $env:RUNNER_TEMP 'packaged-support'\n$Observation = Join-Path $env:RUNNER_TEMP 'packaged-observation'\nSet-Location $Support\npython -I -B dev_packaged_probe.py --inputs (Join-Path $Support 'inputs.json') --output $Observation\nif ($LASTEXITCODE -ne 0) { throw 'Packaged schedule failed; retain the original attempt.' }","shell":"pwsh","stepIf":"inputs.platform != 'windows-recovery'","workflow":".github/workflows/developer-packaged-qualification.yml","workingDirectory":"."},".github/workflows/developer-packaged-qualification.yml:windows:Observe actual receipt expiry and conflicting actors without replay":{"job":"windows","jobIf":"inputs.platform == 'all' || inputs.platform == 'windows' || inputs.platform == 'windows-recovery'","name":"Observe actual receipt expiry and conflicting actors without replay","run":"$Support = Join-Path $env:RUNNER_TEMP 'packaged-support'\n$Observation = Join-Path $env:RUNNER_TEMP 'packaged-recovery'\nSet-Location $Support\npython -I -B dev_packaged_recovery_windows.py --inputs (Join-Path $Support 'inputs.json') --output $Observation\nif ($LASTEXITCODE -ne 0) { throw 'Packaged recovery failed; retain the original operation intent.' }","shell":"pwsh","stepIf":"inputs.platform == 'all' || inputs.platform == 'windows-recovery'","workflow":".github/workflows/developer-packaged-qualification.yml","workingDirectory":"."},".github/workflows/developer-platform-preflight.yml:windows-wsl:Observe the host and an exactly owned pinned Ubuntu WSL2 environment":{"job":"windows-wsl","jobIf":"success()","name":"Observe the host and an exactly owned pinned Ubuntu WSL2 environment","run":"$ErrorActionPreference = 'Stop'\nSet-StrictMode -Version Latest\n$Output = Join-Path $env:RUNNER_TEMP 'developer-platform-preflight'\nNew-Item -ItemType Directory -Path $Output | Out-Null\nfunction Observe-Wsl([string[]]$CommandArguments, [int]$TimeoutMillis = 30000) {\n    if ($TimeoutMillis -lt 1 -or $TimeoutMillis -gt 120000) { throw 'Invalid observer deadline.' }\n    $Start = [Diagnostics.ProcessStartInfo]::new()\n    $Start.FileName = Join-Path $env:SystemRoot 'System32/wsl.exe'\n    $Start.UseShellExecute = $false\n    $Start.CreateNoWindow = $true\n    $Start.RedirectStandardOutput = $true\n    $Start.RedirectStandardError = $true\n    foreach ($Argument in $CommandArguments) { $Start.ArgumentList.Add($Argument) }\n    $Process = [Diagnostics.Process]::new()\n    $Process.StartInfo = $Start\n    $Timer = [Diagnostics.Stopwatch]::StartNew()\n    try {\n        if (-not $Process.Start()) { throw 'WSL observer did not start.' }\n        $Stdout = $Process.StandardOutput.ReadToEndAsync()\n        $Stderr = $Process.StandardError.ReadToEndAsync()\n        $Completed = $Process.WaitForExit($TimeoutMillis)\n        if (-not $Completed) {\n            $Process.Kill($true)\n            if (-not $Process.WaitForExit(5000)) { throw 'Owned observer cleanup unconfirmed.' }\n        }\n        $Text = $Stdout.GetAwaiter().GetResult().Replace([string][char]0, '').Trim()\n        $ErrorText = $Stderr.GetAwaiter().GetResult().Replace([string][char]0, '').Trim()\n        if ($Text.Length -gt 32768 -or $ErrorText.Length -gt 32768) { throw 'Observer output bound exceeded.' }\n        return [ordered]@{ arguments=$CommandArguments; exitCode=$Process.ExitCode;\n            deadlineExceeded=(-not $Completed); seconds=[math]::Round($Timer.Elapsed.TotalSeconds,3);\n            stdout=$Text; stderr=$ErrorText; observerReaped=$true }\n    } finally { $Process.Dispose() }\n}\n$Os = Get-CimInstance Win32_OperatingSystem\n$Computer = Get-CimInstance Win32_ComputerSystem\n$Report = [ordered]@{\n    schemaVersion='latent.dev.hosted-platform-preflight.v1'; passed=$false;\n    observedUtc=[DateTime]::UtcNow.ToString('o'); sourceCommit=$env:GITHUB_SHA;\n    runnerImage=$env:ImageOS; runnerImageVersion=$env:ImageVersion;\n    osVersion=$Os.Version; osBuild=$Os.BuildNumber; architecture=$Os.OSArchitecture;\n    hypervisorPresent=$Computer.HypervisorPresent;\n    freeDiskBytes=(Get-PSDrive -Name C).Free;\n    sourceCheckoutUsed=$false; runtimeCompiled=$false; candidateInstalled=$false;\n    qualificationComplete=$false; observations=[ordered]@{};\n    cleanup='no-owned-distribution-created'\n}\n$Name = 'LSF-Preflight-' + $env:GITHUB_RUN_ID + '-' + $env:GITHUB_RUN_ATTEMPT\nif ($Name -notmatch '^LSF-Preflight-[0-9]+-[0-9]+$') { throw 'Ephemeral runner identity required.' }\n$Install = [IO.Path]::GetFullPath((Join-Path $Output 'owned-ubuntu'))\nif (-not $Install.StartsWith([IO.Path]::GetFullPath($Output) + [IO.Path]::DirectorySeparatorChar,\n    [StringComparison]::OrdinalIgnoreCase) -or (Test-Path -LiteralPath $Install)) { throw 'New owned path required.' }\n$Imported = $false\n$RegistryId = $null\ntry {\n    $Report.observations.version = Observe-Wsl @('--version')\n    $Report.observations.status = Observe-Wsl @('--status')\n    $Report.observations.distributions = Observe-Wsl @('--list','--verbose')\n    $Existing = @(Get-ChildItem -LiteralPath 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Lxss' -ErrorAction SilentlyContinue |\n        ForEach-Object { Get-ItemProperty -LiteralPath $_.PSPath })\n    if (@($Existing | Where-Object DistributionName -eq $Name).Count) { throw 'Existing distribution will not be adopted.' }\n    $Url = 'https://releases.ubuntu.com/noble/ubuntu-24.04.5-wsl-amd64.wsl'\n    # Reviewed from Canonical's HTTPS SHA256SUMS, not from this download.\n    $ExpectedHash = 'bb415d824822c4b878125729af451a5d18fb13d1cf5cbed9a7393ad64ac6039e'\n    $Archive = Join-Path $Output 'ubuntu.wsl'\n    & curl.exe --fail --silent --show-error --location --max-time 120 --max-filesize 536870912 --output $Archive $Url\n    if ($LASTEXITCODE -ne 0 -or (Get-FileHash -LiteralPath $Archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $ExpectedHash) {\n        throw 'Pinned Ubuntu preflight input verification failed.'\n    }\n    $Report.rootfs = [ordered]@{ url=$Url; sha256=$ExpectedHash; distribution=$Name;\n        checksumAuthority='https://releases.ubuntu.com/noble/SHA256SUMS'; purpose='host-availability-only' }\n    $Report.cleanup = 'import-intent-recorded-unconfirmed-state-left-to-runner-disposal'\n    $Report | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $Output 'observation.json') -Encoding utf8\n    $Import = Observe-Wsl -CommandArguments @('--import',$Name,$Install,$Archive,'--version','2') -TimeoutMillis 120000\n    $Report.observations.import = $Import\n    if ($Import.deadlineExceeded -or $Import.exitCode -ne 0) { throw 'Original owned WSL import unconfirmed; no retry.' }\n    $Registration = @(Get-ChildItem -LiteralPath 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Lxss' |\n        ForEach-Object { Get-ItemProperty -LiteralPath $_.PSPath } | Where-Object DistributionName -eq $Name)\n    if ($Registration.Count -ne 1 -or $Registration[0].Version -ne 2 -or\n        [IO.Path]::GetFullPath($Registration[0].BasePath.Replace('\\\\?\\','')).TrimEnd('\\') -ne $Install.TrimEnd('\\')) {\n        throw 'New distribution ownership could not be confirmed.'\n    }\n    $RegistryId = $Registration[0].PSPath\n    $Imported = $true\n    $Guest = Observe-Wsl @('--distribution',$Name,'--user','root','--exec','uname','-s','-r','-m')\n    $Report.observations.guest = $Guest\n    if ($Guest.deadlineExceeded -or $Guest.exitCode -ne 0 -or\n        $Guest.stdout -notmatch '^Linux (\\d+)\\.(\\d+)\\.[^ ]+ x86_64$') {\n        throw 'Actual x86-64 WSL2 environment was not observed.'\n    }\n    if ([int]$Matches[1] -lt 6 -or ([int]$Matches[1] -eq 6 -and [int]$Matches[2] -lt 8)) {\n        throw 'Observed WSL2 kernel is below the runtime minimum.'\n    }\n    $Report.passed = $true\n} finally {\n    if ($Imported) {\n        $Current = Get-ItemProperty -LiteralPath $RegistryId\n        if ($Current.DistributionName -ne $Name -or $Current.Version -ne 2 -or\n            [IO.Path]::GetFullPath($Current.BasePath.Replace('\\\\?\\','')).TrimEnd('\\') -ne $Install.TrimEnd('\\')) {\n            $Report.passed = $false\n            $Report.cleanup = 'ownership-changed-no-destructive-cleanup'\n        } else {\n            $Report.observations.stop = Observe-Wsl @('--terminate',$Name)\n            $Removed = Observe-Wsl @('--unregister',$Name)\n            $Report.observations.purge = $Removed\n            if ($Removed.exitCode -eq 0 -and -not $Removed.deadlineExceeded -and -not (Test-Path -LiteralPath $RegistryId)) {\n                $Report.cleanup = 'exact-owned-distribution-stopped-and-unregistered'\n            } else {\n                $Report.passed = $false\n                $Report.cleanup = 'owned-purge-unconfirmed-no-retry'\n            }\n        }\n    }\n    $Report | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $Output 'observation.json') -Encoding utf8\n}\nif (-not $Report.passed) { throw 'Hosted WSL2 preflight or exact-owner cleanup failed.' }\nWrite-Output 'Actual hosted WSL2 preflight passed; packaged workflow qualification remains separate.'","shell":"pwsh","stepIf":"success()","workflow":".github/workflows/developer-platform-preflight.yml","workingDirectory":"."},".github/workflows/developer-tools.yml:contracts:Exercise controller boundaries and actual owned subprocesses":{"job":"contracts","jobIf":"github.event_name != 'pull_request' || !startsWith(github.head_ref, 'feat/559-') || github.event.pull_request.head.repo.full_name != github.repository","name":"Exercise controller boundaries and actual owned subprocesses","run":"python -m unittest tools.tests.test_dev_workflow tools.tests.test_dev_contracts tools.tests.test_dev_build_cache tools.tests.test_dev_watch tools.tests.test_dev_tools tools.tests.test_dev_tool_install tools.tests.test_dev_node_policies tools.tests.test_dev_http_fixture tools.tests