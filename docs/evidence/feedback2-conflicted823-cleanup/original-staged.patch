kspace-tests.jsonl\" --suite operator-fixture\npython3 -m unittest tools.tests.test_phase2_operator_workflow tools.tests.test_phase2_operator_canary tools.tests.test_phase2_offline_workflow\npython3 tools/run_phase2_operator_workflow.py --cli \"${PWD}/target/debug/latent\" --node \"${PWD}/target/debug/latentd\" --fixture-root \"${fixture_root}/inputs\" --source-commit \"${GITHUB_SHA}\" > \"${RUNNER_TEMP}/phase2-gate/operator-receipt.json\"\n# The executable is authenticated and hashed again in the child. Keep\n# debug sections out of this bounded runtime fixture without rebuilding\n# the workspace or modifying Cargo's cached executable.\nobjcopy --strip-debug \"${PWD}/target/debug/latent-aot-compiler\" \"${fixture_root}/latent-aot-compiler\"\nstat --format='AOT compiler fixture: %s bytes' \"${fixture_root}/latent-aot-compiler\"\nLSF_OPERATOR_FIXTURE_ROOT=\"${fixture_root}/inputs\" LSF_AOT_COMPILER=\"${fixture_root}/latent-aot-compiler\" python3 tools/ci_rust_artifacts.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --suite trust-currentness\npython3 tools/run_security_profile_workflow.py --cli \"${PWD}/target/debug/latent\" --node \"${PWD}/target/debug/latentd\" --compiler \"${fixture_root}/latent-aot-compiler\" --fixture-root \"${fixture_root}/inputs\" > \"${RUNNER_TEMP}/phase2-gate/security-profile-receipt.json\"\npython3 tools/run_phase2_offline_workflow.py --cli \"${PWD}/target/debug/latent\" --node \"${PWD}/target/debug/latentd\" --fixture-root \"${fixture_root}/inputs\" --source-commit \"${GITHUB_SHA}\" > \"${RUNNER_TEMP}/phase2-gate/offline-receipt.json\"\nLSF_OPERATOR_FIXTURE_ROOT=\"${fixture_root}/publication-inputs\" python3 tools/ci_rust_artifacts.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --suite publication-fixture\npython3 tools/run_publication_workflow.py --cli \"${PWD}/target/debug/latent\" --node \"${PWD}/target/debug/latentd\" --fixture-root \"${fixture_root}/publication-inputs\" --source-commit \"${GITHUB_SHA}\" > \"${RUNNER_TEMP}/phase2-gate/publication-receipt.json\"\n# Keep the frozen 512 MiB executable-hash limit without modifying\n# Cargo's debug artifacts or their hard-linked copies. Hash and run\n# these same runtime-only copies, never the unstripped originals.\nresource_bin=\"${fixture_root}/resource-bin\"\nmkdir \"${resource_bin}\"\nfor binary in latent latentd; do\n  objcopy --strip-debug \"${PWD}/target/debug/${binary}\" \"${resource_bin}/${binary}\"\n  stat --format=\"Resource ${binary} fixture: %s bytes\" \"${resource_bin}/${binary}\"\ndone\nLSF_PHASE2_RESOURCE_FIXTURE_ROOT=\"${fixture_root}/resource-inputs\" python3 tools/ci_rust_artifacts.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --suite resource-fixture\npython3 -m unittest tools.tests.test_phase2_gate_resource tools.tests.test_phase2_resource_clock\nLSF_GATE_FIXTURE_ROOT=\"${fixture_root}\" python3 - <<'PY'\nimport hashlib, json, os, pathlib, subprocess\nroot = pathlib.Path.cwd()\nbinaries = pathlib.Path(os.environ[\"LSF_GATE_FIXTURE_ROOT\"]) / \"resource-bin\"\ndef digest(path):\n    with path.open(\"rb\") as source:\n        return \"sha256:\" + hashlib.file_digest(source, \"sha256\").hexdigest()\nidentity = {\n    \"schemaVersion\": \"latent.phase2.resource-build.v1\",\n    \"sourceRevision\": os.environ[\"GITHUB_SHA\"],\n    \"cargoLockSha256\": digest(root / \"Cargo.lock\"),\n    \"cliSha256\": digest(binaries / \"latent\"),\n    \"nodeSha256\": digest(binaries / \"latentd\"),\n    \"rustcVersion\": subprocess.check_output([\"rustc\", \"--version\"], text=True).strip(),\n    \"buildProfile\": \"debug\",\n}\n(pathlib.Path(os.environ[\"LSF_GATE_FIXTURE_ROOT\"]) / \"build.json\").write_text(json.dumps(identity))\nPY\npython3 tools/phase2_gate_resource.py --cli \"${resource_bin}/latent\" --node \"${resource_bin}/latentd\" --fixture-root \"${fixture_root}/resource-inputs\" --build-identity \"${fixture_root}/build.json\" --output \"${RUNNER_TEMP}/phase2-gate/resource-receipt.json\"\npython3 tools/phase2_gate_resource.py --validate \"${RUNNER_TEMP}/phase2-gate/resource-receipt.json\"","shell":"bash","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:Validate browser boundary with live ingress":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"Validate browser boundary with live ingress","run":"node --test tools/tests/browser_hydration.test.mjs tools/tests/browser_application.test.mjs\nnode tools/browser-boundary/build.mjs examples/renderer-profile \"$RUNNER_TEMP/browser-boundary\"\ncargo build --locked -p latent-toolchain-smoke --example web-contract --target wasm32-unknown-unknown --release\nwasm-tools component new target/wasm32-unknown-unknown/release/examples/web_contract.wasm -o \"$RUNNER_TEMP/browser-boundary/application.wasm\"\nwasm-tools validate \"$RUNNER_TEMP/browser-boundary/application.wasm\"\nLSF_WEB_COMPONENT=\"$RUNNER_TEMP/browser-boundary/application.wasm\" LSF_BROWSER_BUILD=\"$RUNNER_TEMP/browser-boundary\" LSF_BROWSER_NODE=\"$(command -v node)\" LSF_BROWSER_CHROME=\"$(command -v google-chrome)\" LSF_BROWSER_TOOLCHAIN=\"$PWD/examples/renderer-profile\" python3 tools/ci_rust_artifacts.py --inventory \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --suite browser-boundary","shell":"default","stepIf":"needs.profile.outputs.renderer == 'true'","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:Validate capability policy CLI lifecycle":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"Validate capability policy CLI lifecycle","run":"python3 tools/run_capability_policy_workflow.py --cli \"${PWD}/target/debug/latent\" --node \"${PWD}/target/debug/latentd\"","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:Verify actual Angular package admission, fresh rendering and browser hydration":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"Verify actual Angular package admission, fresh rendering and browser hydration","run":"python3 tools/run_angular_build_tests.py --test-manifest \"$RUNNER_TEMP/lsf-workspace-tests.jsonl\" --build \"$RUNNER_TEMP/angular-build/actual\" --html \"$RUNNER_TEMP/angular-build/rendered.html\"\nnode tools/check_angular_hydration.mjs examples/renderer-profile \"$RUNNER_TEMP/angular-build/actual\" \"$RUNNER_TEMP/angular-build/rendered.html\" \"$(command -v google-chrome)\"","shell":"default","stepIf":"needs.profile.outputs.renderer == 'true'","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:rust:clippy":{"job":"rust","jobIf":"needs.profile.outputs.profile == 'full'","name":"clippy","run":"status=0\ncargo clippy --workspace --all-targets --all-features --locked > \"$RUNNER_TEMP/lsf-clippy.log\" 2>&1 || status=$?\nif [ \"$status\" -eq 0 ]; then\n  cargo clippy -p latent -p latentd -p latent-testkit -p latent-admission --all-targets --all-features --locked --no-deps -- -D warnings >> \"$RUNNER_TEMP/lsf-clippy.log\" 2>&1 || status=$?\nfi\ntail -n 120 \"$RUNNER_TEMP/lsf-clippy.log\"\npython3 - <<'PY'\nimport os\nimport pathlib\nimport re\nlines = (pathlib.Path(os.environ[\"RUNNER_TEMP\"]) / \"lsf-clippy.log\").read_text().splitlines()\nerrors = [\" \".join(lines[i:i + 4]) for i, line in enumerate(lines) if re.match(r\"^error(?:\\[.*?\\])?:\", line)]\ndiagnostic = \" | \".join(errors)[:1000] or \"no compiler errors\"\nwith open(os.environ[\"GITHUB_OUTPUT\"], \"a\", encoding=\"utf-8\") as output:\n    output.write(f\"diagnostic={diagnostic}\\n\")\nPY\nexit \"$status\"","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/ci.yml:sdks:Validate SDK surfaces":{"job":"sdks","jobIf":"needs.profile.outputs.profile == 'full'","name":"Validate SDK surfaces","run":"tools/validate_sdks.sh\ntest \"$(node sdk/typescript-client/node_modules/typescript/bin/tsc --version)\" = \\\n  \"Version ${EXPECTED_TYPESCRIPT_VERSION}\"","shell":"default","stepIf":"success()","workflow":".github/workflows/ci.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:build:Build the three native executables, bootstrap, SBOM and provenance":{"job":"build","jobIf":"success()","name":"Build the three native executables, bootstrap, SBOM and provenance","run":"cd \"$NATIVE_WORKSPACE\"\npython3 tools/build_native_runtime.py --commit \"$GITHUB_SHA\" --version \"$NATIVE_VERSION\" --output \"$PWD/target/native-release\"\ncargo +1.97.1 fmt --manifest-path tools/native-fixture/Cargo.toml -- --check\ncargo +1.97.1 build --locked --release --manifest-path tools/native-fixture/Cargo.toml \\\n  --target x86_64-unknown-linux-gnu --target-dir target/native-fixture-build --jobs 2\ninstall -D -m 0755 target/native-fixture-build/x86_64-unknown-linux-gnu/release/latent-native-vm-fixture target/native-test-tools/fixture-helper","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:build:Prepare private exact-source host workspace":{"job":"build","jobIf":"success()","name":"Prepare private exact-source host workspace","run":"python3 tools/prepare_native_workspace.py","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:build:Retain disconnected verification material":{"job":"build","jobIf":"success()","name":"Retain disconnected verification material","run":"install -m 0644 \"$ATTESTATION_BUNDLE\" \"$NATIVE_WORKSPACE/target/native-release/SHA256SUMS.sigstore.json\"","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:build:Use maintained validation profile and pinned dependencies":{"job":"build","jobIf":"success()","name":"Use maintained validation profile and pinned dependencies","run":"python3 tools/ci_profile.py\npython3 -m pip install --requirement tools/requirements.lock\npython3 -m unittest tools.tests.test_native_runtime tools.tests.test_native_release_gate\npython3 tools/validate_workflow_actions.py\npython3 tools/validate_docs.py","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:gate:Prepare private exact-source host workspace":{"job":"gate","jobIf":"success()","name":"Prepare private exact-source host workspace","run":"python3 tools/prepare_native_workspace.py","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:gate:gate":{"job":"gate","jobIf":"success()","name":"gate","run":"cd \"$NATIVE_WORKSPACE\"\narguments=()\nif test \"$PUBLISH\" = true; then arguments+=(--publish); fi\npython3 tools/native_release_gate.py --version \"$NATIVE_VERSION\" --commit \"$REVIEWED_COMMIT\" \\\n  --ci-run \"$REVIEWED_CI_RUN\" --predecessor-run \"$PREDECESSOR_RUN\" \"${arguments[@]}\" \\\n  --output \"$PWD/target/native-release-decision.json\" --github-output","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:native-vm:Native packaged execution, real reboot, preservation and selected upgrade":{"job":"native-vm","jobIf":"success()","name":"Native packaged execution, real reboot, preservation and selected upgrade","run":"cd \"$NATIVE_WORKSPACE\"\narguments=()\nif test -n \"$PREDECESSOR_RUN\"; then\n  arguments+=(--predecessor-directory \"$PWD/target/native-predecessor\" --predecessor-policy \"$NATIVE_TRUST/predecessor-policy.json\")\nfi\nif test \"$PUBLISH\" = true; then arguments+=(--require-upgrade); fi\npython3 tools/run_native_vm.py --release-directory \"$PWD/target/native-release\" \\\n  --trusted-root \"$NATIVE_TRUST/trusted_root.jsonl\" --verifier \"$(readlink -f \"$(command -v gh)\")\" \\\n  --version \"$NATIVE_VERSION\" --commit \"$GITHUB_SHA\" --source-ref \"$GITHUB_REF\" \\\n  --purpose release --profile \"$NATIVE_PROFILE\" --fixture-helper \"$PWD/target/native-test-tools/fixture-helper\" \\\n  --output \"$PWD/target/native-vm/$NATIVE_PROFILE.json\" \"${arguments[@]}\"","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:native-vm:Prepare private exact-source host workspace":{"job":"native-vm","jobIf":"success()","name":"Prepare private exact-source host workspace","run":"python3 tools/prepare_native_workspace.py","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:native-vm:Provision host QEMU and independently installed verification roots":{"job":"native-vm","jobIf":"success()","name":"Provision host QEMU and independently installed verification roots","run":"cd \"$NATIVE_WORKSPACE\"\nsudo apt-get update\nsudo apt-get install -y --no-install-recommends qemu-system-x86 qemu-utils cloud-image-utils openssh-client\nif test -c /dev/kvm; then sudo setfacl -m \"u:$(id -un):rw\" /dev/kvm; fi\ngh --version\ngh attestation trusted-root > \"$NATIVE_TRUST/trusted_root.jsonl\"\nif test -n \"$PREDECESSOR_RUN\"; then\n  gh run download \"$PREDECESSOR_RUN\" --repo \"$GITHUB_REPOSITORY\" \\\n    --name \"native-runtime-release-$PREDECESSOR_COMMIT\" --dir target/native-predecessor\n  python3 - <<'PY'\nimport json\nimport os\nfrom pathlib import Path\nfrom tools.native_runtime.verify import publisher_policy, RELEASE_WORKFLOW, REPOSITORY\npolicy = publisher_policy({\"schemaVersion\": \"latent.native-publisher-policy.v1\", \"repository\": REPOSITORY,\n                          \"workflow\": RELEASE_WORKFLOW, \"sourceRef\": \"refs/tags/\" + os.environ[\"PREDECESSOR_VERSION\"],\n                          \"sourceCommit\": os.environ[\"PREDECESSOR_COMMIT\"], \"version\": os.environ[\"PREDECESSOR_VERSION\"],\n                          \"purpose\": \"release\"}, os.environ[\"PREDECESSOR_VERSION\"])\n(Path(os.environ[\"NATIVE_TRUST\"]) / \"predecessor-policy.json\").write_text(json.dumps(policy))\nPY\nfi","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:publish:Prepare private exact-source host workspace":{"job":"publish","jobIf":"inputs.publish","name":"Prepare private exact-source host workspace","run":"python3 tools/prepare_native_workspace.py","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:publish:Publish selected existing tag only, without moving tags or overwriting releases":{"job":"publish","jobIf":"inputs.publish","name":"Publish selected existing tag only, without moving tags or overwriting releases","run":"cd \"$NATIVE_WORKSPACE\"\npython3 tools/native_release_gate.py --publish-assets --version \"$NATIVE_VERSION\" --commit \"$REVIEWED_COMMIT\" \\\n  --ci-run \"$REVIEWED_CI_RUN\" --predecessor-run \"$PREDECESSOR_RUN\" \\\n  --release-directory \"$PWD/target/native-release\" --receipts \"$PWD/target/native-vm\" \\\n  --acceptance-bundle \"$ACCEPTANCE_BUNDLE\" --output \"$PWD/target/native-publication-result.json\"","shell":"default","stepIf":"success()","workflow":".github/workflows/native-runtime-release.yml","workingDirectory":"."},".github/workflows/native-runtime-release.yml:publish:Revalidate live exact-head CI, both native VM receipts and offline publisher identity":{"job":"publish","jobIf":"inputs.publish","name":"Revalidate live exact-head CI, both native VM receipts and offline publisher identity","run":"cd