+pub fn permission(
+    _: CommandAccess,
+    record: Option<&latent_commit::atomic::CommandRecord>,
+) -> Result<(), AtomicError> {
+    if record
+        .is_some_and(|r| r.key().tenant != "tests" || r.key().recovery_scope != "subject:alice")
+    {
+        Err(AtomicError::PermissionDenied)
+    } else {
+        Ok(())
+    }
