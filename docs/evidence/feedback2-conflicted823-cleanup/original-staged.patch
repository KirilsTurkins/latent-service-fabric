+    notice: mpsc::Sender<(Registration, PauseTicket)>,
+    bytes: Vec<u8>,
+    destroyed: Arc<AtomicBool>,
+}
+impl Drop for KeptNative {
+    fn drop(&mut self) {
+        pause(&self.pause, &self.notice, std::mem::take(&mut self.bytes));
+        self.destroyed.store(true, Ordering::SeqCst);
+    }
