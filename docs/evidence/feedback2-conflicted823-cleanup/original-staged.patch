ative frontend and isolated Linux helper","run":"python tools/build_dev_frontend.py --output target/dev-candidate","shell":"default","stepIf":"success()","workflow":".github/workflows/developer-tools.yml","workingDirectory":"."},".github/workflows/developer-tools.yml:windows:Build native portable host and maintained compiled Rust guests":{"job":"windows","jobIf":"success()","name":"Build native portable host and maintained compiled Rust guests","run":"cargo build -p latent-portable-test-host --release --locked\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\npython tools/build_echo_capsule.py --output-dir target/dev-echo\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\ncargo build -p latent-toolchain-smoke --example generic-capsule --target wasm32-unknown-unknown --release --locked\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\nwasm-tools component new target/wasm32-unknown-unknown/release/examples/generic_capsule.wasm -o target/dev-generic.wasm\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\npython tools/build_portable_dev_guests.py --output target/dev-providers\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }","shell":"default","stepIf":"success()","workflow":".github/workflows/developer-tools.yml","workingDirectory":"."},".github/workflows/developer-tools.yml:windows:Compare actual native Windows clocks and denial with the signed Linux node":{"job":"windows","jobIf":"success()","name":"Compare actual native Windows clocks and denial with the signed Linux node","run":"python tools/run_dev_clock_portable.py --host target/release/latent-portable-test-host.exe --inputs target/dev-clock-fixtures --output target/dev-portable-clock-comparison.json","shell":"default","stepIf":"success()","workflow":".github/workflows/developer-tools.yml","workingDirectory":"."},".github/workflows/developer-tools.yml:windows:Compare authenticated native Windows HTTP with the signed Linux node":{"job":"windows","jobIf":"success()","name":"Compare authenticated native Windows HTTP wi