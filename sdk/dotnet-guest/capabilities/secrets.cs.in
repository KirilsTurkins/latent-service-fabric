using System;
using System.Security.Cryptography;
using @root@;
using Raw = @raw@;
namespace Lsf.Guest;

public delegate T SecretReader<T>(ReadOnlySpan<byte> bytes);

public sealed class Secret : IDisposable
{
    private byte[]? bytes;
    private bool borrowed;
    public string MediaType { get; }
    public string? Version { get; }
    public ulong? ExpiresAtUnixMillis { get; }
    internal Secret(Raw.SecretValue value)
    {
        bytes = value.bytes;
        MediaType = value.mediaType;
        Version = value.version;
        ExpiresAtUnixMillis = value.expiresAtUnixMillis;
    }
    public T Use<T>(SecretReader<T> reader)
    {
        if (bytes is null || borrowed) throw new InvalidOperationException("secret is closed or borrowed");
        borrowed = true;
        try { return reader(bytes); }
        finally { borrowed = false; }
    }
    public void Dispose()
    {
        if (borrowed) throw new InvalidOperationException("secret is borrowed");
        var owned = bytes;
        bytes = null;
        if (owned is not null) CryptographicOperations.ZeroMemory(owned);
    }
}
public static class Secrets
{
    public static Result<Secret, Raw.SecretError> Read(string reference) =>
        Results.Map(Raw.Read(reference), value => new Secret(value));
}
