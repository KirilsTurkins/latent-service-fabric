using System.Reflection;
using System.Text.Json;
using BridgeControl.wit.Imports.latent.dotnetManagedWork;

// The generated bridge is production source; only the WIT import is a test port.
internal static class ReserveBridgeControl
{
    private static void Need(bool value)
    { if (!value) throw new InvalidOperationException("managed-reserve-bridge-control"); }

    private static void Main(string[] args)
    {
        Need(args.Length == 2);
        int kind = int.Parse(args[0]); string mode = args[1];
        IOwnerImports.Mode = mode;
        var reserve = typeof(LsfManagedWorkRoot).GetMethod("Reserve", BindingFlags.Static | BindingFlags.NonPublic)
            ?? throw new InvalidOperationException("managed-reserve-bridge-method");
        object? value = null; Exception? failure = null;
        try { value = reserve.Invoke(null, [kind, 17UL, 29UL]); }
        catch (TargetInvocationException error) { failure = error.InnerException; }
        Need(IOwnerImports.Calls == 1 && IOwnerImports.LastKind == (uint)kind
            && IOwnerImports.LastGeneration == 17 && IOwnerImports.LastId == 29);
        if (mode == "ok")
            Need(failure is null && value is ValueTuple<ulong, ulong> result && result == (41UL, 59UL));
        else if (mode == "refusal" && kind is 0 or 3 or 5 or 6)
            Need(failure is null && value is ValueTuple<ulong, ulong> result && result == default);
        else if (mode == "refusal")
            Need(failure?.GetType() == typeof(InvalidOperationException)
                && failure.Message == "managed-work-admission-refused");
        else if (mode == "exception") Need(ReferenceEquals(failure, IOwnerImports.OriginalError));
        else
            Need(failure?.GetType() == typeof(InvalidOperationException)
                && failure.Message == "managed-work-reservation-token");
        Console.WriteLine(JsonSerializer.Serialize(new { control = $"{kind}-{mode}", passed = true,
            actualGeneratedBridge = true, nativeImport = "explicit-test-port", guestQualified = false }));
    }
}

namespace BridgeControl.wit.Imports.latent.dotnetManagedWork
{
    internal readonly struct ReserveResult(bool ok, (ulong, ulong) value)
    {
        public bool IsOk => ok;
        public (ulong, ulong) AsOk => ok ? value : throw new InvalidOperationException("unexpected-error-value");
    }
    internal readonly struct BasicResult { public bool IsOk => true; }

    internal static class IOwnerImports
    {
        internal static string Mode = "";
        internal static int Calls;
        internal static uint LastKind;
        internal static ulong LastGeneration, LastId;
        internal static readonly InvalidOperationException OriginalError = new("control-unknown-reservation");
        public static ReserveResult Reserve(uint kind, ulong generation, ulong id)
        {
            Calls++; LastKind = kind; LastGeneration = generation; LastId = id;
            return Mode switch {
                "ok" => new(true, (41, 59)), "refusal" => new(false, default),
                "zero-both" => new(true, default), "zero-generation" => new(true, (0, 59)),
                "zero-id" => new(true, (41, 0)), "exception" => throw OriginalError,
                _ => throw new InvalidOperationException("managed-reserve-bridge-mode"),
            };
        }
        public static BasicResult Settle(ulong generation, ulong id) => throw new InvalidOperationException("unexpected-settle");
        public static BasicResult Close() => throw new InvalidOperationException("unexpected-close");
        public static void Context(ulong generation, ulong id) => throw new InvalidOperationException("unexpected-context");
    }
}
