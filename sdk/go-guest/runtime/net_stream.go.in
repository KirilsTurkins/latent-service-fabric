// Compiler-owned finite net.Conn over the explicitly declared streams import.
// No provider, authority, resolver, TLS, reconnect or wire fallback is installed.
package net

import (
	lsfErrors "errors"
	lsfIO "io"
	lsfOS "os"
	lsfStrconv "strconv"
	lsfStrings "strings"
	lsfSync "sync"

	lsfNetwork "@module@/lsf/network"
	lsfWit "go.bytecodealliance.org/pkg/wit/types"
)

const lsfStreamMaximumChunk = 16384

// Pin the real package initializer's resolver before application initialization.
// The host performs only its own sealed resolution; it cannot silently replace
// a caller's installed resolver or its nondefault public settings.
var lsfStreamOriginalDefaultResolver = DefaultResolver

func lsfStreamDefaultResolverSupported() bool {
	resolver := DefaultResolver
	return resolver == lsfStreamOriginalDefaultResolver && resolver != nil &&
		!resolver.PreferGo && !resolver.StrictErrors && resolver.Dial == nil
}

type lsfStreamError struct{ failure lsfNetwork.StreamError }

func (e *lsfStreamError) Error() string {
	names := [...]string{"invalid-input", "invalid-state", "unsupported", "denied", "revoked", "exhausted",
		"dns-failed", "tls-failed", "connect-failed", "timeout", "cancelled", "io-failed", "uncertain"}
	if int(e.failure.Code) >= len(names) {
		panic("lsf: foreign stream error")
	}
	return "lsf-stream-" + names[e.failure.Code]
}
func (e *lsfStreamError) Timeout() bool               { return e.failure.Code == lsfNetwork.ErrorCodeTimeout }
func (e *lsfStreamError) Temporary() bool             { return false }
func (e *lsfStreamError) AcceptedPrefixBytes() uint32 { return e.failure.AcceptedPrefixBytes }
func (e *lsfStreamError) MayHaveApplied() bool        { return e.failure.MayHaveApplied }
func (e *lsfStreamError) Is(target error) bool {
	switch e.failure.Code {
	case lsfNetwork.ErrorCodeUnsupported:
		return target == lsfErrors.ErrUnsupported
	case lsfNetwork.ErrorCodeDenied, lsfNetwork.ErrorCodeRevoked:
		return target == lsfOS.ErrPermission
	case lsfNetwork.ErrorCodeTimeout:
		return target == context.DeadlineExceeded || target == lsfOS.ErrDeadlineExceeded
	case lsfNetwork.ErrorCodeCancelled:
		return target == context.Canceled
	}
	return false
}
func lsfStreamUnsupported() error { return lsfErrors.ErrUnsupported }

type lsfStreamAddr string

func (a lsfStreamAddr) Network() string { return "tcp" }
func (a lsfStreamAddr) String() string  { return string(a) }

// Syntax normalization only. The host's common address/SSRF and exact endpoint
// policy remain authoritative before DNS/contact and at dispatch fences.
func lsfStreamEndpoint(address string) (string, uint16, error) {
	host, service, err := SplitHostPort(address)
	if err != nil {
		return "", 0, err
	}
	if service == "" {
		return "", 0, &AddrError{Err: "missing numeric port", Addr: address}
	}
	for _, ch := range service {
		if ch < '0' || ch > '9' {
			return "", 0, lsfStreamUnsupported()
		}
	}
	port, err := lsfStrconv.ParseUint(service, 10, 16)
	if err != nil || port == 0 {
		return "", 0, &AddrError{Err: "invalid numeric port", Addr: address}
	}
	if ip, err := netip.ParseAddr(host); err == nil {
		if ip.Zone() != "" || ip.Is4In6() {
			return "", 0, lsfStreamUnsupported()
		}
		host = ip.String()
	} else {
		host = lsfStrings.ToLower(host)
		if len(host) == 0 || len(host) > 253 {
			return "", 0, &AddrError{Err: "invalid host", Addr: address}
		}
		labels := lsfStrings.Split(host, ".")
		for _, label := range labels {
			if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
				return "", 0, &AddrError{Err: "invalid host label", Addr: address}
			}
			for _, ch := range label {
				if !(ch >= 'a' && ch <= 'z' || ch >= '0' && ch <= '9' || ch == '-') {
					return "", 0, &AddrError{Err: "invalid host label", Addr: address}
				}
			}
		}
		numeric := true
		for _, ch := range labels[len(labels)-1] {
			if ch < '0' || ch > '9' {
				numeric = false
			}
		}
		legacyHex := len(host) > 2 && lsfStrings.HasPrefix(host, "0x")
		if legacyHex {
			for _, ch := range host[2:] {
				if !(ch >= '0' && ch <= '9' || ch >= 'a' && ch <= 'f') {
					legacyHex = false
				}
			}
		}
		if numeric || legacyHex {
			return "", 0, &AddrError{Err: "noncanonical numeric host", Addr: address}
		}
	}
	return host, uint16(port), nil
}

func lsfStreamTimeout(deadline time.Time) (lsfWit.Option[uint32], error) {
	if deadline.IsZero() {
		return lsfWit.None[uint32](), nil
	}
	remaining := time.Until(deadline)
	if remaining <= 0 {
		return lsfWit.None[uint32](), lsfOS.ErrDeadlineExceeded
	}
	// Ceiling to milliseconds avoids an earlier local timeout. No saturation or
	// hidden authority extension for an unrepresentable deadline.
	millis := (remaining-1)/time.Millisecond + 1
	if millis > 4294967295 {
		return lsfWit.None[uint32](), lsfStreamUnsupported()
	}
	return lsfWit.Some(uint32(millis)), nil
}

func lsfStreamDial(ctx context.Context, d *Dialer, network, address string) (Conn, error) {
	if ctx == nil {
		panic("nil context")
	}
	failure := func(err error) (Conn, error) { return nil, &OpError{Op: "dial", Net: network, Err: err} }
	if !lsfStreamDefaultResolverSupported() || network != "tcp" || d.LocalAddr != nil || d.Resolver != nil || d.Cancel != nil || d.Control != nil ||
		d.ControlContext != nil || d.DualStack || d.FallbackDelay > 0 || d.KeepAlive != 0 ||
		d.KeepAliveConfig != (KeepAliveConfig{}) || d.mptcpStatus == mptcpEnabledDial {
		return failure(lsfStreamUnsupported())
	}
	if err := ctx.Err(); err != nil {
		return failure(err)
	}
	host, port, err := lsfStreamEndpoint(address)
	if err != nil {
		return failure(err)
	}
	timeout, err := lsfStreamTimeout(d.deadline(ctx, time.Now()))
	if err != nil {
		return failure(err)
	}
	r := lsfNetwork.ConnectContext(ctx, lsfNetwork.ConnectRequest{Host: host, Port: port,
		Transport: lsfNetwork.TransportTcp, TimeoutMillis: timeout})
	if r.IsErr() {
		return failure(&lsfStreamError{r.Err()})
	}
	return &lsfStreamConn{stream: r.Ok(), remote: lsfStreamAddr(JoinHostPort(host, lsfStrconv.Itoa(int(port)))),
		closeDone: make(chan struct{})}, nil
}

type lsfStreamConn struct {
	mu                                               lsfSync.Mutex
	stream                                           *lsfNetwork.Connection
	remote                                           lsfStreamAddr
	readDeadline, writeDeadline                      time.Time
	readBusy, writeBusy, closing, readEOF, writeShut bool
	closeDone                                        chan struct{}
	closeError                                       error
}

var _ Conn = (*lsfStreamConn)(nil)

func (c *lsfStreamConn) opError(op string, err error) error {
	return &OpError{Op: op, Net: "tcp", Addr: c.remote, Err: err}
}

// Same-direction overlap and in-flight deadline rearming are explicitly
// unsupported by this finite profile, rather than silently queued/ignored.
func (c *lsfStreamConn) begin(write bool) (lsfWit.Option[uint32], func(), error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.closing {
		return lsfWit.None[uint32](), nil, ErrClosed
	}
	deadline, busy := c.readDeadline, &c.readBusy
	if write {
		deadline, busy = c.writeDeadline, &c.writeBusy
	}
	if *busy {
		return lsfWit.None[uint32](), nil, lsfStreamUnsupported()
	}
	timeout, err := lsfStreamTimeout(deadline)
	if err != nil {
		return timeout, nil, err
	}
	*busy = true
	return timeout, func() { c.mu.Lock(); *busy = false; c.mu.Unlock() }, nil
}

func (c *lsfStreamConn) Read(bytes []byte) (int, error) {
	timeout, release, err := c.begin(false)
	if err != nil {
		return 0, c.opError("read", err)
	}
	defer release()
	if len(bytes) == 0 {
		return 0, nil
	}
	c.mu.Lock()
	eof := c.readEOF
	c.mu.Unlock()
	if eof {
		return 0, lsfIO.EOF
	}
	maximum := len(bytes)
	if maximum > lsfStreamMaximumChunk {
		maximum = lsfStreamMaximumChunk
	}
	r := c.stream.ReadContext(context.Background(), uint32(maximum), timeout)
	if r.IsErr() {
		return 0, c.opError("read", &lsfStreamError{r.Err()})
	}
	if r.Ok().IsNone() {
		c.mu.Lock()
		c.readEOF = true
		c.mu.Unlock()
		return 0, lsfIO.EOF
	}
	chunk := r.Ok().Some()
	defer chunk.Close()
	data := chunk.BytesContext(context.Background())
	if data.IsErr() {
		return 0, c.opError("read", &lsfStreamError{data.Err()})
	}
	if len(data.Ok()) > maximum {
		panic("lsf: stream read exceeded requested bound")
	}
	return copy(bytes, data.Ok()), nil
}

func (c *lsfStreamConn) Write(bytes []byte) (int, error) {
	_, release, err := c.begin(true)
	if err != nil {
		return 0, c.opError("write", err)
	}
	defer release()
	c.mu.Lock()
	shut := c.writeShut
	c.mu.Unlock()
	if shut {
		return 0, c.opError("write", ErrClosed)
	}
	written := 0
	for written < len(bytes) {
		// The original absolute deadline applies to the whole public Write.
		// Rearming an active direction is still refused by setDeadline.
		c.mu.Lock()
		deadline := c.writeDeadline
		c.mu.Unlock()
		timeout, err := lsfStreamTimeout(deadline)
		if err != nil {
			return written, c.opError("write", err)
		}
		part := bytes[written:]
		if len(part) > lsfStreamMaximumChunk {
			part = part[:lsfStreamMaximumChunk]
		}
		r := c.stream.WriteContext(context.Background(), part, timeout)
		if r.IsErr() {
			failure := r.Err()
			if failure.AcceptedPrefixBytes > uint32(len(part)) {
				panic("lsf: invalid stream accepted prefix")
			}
			// wasm32 slices bound this sum; retain the actual cumulative prefix
			// for both net.Conn's count and its typed partial-effect error.
			failure.AcceptedPrefixBytes += uint32(written)
			return int(failure.AcceptedPrefixBytes), c.opError("write", &lsfStreamError{failure})
		}
		if r.Ok() > uint32(len(part)) {
			panic("lsf: invalid stream write count")
		}
		if r.Ok() == 0 {
			return written, c.opError("write", lsfIO.ErrShortWrite)
		}
		// Only an acknowledged positive prefix advances the borrowed slice.
		// An error or uncertain effect above is never retried or replayed.
		written += int(r.Ok())
	}
	return written, nil
}

func (c *lsfStreamConn) CloseWrite() error {
	_, release, err := c.begin(true)
	if err != nil {
		return c.opError("closewrite", err)
	}
	defer release()
	c.mu.Lock()
	deadline := c.writeDeadline
	c.mu.Unlock()
	ctx := context.Background()
	if !deadline.IsZero() {
		var cancel context.CancelFunc
		ctx, cancel = context.WithDeadline(ctx, deadline)
		defer cancel()
	}
	r := c.stream.ShutdownContext(ctx, lsfNetwork.ShutdownModeSend)
	if r.IsErr() {
		return c.opError("closewrite", &lsfStreamError{r.Err()})
	}
	c.mu.Lock()
	c.writeShut = true
	c.mu.Unlock()
	return nil
}

func (c *lsfStreamConn) Close() error {
	c.mu.Lock()
	if c.closing {
		done := c.closeDone
		c.mu.Unlock()
		<-done
		c.mu.Lock()
		err := c.closeError
		c.mu.Unlock()
		return err
	}
	c.closing = true
	c.mu.Unlock()
	// The SDK cancels real borrows and waits for their terminal acknowledgement
	// before consuming the one original own resource. No early refund/drop.
	r := c.stream.CloseContext(context.Background())
	c.mu.Lock()
	defer c.mu.Unlock()
	if r.IsErr() {
		c.closeError = c.opError("close", &lsfStreamError{r.Err()})
	}
	close(c.closeDone)
	return c.closeError
}

func (c *lsfStreamConn) LocalAddr() Addr  { return nil }      // absent from this WIT, never fabricated
func (c *lsfStreamConn) RemoteAddr() Addr { return c.remote } // declared endpoint, not resolved peer IP
func (c *lsfStreamConn) setDeadline(t time.Time, read, write bool) error {
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.closing {
		return c.opError("set", ErrClosed)
	}
	if read && c.readBusy && !t.Equal(c.readDeadline) || write && c.writeBusy && !t.Equal(c.writeDeadline) {
		return c.opError("set", lsfStreamUnsupported())
	}
	if read {
		c.readDeadline = t
	}
	if write {
		c.writeDeadline = t
	}
	return nil
}
func (c *lsfStreamConn) SetDeadline(t time.Time) error      { return c.setDeadline(t, true, true) }
func (c *lsfStreamConn) SetReadDeadline(t time.Time) error  { return c.setDeadline(t, true, false) }
func (c *lsfStreamConn) SetWriteDeadline(t time.Time) error { return c.setDeadline(t, false, true) }
