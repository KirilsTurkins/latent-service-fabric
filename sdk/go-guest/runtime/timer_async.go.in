type lsfTimerWait struct {
    token [2]uint64
    subtask uint32
    result unsafe.Pointer
    pinner runtime.Pinner
    stopped bool
    started bool
    done chan unit
}

//go:linkname lsfNextTimer runtime.lsfNextTimer
func lsfNextTimer() (uint64, uint64)

//go:linkname lsfRunnableActivationTasks runtime.lsfRunnableActivationTasks
func lsfRunnableActivationTasks() bool

//go:wasmimport latent:runtime/activation@0.1.0 [async-lower]timer-next
//go:noescape
func lsfTimerNext(generation, id int64, result unsafe.Pointer) uint32

//go:linkname lsfActivationTimerStopped runtime.lsfActivationTimerStopped
//go:nosplit
func lsfActivationTimerStopped(generation, id uint64) {
    if state == nil { return }
    for _, wait := range state.timerWaits {
        if wait.token == [2]uint64{generation, id} { wait.stopped = true }
    }
}

//go:linkname lsfActivationTimerFence runtime.lsfActivationTimerFence
func lsfActivationTimerFence(generation, id uint64) {
    if id == 0 || state == nil { return }
    for _, wait := range state.timerWaits {
        if wait.token == [2]uint64{generation, id} {
            // Completion is durable even if it wins before this receive.
            (<-wait.done)
            return
        }
    }
}

func lsfCompleteTimerWait(wait *lsfTimerWait) {
    tag := *(*byte)(wait.result)
    code := *(*byte)(unsafe.Add(wait.result, 8))
    if tag != 0 && !(tag == 1 && code == 3 && wait.stopped) {
        panic("LSF timer readiness failed or root deadline won")
    }
    wait.pinner.Unpin()
    close(wait.done)
}

// Only the dispatcher mutates this inventory. The removed backing-array entry
// must not keep an already retired wait and its result reachable.
func lsfRemoveTimerWait(wait *lsfTimerWait) {
    for index, candidate := range state.timerWaits {
        if candidate != wait { continue }
        copy(state.timerWaits[index:], state.timerWaits[index + 1:])
        last := len(state.timerWaits) - 1
        state.timerWaits[last] = nil
        state.timerWaits = state.timerWaits[:last]
        return
    }
    panic("LSF timer wait inventory lost")
}

func lsfHandleTimerEvent(event uint32) bool {
    for _, wait := range state.timerWaits {
        if !wait.started || wait.subtask != event { continue }
        waitableJoin(event, 0)
        subtaskDrop(event)
        lsfRemoveTimerWait(wait)
        lsfCompleteTimerWait(wait)
        return true
    }
    return false
}

// At most one next is pending for each admitted original timer. The runtime
// timer/Wait ceilings bound this inventory independently from Go goroutines.
// A synchronous completion asks the Go scheduler to check its heap again.
func lsfStartTimerWait() bool {
    generation, id := lsfNextTimer()
    if id == 0 { return false }
    for _, wait := range state.timerWaits {
        if wait.token == [2]uint64{generation, id} { return false }
    }
    wait := &lsfTimerWait{token: [2]uint64{generation, id}, done: make(chan unit)}
    wait.result = witRuntime.Allocate(&wait.pinner, 16, 8)
    // Publish before starting the host subtask. Allocation and slice growth can
    // park, so recheck the selected timer after they finish; a stop before this
    // publication has no physical next owner to fence.
    state.timerWaits = append(state.timerWaits, wait)
    selectedGeneration, selectedID := lsfNextTimer()
    if wait.stopped || selectedGeneration != generation || selectedID != id {
        lsfRemoveTimerWait(wait)
        wait.pinner.Unpin()
        close(wait.done)
        return true
    }
    status := lsfTimerNext(int64(generation), int64(id), wait.result)
    wait.subtask = status >> 4
    switch status & 15 {
    case STATUS_STARTING, STATUS_STARTED:
        wait.started = true
        if state.waitableSet == 0 { state.waitableSet = waitableSetNew() }
        waitableJoin(wait.subtask, state.waitableSet)
        return false
    case STATUS_RETURNED:
        lsfRemoveTimerWait(wait)
        lsfCompleteTimerWait(wait)
        return true
    default:
        panic("LSF timer-next canonical status")
    }
}
