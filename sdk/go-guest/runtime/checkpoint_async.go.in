// Each admitted caller can own at most one node until its wake is delivered.
// Nodes and channels remain within the existing limited Go heap; the helper
// creates no new host owner or quota.
type lsfYieldWait struct {
    channel chan unit
    next *lsfYieldWait
}

// Allocate before observing the shared queue: allocation may park for GC.
func lsfQueueYield(channel chan unit) {
    waiter := &lsfYieldWait{channel: channel}
    lsfPublishYield(waiter)
}

// The selected Wasm scheduler has one execution thread. These helpers contain
// no allocation, Go scheduler call or application callback; the dispatcher
// is excluded from the compiler-owned checkpoint transform. A Wasmtime fuel
// yield may suspend them while retaining exclusive use of the Store.
//go:noinline
//go:nosplit
func lsfPublishYield(waiter *lsfYieldWait) {
    tail := state.yieldTail
    if tail == nil {
        state.yielding = waiter
    } else {
        tail.next = waiter
    }
    state.yieldTail = waiter
}

//go:noinline
//go:nosplit
func lsfTakeYields() *lsfYieldWait {
    first := state.yielding
    state.yielding = nil
    state.yieldTail = nil
    return first
}

//go:linkname lsfActivationYield runtime.lsfActivationYield
func lsfActivationYield() {
    channel := make(chan unit)
    lsfQueueYield(channel)
    (<-channel)
}
