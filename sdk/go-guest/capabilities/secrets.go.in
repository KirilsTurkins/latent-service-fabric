package secrets

import (
	raw "wit_component/@raw@"
	wit "go.bytecodealliance.org/pkg/wit/types"
	"runtime"
	"wit_component/lsf/ownership"
)

type Secret struct { owner ownership.Owner[raw.SecretValue] }

func Read(reference string) wit.Result[*Secret, SecretError] {
	r := raw.Read(reference)
	if r.IsErr() { return wit.Err[*Secret, SecretError](r.Err()) }
	return wit.Ok[*Secret, SecretError](&Secret{ownership.New(r.Ok())})
}
// WithBytes lends the owned allocation only until f returns. Retaining the
// slice or copying it is the application's responsibility. Close erases this
// allocation, not copies, immutable metadata strings or the entire Go heap.
func (s *Secret) WithBytes(f func([]byte)) {
	v, release := s.owner.Borrow(); defer release()
	f(v.Bytes)
}
func (s *Secret) Metadata() (string, wit.Option[string], wit.Option[uint64]) {
	v, release := s.owner.Borrow(); defer release()
	return v.MediaType, v.Version, v.ExpiresAtUnixMillis
}
//go:noinline
func erase(bytes []byte) { clear(bytes); runtime.KeepAlive(bytes) }
func (s *Secret) Close() { s.owner.Close(func(v raw.SecretValue) { erase(v.Bytes) }) }
