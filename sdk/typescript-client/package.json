{
  "name": "@latent/sdk",
  "version": "0.1.0-alpha.3",
  "description": "Typed LSF interfaces and an explicitly bounded Node.js RPC client",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "node": "./dist/node/index.js" }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:semantic": "tsc -p tsconfig.tests.json && node dist/semantic-tests/tests/invocation-identity.js",
    "test:transport": "npm run build && node --test tests/network/*.test.mjs"
  },
  "engines": { "node": ">=24.19.0 <25" },
  "dependencies": { "@bufbuild/protobuf": "2.15.0" },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
