/target/
/.zig-cache/
__pycache__/
# Share only the reviewed IntelliJ project model. Workspace, SDK paths,
# caches, tasks, shelves and other personal settings remain untracked.
/.idea/*
!/.idea/encodings.xml
!/.idea/externalDependencies.xml
!/.idea/misc.xml
!/.idea/modules.xml
!/.idea/vcs.xml
!/.idea/modules/
/.idea/modules/*
!/.idea/modules/lsf*.iml
/.run/*
!/.run/LSF-*.run.xml
/.venv/
/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.log
coverage/
artifacts/
.generated/
/sdk/typescript-client/node_modules/
/sdk/typescript-client/dist/
/sdk/java-client/build/
/sdk/dotnet/**/bin/
/sdk/dotnet/**/obj/
# Keep new bulky optimization payloads outside the source checkout. Existing
# canonical tracked packages remain tracked; summaries and checksums are kept.
/benchmarks/optimization/**/*.tar.gz
/benchmarks/optimization/**/*.tar.gz.part-*
