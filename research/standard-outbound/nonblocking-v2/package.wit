// Proposed for review only. This package is not recognized, installed or
// authorized by the runtime. See ../nonblocking-v2-decision.md for semantics.
package latent:network-nonblocking@0.2.0;

interface streams {
    // These are the existing v1 resource identities and exact error/request
    // types, not new resources or an implicit conversion of grants.
    use latent:network/streams@0.1.0.{
        connection, chunk, connect-request, stream-error,
    };

    resource connect-attempt;

    variant connect-status {
        pending,
        connected,
        failed(stream-error),
    }

    variant read-result {
        bytes(chunk),
        eof,
        would-block,
    }

    variant write-result {
        written(u32),
        would-block,
    }

    flags interest {
        readable,
        writable,
        priority,
    }

    flags events {
        readable,
        writable,
        priority,
        hangup,
        error,
        // An attempt has completed; this is not itself socket readiness.
        connect-complete,
    }

    variant watch-target {
        established(borrow<connection>),
        connecting(borrow<connect-attempt>),
    }

    record watch {
        target: watch-target,
        interest: interest,
    }

    variant observation {
        // Exactly one events element per input watch, in input order.
        ready(list<events>),
        elapsed,
    }

    begin-connect: async func(request: connect-request) -> result<connect-attempt, stream-error>;
    get-connect-status: async func(attempt: borrow<connect-attempt>) -> result<connect-status, stream-error>;
    finish-connect: async func(attempt: connect-attempt) -> result<connection, stream-error>;
    cancel-connect: async func(attempt: connect-attempt) -> result<_, stream-error>;

    try-read: async func(source: borrow<connection>, maximum-bytes: u32) -> result<read-result, stream-error>;
    try-write: async func(target: borrow<connection>, bytes: list<u8>) -> result<write-result, stream-error>;
    observe: async func(watches: list<watch>, timeout-millis: option<u32>) -> result<observation, stream-error>;
}

world contract-probe {
    import streams;
}
