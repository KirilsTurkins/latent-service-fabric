{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "compiled",
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "angularCompilerOptions": {
    "compilationMode": "full",
    "strictTemplates": true
  },
  "files": [
    "app.ts",
    "server.ts",
    "client.ts"
  ]
}
