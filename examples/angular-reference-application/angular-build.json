{
  "formatVersion": 1,
  "profile": "angular-ssr-component-v1",
  "backendProfile": "scoped-http-get-v1",
  "name": "angular-reference",
  "version": "1.0.0",
  "serverEntry": "server/main.ts",
  "clientEntry": "client/main.ts",
  "sources": ["client/main.ts", "server/main.ts", "shared/app.ts", "shared/version.ts"],
  "assets": [{"path": "/offline.html", "source": "public/offline.html"}],
  "routes": [
    {"path": "/", "mode": "server"},
    {"path": "/about", "mode": "server"},
    {"path": "/account", "mode": "server"},
    {"path": "/failure", "mode": "server"},
    {"path": "/data", "mode": "server"},
    {"path": "/denied", "mode": "server"},
    {"path": "/slow", "mode": "server"},
    {"path": "/offline", "mode": "prerender", "asset": "/offline.html"}
  ]
}
