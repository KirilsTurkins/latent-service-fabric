package examples:java-http-domain@1.0.0;

interface api {
    record wide {
        a: string, b: string, c: string, d: string, e: string, f: string,
        g: string, h: string, i: string, j: string, k: string, l: string,
        sequence: u64,
    }
    status: func() -> list<wide>;
    echo: func(value: wide) -> wide;
    text: func(value: string) -> string;
    items: func(value: list<string>) -> list<string>;
    fail: func() -> result<string, string>;
    throw-error: func() -> string;
    spin: func() -> u32;
    private-admin: func() -> string;
}

world service {
    import latent:clock/monotonic@0.1.0;
    import latent:clock/wall@0.1.0;
    export api;
}

world runtime-support {
    import latent:clock/monotonic@0.1.0;
    import latent:clock/wall@0.1.0;
}
